        'not null' => FALSE),
      'AvgVisitDuration' => array(
        'description' => t('Avg Visit Duration'),
        'type' => 'float',
        'not null' => FALSE),
      'DaysSinceLastVisit' => array(
        'description' => t('Days Since Last Visit'),
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0),
      'FirstActionDate' => array(
        'description' => t('First Action Date'),
        'mysql_type' => 'DATETIME',
        'not null' => FALSE),
      'LastActionDate' => array(
        'description' => t('Last Action Date'),
        'mysql_type' => 'DATETIME',
        'not null' => FALSE),
      'LastLocation' => array(
        'description' => t('Last Visitor Location'),
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
        'default' => ''),
      'LastReferrerUrl' => array(
        'description' => t('Last Referrer Url'),
        'type' => 'varchar',
        'length' => 2000,
        'not null' => FALSE,
        'default' => ''),
      'LastCampaignSource' => array(
        'description' => t('Last Campaign Source'),
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
        'default' => ''),
      'LastCampaignName' => array(
        'description' => t('Last Campaign Name'),
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
        'default' => ''),
      'LastCampaignMedium' => array(
        'description' => t('Last Campaign Medium'),
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
        'default' => ''),
      'LastCampaignContent' => array(
        'description' => t('Last Campaign Content'),
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
        'default' => ''),
    ),

    'indexes' => array(
      'visitor' => array( 'PiwikVisitorID'),

    ),

    'primary key' => array ('PiwikVisitorID' )
  );

  return $schema;
