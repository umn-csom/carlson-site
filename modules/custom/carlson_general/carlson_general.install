<?php

/**
 * CSM-213 - Copy missing alt text to media thumbnail from media image field.
 */
function carlson_general_update_100101() {
  // Set a longer execution time if needed, though this script should be relatively quick.
  // ini_set('max_execution_time', 300);

  $script_name = 'alt_text_sync.php';
  $script_path = \Drupal::root() . '/' . drupal_get_path('module', 'carlson_general') . '/scripts/' . $script_name;

  if (!file_exists($script_path)) {
    $error_message = t('Script file @script_name not found at @path. Update failed.', [
      '@script_name' => $script_name,
      '@path' => $script_path,
    ]);
    \Drupal::logger('carlson_general')->error($error_message);
    return $error_message;
  }

  $summary_message = '';
  $log_file_path_message = '';

  try {
    \Drupal::logger('carlson_general')->notice('Starting execution of @script_name via update hook...', ['@script_name' => $script_name]);

    $result_string = include $script_path;

    \Drupal::logger('carlson_general')->notice('Finished running @script_name. Result: @result', [
      '@script_name' => $script_name,
      '@result' => $result_string,
    ]);

    if (is_string($result_string)) {
        if (strpos($result_string, "Detailed log:") !== false) {
            list($summary_message, $log_file_path_message) = explode("Detailed log:", $result_string, 2);
            $summary_message = trim($summary_message);
            $log_file_path_message = trim($log_file_path_message);
        } else {
            $summary_message = $result_string;
        }
    }

    if (strpos(strtolower($summary_message), 'error') !== false || strpos(strtolower($summary_message), 'failed') !== false) {
      \Drupal::logger('carlson_general')->error('Error reported by @script_name: @summary. Log: @log', [
        '@script_name' => $script_name,
        '@summary' => $summary_message,
        '@log' => $log_file_path_message,
      ]);
      $ui_message = t('Error running @script: @summary. Check logs. Log: @log', [
        '@script' => $script_name,
        '@summary' => $summary_message,
        '@log' => $log_file_path_message ? $log_file_path_message : '(not available)',
      ]);
       return $ui_message;
    }

    $ui_message = t('Successfully executed @script. @summary. Log: @log', [
      '@script' => $script_name,
      '@summary' => $summary_message,
      '@log' => $log_file_path_message ? $log_file_path_message : '(not available)',
    ]);
    return $ui_message;

  } catch (\Exception $e) {
    $error_message = t('Exception while running @script: @error. Log: @log', [
      '@script' => $script_name,
      '@error' => $e->getMessage(),
      '@log' => $log_file_path_message ? $log_file_path_message : '(not available)',
    ]);
    \Drupal::logger('carlson_general')->error($error_message);
    return $error_message;
  }
}

/**
 * CSM-232 - Fix fragmented links in tabbed content.
 */
function carlson_general_update_100102() {
  // Set a longer execution time
  ini_set('max_execution_time', 1800);

  // Get the script path
  $script_path = DRUPAL_ROOT . '/sites/carlsonschool.umn.edu/modules/custom/carlson_general/scripts/fix_fragmented_links.php';

  if (!file_exists($script_path)) {
    \Drupal::logger('carlson_general')->error('Could not find script file at @path', [
      '@path' => $script_path,
    ]);
    return t('Script file not found. Fix failed.');
  }

  try {
    // Include the script directly - this will execute it and return the summary
    $start_time = microtime(true);
    \Drupal::logger('carlson_general')->notice('Starting fragmented links fix script...');

    // Execute the script in the Drupal context - it will return a summary message
    $result = include_once $script_path;

    $execution_time = microtime(true) - $start_time;
    \Drupal::logger('carlson_general')->notice('Finished running fragmented links fix script in @time seconds', [
      '@time' => round($execution_time, 2),
    ]);

    return $result ?: t('Successfully executed the fragmented links fix script.');
  }
  catch (\Exception $e) {
    \Drupal::logger('carlson_general')->error('Error running script: @error', [
      '@error' => $e->getMessage(),
    ]);
    return t('Error occurred while running the script: @error', [
      '@error' => $e->getMessage(),
    ]);
  }
}

/**
 * Update button styles site-wide.
 *
 * CSM-295: Replace old button styles with new consolidated ones.
 */
function carlson_general_update_100103() {
  // Set a longer execution time
  ini_set('max_execution_time', 3600); // 1 hour

  // Get the script path
  $script_path = DRUPAL_ROOT . '/sites/carlsonschool.umn.edu/modules/custom/carlson_general/scripts/update_button_styles_batch_api_public.php';

  if (!file_exists($script_path)) {
    \Drupal::logger('carlson_general')->error('Could not find script file at @path', [
      '@path' => $script_path,
    ]);
    return t('Script file not found. Button update failed.');
  }

  try {
    // Start timing
    $start_time = microtime(true);

    // Disable memory limit
    ini_set('memory_limit', '-1');

    \Drupal::logger('carlson_general')->notice('Starting button style update script...');

    // Make sure the script functions are available
    require_once $script_path;

    // Run the update (not a dry run)
    $result = runButtonStyleUpdate(FALSE);

    $execution_time = microtime(true) - $start_time;

    // Log results
    \Drupal::logger('carlson_general')->notice('Finished button style update in @time seconds', [
      '@time' => round($execution_time, 2),
    ]);

    // Create log in public files
    $public_scheme = \Drupal::service('stream_wrapper_manager')->getViaScheme('public');
    $log_directory = $public_scheme->getDirectoryPath() . '/button_update_logs';

    if (!file_exists($log_directory)) {
      mkdir($log_directory, 0755, TRUE);
    }

    \Drupal::logger('carlson_general')->notice('Button style update complete. @total entities scanned, @updated updated. Log file: @log', [
      '@total' => $result['total_entities'],
      '@updated' => $result['total_updated'],
      '@log' => $result['log_file'] ?? 'Not generated',
    ]);

    return t('Button style update complete. @total entities scanned, @updated entities updated. Log saved to: @log', [
      '@total' => $result['total_entities'],
      '@updated' => $result['total_updated'],
      '@log' => $result['log_file'] ?? 'public://button_update_logs/',
    ]);

  } catch (\Exception $e) {
    \Drupal::logger('carlson_general')->error('Error running button update script: @error', [
      '@error' => $e->getMessage(),
    ]);
    return t('Error occurred while running the button update script: @error', [
      '@error' => $e->getMessage(),
    ]);
  }
}

/**
 * Update menu link button classes.
 *
 * CSM-295: Replace old button styles with new consolidated ones in menu link attributes.
 */
function carlson_general_update_100104() {
  // Set a longer execution time
  ini_set('max_execution_time', 1800); // 30 minutes

  // Get database connection
  $database = \Drupal::database();

  // Create log file in public files directory
  $public_scheme = \Drupal::service('stream_wrapper_manager')->getViaScheme('public');
  $log_directory = $public_scheme->getDirectoryPath() . '/button_update_logs';

  if (!file_exists($log_directory)) {
    mkdir($log_directory, 0755, TRUE);
  }

  $log_file = $log_directory . '/menu_link_class_update_' . date('Y-m-d_H-i-s') . '.log';

  // Start timing
  $start_time = microtime(true);

  \Drupal::logger('carlson_general')->notice('Starting menu link button class update...');

  // Get button style mappings from the existing update script
  $button_mappings = [
    // Original single class mappings
    'button-link-primary' => 'btn btn-primary',
    'button-link-secondary' => 'btn btn-primary',
    'btn-link-primary' => 'btn btn-primary',
    'btn-link-secondary' => 'btn btn-primary',
    'maroon-solid-button' => 'btn btn-primary',
    'btn-primary--maroon' => 'btn btn-primary',
    'maroon-underline-button' => 'btn btn-primary',
    'gold-solid-button' => 'btn btn-secondary',
    'btn-primary--gold' => 'btn btn-secondary',
    'btn-primary--yellow' => 'btn btn-secondary',
    'btn-gold' => 'btn btn-secondary',
    'gold-underline-button' => 'btn btn-secondary',
    'maroon-outline-button' => 'btn btn-outline-primary',
    'gold-outline-button' => 'btn btn-outline-secondary',
    'btn-cta' => '',
    'program-features__btn' => 'btn btn-primary',

    // Compound class mappings
    'btn btn-link-primary' => 'btn btn-primary',
    'btn btn-link-secondary' => 'btn btn-primary',
    'btn-sm btn-link-primary' => 'btn btn-sm btn-primary',
    'btn-sm btn-link-secondary' => 'btn btn-sm btn-primary',
    'btn-lg btn-link-primary' => 'btn btn-lg btn-primary',
    'btn-lg btn-link-secondary' => 'btn btn-lg btn-primary',
  ];

  // Find menu links with button classes
  $button_classes = array_keys($button_mappings);
  $query = $database->select('menu_link_content_data', 'm')
    ->fields('m', ['id', 'title', 'menu_name', 'link__options'])
    ->condition('link__options', '%' . $database->escapeLike('class') . '%', 'LIKE');

  $or_condition = $query->orConditionGroup();
  foreach ($button_classes as $class) {
    $or_condition->condition('link__options', '%' . $database->escapeLike($class) . '%', 'LIKE');
  }
  $query->condition($or_condition);
  $results = $query->execute()->fetchAll();

  $total_links = count($results);
  $updated_count = 0;
  $log_entries = [];

  \Drupal::logger('carlson_general')->notice('Found @count menu links with potential button classes to update.', [
    '@count' => $total_links,
  ]);

  // Get entity type manager to load/save entities properly
  $entity_type_manager = \Drupal::entityTypeManager();
  $menu_link_storage = $entity_type_manager->getStorage('menu_link_content');

  foreach ($results as $link) {
    $id = $link->id;
    $title = $link->title;
    $menu_name = $link->menu_name;
    $options = unserialize($link->link__options);

    $original_options = $options;
    $updated = false;

    // Check if there are classes in attributes
    if (isset($options['attributes']['class']) && is_array($options['attributes']['class'])) {
      $classes = $options['attributes']['class'];
      $new_classes = [];

      foreach ($classes as $idx => $class) {
        // Check single classes
        if (isset($button_mappings[$class])) {
          $updated = true;
          $mapping = $button_mappings[$class];

          if (empty($mapping)) {
            // Remove the class
            unset($classes[$idx]);
            $log_entries[] = sprintf(
              'Menu link #%d "%s" (%s): Removed class "%s"',
              $id,
              $title,
              $menu_name,
              $class
            );
          } else {
            // Replace with new class(es)
            $new_class_parts = explode(' ', $mapping);
            foreach ($new_class_parts as $new_class) {
              if (!in_array($new_class, $new_classes)) {
                $new_classes[] = $new_class;
              }
            }
            unset($classes[$idx]);
            $log_entries[] = sprintf(
              'Menu link #%d "%s" (%s): Replaced "%s" with "%s"',
              $id,
              $title,
              $menu_name,
              $class,
              $mapping
            );
          }
        } else {
          // Keep original class if no mapping
          $new_classes[] = $class;
        }
      }

      // Check compound classes (e.g., "btn btn-link-primary")
      $combined_class = implode(' ', $classes);
      foreach ($button_mappings as $old_compound => $new_compound) {
        if (strpos($old_compound, ' ') !== false && strpos($combined_class, $old_compound) !== false) {
          $updated = true;
          $compound_parts = explode(' ', $old_compound);

          // Remove all parts of the compound class
          foreach ($compound_parts as $part) {
            $key = array_search($part, $new_classes);
            if ($key !== false) {
              unset($new_classes[$key]);
            }
          }

          // Add new compound class parts
          if (!empty($new_compound)) {
            $new_parts = explode(' ', $new_compound);
            foreach ($new_parts as $new_part) {
              if (!in_array($new_part, $new_classes)) {
                $new_classes[] = $new_part;
              }
            }
          }

          $log_entries[] = sprintf(
            'Menu link #%d "%s" (%s): Replaced compound "%s" with "%s"',
            $id,
            $title,
            $menu_name,
            $old_compound,
            $new_compound
          );
        }
      }

      // Update the options with new classes
      if ($updated) {
        $options['attributes']['class'] = array_values($new_classes);

        // Try both approaches: direct DB update and entity save
        // 1. Direct DB update
        $database->update('menu_link_content_data')
          ->fields([
            'link__options' => serialize($options),
          ])
          ->condition('id', $id)
          ->execute();

        // 2. Load and save the entity properly to ensure caches are cleared
        try {
          $menu_link_entity = $menu_link_storage->load($id);
          if ($menu_link_entity) {
            // Update the link options in the entity
            $menu_link_entity->link->first()->options = $options;
            $menu_link_entity->save();
          }
        }
        catch (\Exception $e) {
          \Drupal::logger('carlson_general')->error('Error updating menu link entity #@id: @error', [
            '@id' => $id,
            '@error' => $e->getMessage(),
          ]);
        }

        $updated_count++;
      }
    }
  }

  // Write log entries to the log file
  if (!empty($log_entries)) {
    file_put_contents($log_file, implode("\n", $log_entries));
  }

  // For good measure, clear all relevant caches
  \Drupal::service('cache_tags.invalidator')->invalidateTags(['menu', 'rendered']);

  $execution_time = microtime(true) - $start_time;

  // Log results
  \Drupal::logger('carlson_general')->notice('Finished menu link button class update in @time seconds', [
    '@time' => round($execution_time, 2),
  ]);

  \Drupal::logger('carlson_general')->notice('Menu link button class update complete. @total links processed, @updated updated. Log file: @log', [
    '@total' => $total_links,
    '@updated' => $updated_count,
    '@log' => $log_file,
  ]);

  return t('Menu link button class update complete. @total links processed, @updated links updated. Log saved to: @log', [
    '@total' => $total_links,
    '@updated' => $updated_count,
    '@log' => $log_file,
  ]);
}

/**
 * CSM-247 - Fix skipped heading levels for accessibility.
 */
function carlson_general_update_100105() {
  // Initialize $_SERVER['argv'] if it doesn't exist (for web UI context)
  if (!isset($_SERVER['argv'])) {
    $_SERVER['argv'] = [];
  }

  // Capture output for logging
  ob_start();

  // Execute the script directly
  $script_path = DRUPAL_ROOT . '/sites/carlsonschool.umn.edu/modules/custom/carlson_general/scripts/analyze_headings.php';

  // Ensure fix_mode is enabled in the script context
  $_SERVER['argv'] = array_diff($_SERVER['argv'], ['--dry-run']);

  if (file_exists($script_path)) {
    include_once $script_path;
  } else {
    return t('Script file not found at @path', ['@path' => $script_path]);
  }

  // Get output
  $output = ob_get_clean();

  // Log key parts of the output
  if (preg_match('/Total heading issues fixed: (\d+)/', $output, $matches)) {
    $fixed_count = $matches[1];
    \Drupal::logger('carlson_general')->notice('Fixed @count heading structure issues', [
      '@count' => $fixed_count
    ]);
  } else {
    \Drupal::logger('carlson_general')->warning('Could not determine how many heading issues were fixed.');
  }

  // Extract report file location
  if (preg_match('/Detailed report saved to: (.+)/', $output, $matches)) {
    $report_file = $matches[1];
    \Drupal::logger('carlson_general')->notice('Heading structure report saved to @file', [
      '@file' => $report_file
    ]);
  }

  // Log the full output to a file for debugging
  $log_dir = \Drupal::service('file_system')->realpath('public://script_logs');
  if (!file_exists($log_dir)) {
    \Drupal::service('file_system')->mkdir($log_dir, 0755, TRUE);
  }
  $log_file = $log_dir . '/analyze_headings_' . date('Y-m-d_H-i-s') . '.txt';
  file_put_contents($log_file, $output);
  \Drupal::logger('carlson_general')->notice('Full output log saved to @log', ['@log' => $log_file]);

  return t('Successfully fixed heading structure issues. See system log for details.');
}

/**
 * CSM-231 - Remove title attributes from img tags in WYSIWYG fields.
 */
function carlson_general_update_100106() {
  // Set longer execution limits
  ini_set('max_execution_time', 1800);  // 30 minutes

  $start_time = microtime(true);
  \Drupal::logger('carlson_general')->notice('Starting bulk removal of img title attributes...');

  $entity_field_manager = \Drupal::service('entity_field.manager');
  $entity_type_manager = \Drupal::service('entity_type.manager');
  $db = \Drupal::database();

  // === STEP 1: Find all text fields ===
  $fields_to_process = [];

  // APPROACH 1: Get configured fields
  $field_configs = $entity_type_manager->getStorage('field_config')->loadByProperties([
    'field_type' => ['text', 'text_long', 'text_with_summary'],
  ]);

  foreach ($field_configs as $field_config) {
    $entity_type = $field_config->getTargetEntityTypeId();
    $bundle = $field_config->getTargetBundle();
    $field_name = $field_config->getName();

    $fields_to_process[] = [
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'field_name' => $field_name,
    ];
  }

  // APPROACH 2: Get base fields for all entity types
  $entity_types = $entity_type_manager->getDefinitions();
  foreach ($entity_types as $entity_type_id => $entity_type) {
    if ($entity_type->entityClassImplements('\Drupal\Core\Entity\ContentEntityInterface')) {
      // Get all base fields for this entity type
      $base_fields = $entity_field_manager->getBaseFieldDefinitions($entity_type_id);

      foreach ($base_fields as $field_name => $field_definition) {
        $field_type = $field_definition->getType();

        // Add this before the field type check
        if ($field_name === 'field_schedule_time') {
          \Drupal::logger('carlson_general')->notice('Found field_schedule_time with type: @type', [
            '@type' => $field_definition->getType()
          ]);
        }

        // Only include text fields
        if (in_array($field_type, ['text', 'text_long', 'text_with_summary'])) {
          // For node body fields, we need one entry per bundle
          if ($entity_type_id == 'node' && $field_name == 'body') {
            $bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo($entity_type_id);
            foreach (array_keys($bundles) as $bundle) {
              $fields_to_process[] = [
                'entity_type' => $entity_type_id,
                'bundle' => $bundle,
                'field_name' => $field_name,
              ];
            }
          } else {
            $fields_to_process[] = [
              'entity_type' => $entity_type_id,
              'bundle' => $entity_type_id,
              'field_name' => $field_name,
            ];
          }
        }
      }
    }
  }

  // APPROACH 3: Directly scan database tables for field tables
  $tables = $db->query("SHOW TABLES LIKE '%\\_\\_%'")->fetchCol();

  foreach ($tables as $table) {
    // Only look for field data tables, not revision tables
    if (strpos($table, '__') !== FALSE && strpos($table, 'revision') === FALSE) {
      list($entity_type, $field_name) = explode('__', $table, 2);

      // Check if table has a value column (text fields should)
      $schema = $db->query("DESCRIBE `{$table}`")->fetchAllAssoc('Field');
      $value_column = $field_name . '_value';

      if (isset($schema[$value_column])) {
        // This appears to be a text field table
        $fields_to_process[] = [
          'entity_type' => $entity_type,
          'bundle' => 'all',  // We don't know the bundle but don't need it
          'field_name' => $field_name,
          'table' => $table,
          'value_column' => $value_column,
        ];
      }
    }
  }

  // Remove any duplicates (by entity_type and field_name)
  $unique_fields = [];
  foreach ($fields_to_process as $field) {
    $key = $field['entity_type'] . '|' . $field['field_name'];
    $unique_fields[$key] = $field;
  }
  $fields_to_process = array_values($unique_fields);

  \Drupal::logger('carlson_general')->notice('Found @count text fields to process', [
    '@count' => count($fields_to_process)
  ]);

  // === STEP 2: Process all fields directly ===
  $processed_entities = 0;
  $updated_entities = 0;
  $updated_by_type = [];
  $log = [];

  // Process each field directly
  foreach ($fields_to_process as $field_index => $field) {
    $entity_type = $field['entity_type'];
    $field_name = $field['field_name'];

    // Progress logging - report every 10 fields
    if ($field_index % 10 === 0) {
      \Drupal::logger('carlson_general')->notice('Processing field @current of @total', [
        '@current' => $field_index + 1,
        '@total' => count($fields_to_process)
      ]);
    }

    // Get table name for the field
    if (isset($field['table']) && isset($field['value_column'])) {
      $table_name = $field['table'];
      $value_column = $field['value_column'];
    } else {
      $table_name = $entity_type . '__' . $field_name;
      $value_column = $field_name . '_value';
    }
    $entity_id_column = 'entity_id';

    // Load entity storage
    $entity_storage = \Drupal::entityTypeManager()->getStorage($entity_type);

    try {
      // Query without batching - get all entities with title attributes
      $query = \Drupal::database()->select($table_name, 't')
        ->fields('t', [$entity_id_column])
        ->condition('t.' . $value_column, '%<img%title=%', 'LIKE');

      $result = $query->execute()->fetchCol();

      // Process all results at once
      if (!empty($result)) {
        $entities = $entity_storage->loadMultiple($result);

        foreach ($entities as $entity) {
          $field_items = $entity->get($field_name);
          $field_updated = false;
          $title_attrs_removed = 0;

          // Process all values in multi-value fields
          foreach ($field_items as $delta => $item) {
            $field_value = $item->value;

            // Only process if the field has content and contains img tags with title attributes
            if (!empty($field_value) && strpos($field_value, '<img') !== false && strpos($field_value, 'title=') !== false) {
              // Count how many title attributes before changes
              $title_count_before = preg_match_all('/<img[^>]*title=["\'](.*?)["\'][^>]*>/i', $field_value, $matches);

              // Use regex to find and remove title attributes from img tags
              $pattern = '/<img\b([^>]*)\btitle\s*=\s*(["\'])(.*?)\2([^>]*)>/is';
              $replacement = '<img$1$3>';
              $new_value = preg_replace($pattern, $replacement, $field_value);

              // Count how many title attributes after changes
              $title_count_after = preg_match_all('/<img[^>]*title=["\'](.*?)["\'][^>]*>/i', $new_value, $matches);
              $removed_count = $title_count_before - $title_count_after;

              // If content was changed, update the entity
              if ($new_value !== $field_value) {
                $entity->get($field_name)->set($delta, ['value' => $new_value, 'format' => $item->format]);
                $field_updated = true;
                $title_attrs_removed += $removed_count;
              }
            }
          }

          // Save entity if any field values were updated
          if ($field_updated) {
            $entity->save();
            $updated_entities++;

            // Get entity label or ID
            $entity_label = '';
            if (method_exists($entity, 'label') && $entity->label()) {
              $entity_label = $entity->label();
            } else {
              $entity_label = "ID: " . $entity->id();
            }

            // Find parent node for paragraphs
            $parent_info = '';
            if ($entity_type == 'paragraph') {
              try {
                // Get the parent entity
                $parent_field = $entity->get('parent_field_name')->value;
                $parent_type = $entity->get('parent_type')->value;
                $parent_id = $entity->get('parent_id')->value;

                if ($parent_type && $parent_id) {
                  // Try to load the parent entity
                  $parent_entity = \Drupal::entityTypeManager()
                    ->getStorage($parent_type)
                    ->load($parent_id);

                  if ($parent_entity) {
                    $parent_label = method_exists($parent_entity, 'label') ? $parent_entity->label() : "ID: $parent_id";
                    $parent_info = " (in $parent_type: \"$parent_label\", ID: $parent_id)";
                  } else {
                    $parent_info = " (in $parent_type ID: $parent_id)";
                  }
                }
              } catch (\Exception $e) {
                $parent_info = " (parent lookup failed: {$e->getMessage()})";
              }
            }

            // Track by entity type for summary
            if (!isset($updated_by_type[$entity_type])) {
              $updated_by_type[$entity_type] = [];
            }
            $updated_by_type[$entity_type][] = [
              'id' => $entity->id(),
              'label' => $entity_label,
              'attributes_removed' => $title_attrs_removed,
              'parent_info' => $parent_info
            ];

            // Add detailed log entry with parent info for paragraphs
            $log[] = t(
              'Updated @type "@label" (ID: @id)@parent_info: Removed @count title attributes from @field field',
              [
                '@type' => $entity_type,
                '@label' => $entity_label,
                '@id' => $entity->id(),
                '@parent_info' => $parent_info,
                '@count' => $title_attrs_removed,
                '@field' => $field_name,
              ]
            );
          }

          $processed_entities++;
        }
      }
    } catch (\Exception $e) {
      // Log error and continue with next field
      \Drupal::logger('carlson_general')->error('Error processing field @field for entity type @type: @error', [
        '@field' => $field_name,
        '@type' => $entity_type,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  // === STEP 3: Create summary and log file ===
  $log_file = \Drupal::service('file_system')->getTempDirectory() . '/img_title_removal_' . date('Y-m-d_H-i-s') . '.log';
  file_put_contents($log_file, implode("\n", $log));

  // Create a summary of entities updated by type
  $summary = [];
  $total_removed = 0;
  foreach ($updated_by_type as $type => $entities) {
    $type_total = count($entities);
    $entity_list = [];
    $removed_attrs = 0;
    foreach ($entities as $entity_data) {
      $entity_list[] = $entity_data['label'] . ' (ID: ' . $entity_data['id'] . ')' .
        (!empty($entity_data['parent_info']) ? $entity_data['parent_info'] : '');
      $removed_attrs += $entity_data['attributes_removed'];
    }
    $total_removed += $removed_attrs;
    $summary[] = "$type ($type_total): " . implode(', ', $entity_list);
  }

  // Add summary to log file
  $summary_text = "=== SUMMARY ===\n";
  $summary_text .= "Total entities processed: {$processed_entities}\n";
  $summary_text .= "Total entities updated: {$updated_entities}\n";
  $summary_text .= "Total title attributes removed: {$total_removed}\n\n";
  $summary_text .= "Updated entities by type:\n" . implode("\n", $summary);
  file_put_contents($log_file, "\n\n" . $summary_text, FILE_APPEND);

  $execution_time = microtime(true) - $start_time;
  \Drupal::logger('carlson_general')->notice('Completed image title removal in @time seconds', [
    '@time' => round($execution_time, 2)
  ]);

  return t(
    'Removed title attributes from images in WYSIWYG fields. Processed @processed entities, updated @updated entities. See log at @log',
    [
      '@processed' => $processed_entities,
      '@updated' => $updated_entities,
      '@log' => $log_file,
    ]
  );
}

/**
 * CSM-248 - Convert P tags to H2 tags based on PopeTech Alert data in CSV - exact matches only.
 */
function carlson_general_update_100107() {
  // Set longer execution limits
  ini_set('max_execution_time', 1800);

  // Helper function to normalize HTML for comparison
  $normalizeHtml = function ($html) {
    // Decode HTML entities
    $html = html_entity_decode($html, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    // Explicitly replace apostrophe entities that might not get decoded
    $html = str_replace('&apos;', "'", $html);
    $html = str_replace('&rsquo;', "'", $html); // Add this line
    // Normalize all whitespace more aggressively (including newlines)
    $html = preg_replace('/[\s\n\r\t]+/', ' ', $html);
    // Normalize quotes (convert all quotes to double quotes)
    $html = str_replace("'", '"', $html);
    $html = str_replace('""', '"', $html);
    return trim($html);
  };

  $start_time = microtime(true);
  \Drupal::logger('carlson_general')->notice('Starting conversion of specific p tags to h2 tags (replacing ALL exact matches)...');

  $csv_file = DRUPAL_ROOT . '/sites/carlsonschool.umn.edu/modules/custom/carlson_general/scripts/alerts_possible_heading.csv';

  if (!file_exists($csv_file)) {
    \Drupal::logger('carlson_general')->error('CSV file not found at @path', ['@path' => $csv_file]);
    return t('Error: CSV file not found.');
  }

  // Read CSV file
  $csv_data = array_map('str_getcsv', file($csv_file));
  $header = array_shift($csv_data); // Remove header row

  // Get column indices
  $url_index = array_search('uri', $header);
  $html_index = array_search('html', $header);

  if ($url_index === false || $html_index === false) {
    \Drupal::logger('carlson_general')->error('CSV must contain uri and html columns');
    return t('Error: CSV format is incorrect.');
  }

  $processed_nodes = 0;
  $updated_entities = 0; // Count all updated entities (nodes and paragraphs)
  $total_tags_converted = 0; // Count all p tags converted to h2
  $log = [];
  $fields_checked = []; // Track fields we checked for matches
  $successful_replacements = []; // Track successful replacements for the example page

  // Process each row in CSV
  foreach ($csv_data as $row_index => $row) {
    if (empty($row[$url_index]) || empty($row[$html_index])) {
      continue;
    }

    $url = trim($row[$url_index]);
    $html_to_find = trim($row[$html_index]);

    // Clean and normalize the HTML
    $html_to_find = $normalizeHtml($html_to_find);

    \Drupal::logger('carlson_general')->notice('Processing row @row: @url', [
      '@row' => $row_index + 1,
      '@url' => $url
    ]);

    // Get just the path from the URL (remove domain)
    $url_parts = parse_url($url);
    $path = isset($url_parts['path']) ? $url_parts['path'] : $url;

    if ($path && $path[0] !== '/') {
      $path = '/' . $path;
    }

    $internal_path = \Drupal::service('path_alias.manager')->getPathByAlias($path);

    try {
      $path = $internal_path;

      // Check if this is a node path
      if (preg_match('|^/node/(\d+)$|', $path, $matches)) {
        $nid = $matches[1];
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);

        if (!$node) {
          $log[] = t('Node not found for URL @url', ['@url' => $url]);
          continue;
        }

        $processed_nodes++;
        $node_updated = false;
        $node_title = $node->getTitle();
        $log[] = t('Processing node @title (ID: @nid) for URL @url', [
          '@title' => $node_title,
          '@nid' => $nid,
          '@url' => $url,
        ]);

        // PART 1: Check direct node text fields
        $entity_type = 'node';
        $field_definitions = \Drupal::service('entity_field.manager')
          ->getFieldDefinitions('node', $node->bundle());

        foreach ($field_definitions as $field_name => $field_definition) {
          if (in_array($field_definition->getType(), ['text_long', 'text_with_summary', 'string', 'text', 'text_plain', 'text_formatted']) && $node->hasField($field_name)) {
            $field = $node->get($field_name);

            foreach ($field as $delta => $item) {
              $field_value = $item->value;
              $found_match = false;

              if (!empty($field_value)) {
                // Normalize the field value for comparison
                $normalized_field_value = $normalizeHtml($field_value);

                // EXACT MATCH ONLY - Direct string match with normalized HTML
                if (strpos($normalized_field_value, $html_to_find) !== false) {
                  $found_match = true;
                  $log[] = t('Found exact HTML match in @field (after normalization)', ['@field' => $field_name]);
                }

                if ($found_match) {
                  // Extract the content from the original HTML
                  $content = '';
                  if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $html_to_find, $content_match)) {
                    $content = $content_match[1];
                  } else {
                    $content = strip_tags($html_to_find);
                  }

                  // Create clean h2 tag
                  if ($actual_html) {
                    $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                  }

                  // Process all occurrences in this field
                  $matches_found = 0;
                  $updated_field_value = $field_value;
                  $current_position = 0;

                  // Keep searching for the pattern while there are matches
                  while (true) {
                    // Get the updated normalized field value after previous replacements
                    $current_normalized_value = $normalizeHtml($updated_field_value);

                    // Find position of next occurrence
                    $pos = strpos($current_normalized_value, $html_to_find, $current_position);
                    if ($pos === false) {
                      break; // No more matches
                    }

                    // Extract the surrounding context to find the actual tag
                    $context_length = strlen($html_to_find) + 100; // More context
                    $start_pos = max(0, $pos - 50);
                    $extract_length = min(strlen($updated_field_value) - $start_pos, $context_length);

                    // Get the context from the current field value
                    $context = substr($updated_field_value, $start_pos, $extract_length);

                    // Find p tag in this context
                    if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $context, $match) && strpos($normalizeHtml($match[0]), $html_to_find) !== false) {
                      $actual_html = $match[0];

                      \Drupal::logger('carlson_general')->notice('Found p tag: "@html"', [
                        '@html' => $actual_html
                      ]);

                      // Add this line here:
                      if ($actual_html) {
                        $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                      }

                      // Add this before your substr_replace:
                      $pos_in_context = strpos($context, $actual_html);
                      if ($pos_in_context !== false) {
                        $updated_field_value = substr_replace(
                          $updated_field_value,
                          $new_html,
                          $start_pos + $pos_in_context,
                          strlen($actual_html)
                        );
                        $matches_found++;
                      } else {
                        // Fall back to direct replacement if position can't be found
                        \Drupal::logger('carlson_general')->notice('Context position not found for HTML, trying direct replacement: "@html"', [
                          '@html' => substr($actual_html, 0, 50)
                        ]);
                        $temp = str_replace($actual_html, $new_html, $updated_field_value);
                        if ($temp !== $updated_field_value) {
                          $updated_field_value = $temp;
                          $matches_found++;
                        } else {
                          // Move past this position to avoid infinite loop
                          $current_position = $pos + strlen($html_to_find);
                        }
                      }
                    } else {
                      // If we can't find the p tag in this context, move past this position
                      $current_position = $pos + strlen($html_to_find);
                    }
                  }

                  // Update field if changed and something was replaced
                  if ($matches_found > 0 && $updated_field_value !== $field_value) {
                    $node->get($field_name)->set($delta, ['value' => $updated_field_value, 'format' => $item->format]);
                    $node_updated = true;
                    $total_tags_converted += $matches_found;

                    // Add to successful replacements to show in the example page
                    $successful_replacements[] = [
                      'url' => $url,
                      'entity_type' => $entity_type,
                      'entity_id' => $node->id(),
                      'field_name' => $field_name,
                      'original_html' => $actual_html,
                      'new_html' => $new_html
                    ];

                    if ($matches_found > 1) {
                      $log[] = t('Updated node @title - replaced @count p tags with h2 in @field field', [
                        '@title' => $node_title,
                        '@count' => $matches_found,
                        '@field' => $field_name,
                      ]);
                    } else {
                      $log[] = t('Updated node @title - replaced p tag with h2 in @field field', [
                        '@title' => $node_title,
                        '@field' => $field_name,
                      ]);
                    }
                  }
                }
              }
            }
            $fields_checked[$entity_type . ':' . $field_name] = $field_definition->getType();
          }
        }

        // PART 2: Check for paragraph fields that might contain HTML
        $paragraph_field_types = ['entity_reference_revisions', 'paragraphs'];

        foreach ($field_definitions as $field_name => $field_definition) {
          if (in_array($field_definition->getType(), $paragraph_field_types) && $node->hasField($field_name)) {
            $paragraphs = $node->get($field_name)->referencedEntities();

            foreach ($paragraphs as $paragraph_index => $paragraph) {
              $paragraph_updated = false;

              // Check all text fields in this paragraph
              $paragraph_field_definitions = \Drupal::service('entity_field.manager')
                ->getFieldDefinitions('paragraph', $paragraph->bundle());

              foreach ($paragraph_field_definitions as $p_field_name => $p_field_definition) {
                if (in_array($p_field_definition->getType(), ['text_long', 'text_with_summary', 'string', 'text', 'text_plain', 'text_formatted']) && $paragraph->hasField($p_field_name)) {

                  $p_field = $paragraph->get($p_field_name);

                  foreach ($p_field as $p_delta => $p_item) {
                    $p_field_value = $p_item->value;
                    $found_match = false;

                    if (!empty($p_field_value)) {
                      // Normalize the paragraph field value
                      $normalized_p_field_value = $normalizeHtml($p_field_value);

                      // EXACT MATCH ONLY - Direct string match with normalized HTML
                      if (strpos($normalized_p_field_value, $html_to_find) !== false) {
                        $found_match = true;
                        $log[] = t('Found exact HTML match in paragraph field @field (after normalization)', ['@field' => $p_field_name]);

                        // Debug original content vs. normalized
                        \Drupal::logger('carlson_general')->notice('CSV normalized: "@csv", Field normalized: "@field", Original field: "@orig"', [
                          '@csv' => $html_to_find,
                          '@field' => $normalized_p_field_value,
                          '@orig' => substr($p_field_value, 0, 100)
                        ]);
                      }

                      if ($found_match) {
                        // Extract the content from the original HTML
                        $content = '';
                        if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $html_to_find, $content_match)) {
                          $content = $content_match[1];
                        } else {
                          $content = strip_tags($html_to_find);
                        }

                        // Create clean h2 tag
                        if ($actual_html) {
                          $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                        }

                        // Process all occurrences in this field
                        $matches_found = 0;
                        $updated_p_field_value = $p_field_value;
                        $current_position = 0;

                        // Keep searching for the pattern while there are matches
                        while (true) {
                          // Get the updated normalized field value after previous replacements
                          $current_normalized_value = $normalizeHtml($updated_p_field_value);

                          // Find position of next occurrence
                          $pos = strpos($current_normalized_value, $html_to_find, $current_position);
                          if ($pos === false) {
                            break; // No more matches
                          }

                          // Extract the surrounding context to find the actual tag
                          $context_length = strlen($html_to_find) + 100; // More context
                          $start_pos = max(0, $pos - 50);
                          $extract_length = min(strlen($updated_p_field_value) - $start_pos, $context_length);

                          // Get the context from the current field value
                          $context = substr($updated_p_field_value, $start_pos, $extract_length);

                          // Find p tag in this context
                          if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $context, $match) && strpos($normalizeHtml($match[0]), $html_to_find) !== false) {
                            $actual_html = $match[0];

                            \Drupal::logger('carlson_general')->notice('Found p tag: "@html"', [
                              '@html' => $actual_html
                            ]);

                            // Add this line here:
                            if ($actual_html) {
                              $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                            }

                            // Add this before your substr_replace:
                            $pos_in_context = strpos($context, $actual_html);
                            if ($pos_in_context !== false) {
                              $updated_p_field_value = substr_replace(
                                $updated_p_field_value,
                                $new_html,
                                $start_pos + $pos_in_context,
                                strlen($actual_html)
                              );
                              $matches_found++;
                            } else {
                              // Fall back to direct replacement if position can't be found
                              \Drupal::logger('carlson_general')->notice('Context position not found for HTML, trying direct replacement: "@html"', [
                                '@html' => substr($actual_html, 0, 50)
                              ]);
                              $temp = str_replace($actual_html, $new_html, $updated_p_field_value);
                              if ($temp !== $updated_p_field_value) {
                                $updated_p_field_value = $temp;
                                $matches_found++;
                              } else {
                                // Move past this position to avoid infinite loop
                                $current_position = $pos + strlen($html_to_find);
                              }
                            }
                          } else {
                            // If we can't find the p tag in this context, move past this position
                            $current_position = $pos + strlen($html_to_find);
                          }
                        }

                        // Update field if changed and something was replaced
                        if ($matches_found > 0 && $updated_p_field_value !== $p_field_value) {
                          $paragraph->get($p_field_name)->set($p_delta, ['value' => $updated_p_field_value, 'format' => $p_item->format]);
                          $paragraph_updated = true;
                          $total_tags_converted += $matches_found;

                          // Add to successful replacements to show in the example page
                          $successful_replacements[] = [
                            'url' => $url,
                            'entity_type' => 'paragraph',
                            'entity_id' => $paragraph->id(),
                            'field_name' => $p_field_name,
                            'original_html' => $actual_html,
                            'new_html' => $new_html
                          ];

                          if ($matches_found > 1) {
                            $log[] = t('Updated paragraph (ID: @id) - replaced @count p tags with h2 in @field field', [
                              '@id' => $paragraph->id(),
                              '@count' => $matches_found,
                              '@field' => $p_field_name,
                            ]);
                          } else {
                            $log[] = t('Updated paragraph (ID: @id) - replaced p tag with h2 in @field field', [
                              '@id' => $paragraph->id(),
                              '@field' => $p_field_name,
                            ]);
                          }
                        }
                      }
                    }
                  }
                  $fields_checked['paragraph:' . $p_field_name] = $p_field_definition->getType();
                }
              }

              // Check for nested paragraphs
              foreach ($paragraph_field_definitions as $nested_field_name => $nested_field_def) {
                if (in_array($nested_field_def->getType(), $paragraph_field_types) && $paragraph->hasField($nested_field_name)) {
                  $nested_paragraphs = $paragraph->get($nested_field_name)->referencedEntities();
                  foreach ($nested_paragraphs as $nested_para) {
                    $nested_updated = false;
                    $nested_field_defs = \Drupal::service('entity_field.manager')->getFieldDefinitions('paragraph', $nested_para->bundle());
                    foreach ($nested_field_defs as $np_name => $np_def) {
                      if (in_array($np_def->getType(), ['text_long', 'text_with_summary', 'string', 'text', 'text_plain', 'text_formatted']) && $nested_para->hasField($np_name)) {
                        if ($nested_para->hasField($np_name) && !$nested_para->get($np_name)->isEmpty()) {
                          $np_field = $nested_para->get($np_name);

                          foreach ($np_field as $np_delta => $np_item) {
                            $np_value = $np_item->value;
                            $found_match = false;

                            if (!empty($np_value)) {
                              // Normalize the nested paragraph field value
                              $normalized_np_value = $normalizeHtml($np_value);

                              // EXACT MATCH ONLY - Direct string match with normalized HTML
                              if (strpos($normalized_np_value, $html_to_find) !== false) {
                                $found_match = true;
                                $log[] = t('Found exact HTML match in nested paragraph field @field (after normalization)', ['@field' => $np_name]);
                              }

                              if ($found_match) {
                                // Extract the content from the original HTML
                                $content = '';
                                if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $html_to_find, $content_match)) {
                                  $content = $content_match[1];
                                } else {
                                  $content = strip_tags($html_to_find);
                                }

                                // Create clean h2 tag
                                if ($actual_html) {
                                  $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                                }

                                // Process all occurrences in this field
                                $matches_found = 0;
                                $updated_np_value = $np_value;
                                $current_position = 0;

                                // Keep searching for the pattern while there are matches
                                while (true) {
                                  // Get the updated normalized field value after previous replacements
                                  $current_normalized_value = $normalizeHtml($updated_np_value);

                                  // Find position of next occurrence
                                  $pos = strpos($current_normalized_value, $html_to_find, $current_position);
                                  if ($pos === false) {
                                    break; // No more matches
                                  }

                                  // Extract the surrounding context to find the actual tag
                                  $context_length = strlen($html_to_find) + 100; // More context
                                  $start_pos = max(0, $pos - 50);
                                  $extract_length = min(strlen($updated_np_value) - $start_pos, $context_length);

                                  // Get the context from the current field value
                                  $context = substr($updated_np_value, $start_pos, $extract_length);

                                  // Find p tag in this context
                                  if (preg_match('/<p[^>]*>(.*?)<\/p>/is', $context, $match) && strpos($normalizeHtml($match[0]), $html_to_find) !== false) {
                                    $actual_html = $match[0];

                                    \Drupal::logger('carlson_general')->notice('Found p tag: "@html"', [
                                      '@html' => $actual_html
                                    ]);

                                    // Add this line here:
                                    if ($actual_html) {
                                      $new_html = preg_replace('/^<p\b([^>]*)>(.*?)<\/p>$/is', '<h2$1>$2</h2>', $actual_html);
                                    }

                                    // Add this before your substr_replace:
                                    $pos_in_context = strpos($context, $actual_html);
                                    if ($pos_in_context !== false) {
                                      $updated_np_value = substr_replace(
                                        $updated_np_value,
                                        $new_html,
                                        $start_pos + $pos_in_context,
                                        strlen($actual_html)
                                      );
                                      $matches_found++;
                                    } else {
                                      // Fall back to direct replacement if position can't be found
                                      \Drupal::logger('carlson_general')->notice('Context position not found for HTML, trying direct replacement: "@html"', [
                                        '@html' => substr($actual_html, 0, 50)
                                      ]);
                                      $temp = str_replace($actual_html, $new_html, $updated_np_value);
                                      if ($temp !== $updated_np_value) {
                                        $updated_np_value = $temp;
                                        $matches_found++;
                                      } else {
                                        // Move past this position to avoid infinite loop
                                        $current_position = $pos + strlen($html_to_find);
                                      }
                                    }
                                  } else {
                                    // If we can't find the p tag in this context, move past this position
                                    $current_position = $pos + strlen($html_to_find);
                                  }
                                }

                                // Update field if changed
                                if ($matches_found > 0 && $updated_np_value !== $np_value) {
                                  $nested_para->get($np_name)->set($np_delta, ['value' => $updated_np_value, 'format' => $np_item->format]);
                                  $nested_updated = true;
                                  $total_tags_converted += $matches_found;

                                  // Add to successful replacements to show in the example page
                                  $successful_replacements[] = [
                                    'url' => $url,
                                    'entity_type' => 'nested_paragraph',
                                    'entity_id' => $nested_para->id(),
                                    'field_name' => $np_name,
                                    'original_html' => $actual_html,
                                    'new_html' => $new_html
                                  ];

                                  if ($matches_found > 1) {
                                    $log[] = t('Updated nested paragraph (ID: @id) - replaced @count p tags with h2 in @field field', [
                                      '@id' => $nested_para->id(),
                                      '@count' => $matches_found,
                                      '@field' => $np_name,
                                    ]);
                                  } else {
                                    $log[] = t('Updated nested paragraph (ID: @id) - replaced p tag with h2 in @field field', [
                                      '@id' => $nested_para->id(),
                                      '@field' => $np_name,
                                    ]);
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    if ($nested_updated) {
                      $nested_para->save();
                      $updated_entities++;
                    }
                  }
                }
                if (isset($np_name) && isset($np_def)) {
                  $fields_checked['nested_paragraph:' . $np_name] = $np_def->getType();
                }
              }

              // Save paragraph if updated
              if ($paragraph_updated) {
                $paragraph->save();
                $updated_entities++;
              }
            }
          }
        }

        // Save node if updated directly
        if ($node_updated) {
          $node->save();
          $updated_entities++;
        }

        if (!$node_updated && empty($paragraphs)) {
          $log[] = t('No matching content found in node @title (ID: @nid)', [
            '@title' => $node_title,
            '@nid' => $nid,
          ]);
        }
      } else {
        $log[] = t('URL @url is not a node path (resolved to @path)', [
          '@url' => $url,
          '@path' => $path
        ]);
      }
    } catch (\Exception $e) {
      \Drupal::logger('carlson_general')->error('Error processing URL @url: @error', [
        '@url' => $url,
        '@error' => $e->getMessage(),
      ]);
      $log[] = t('Error processing URL @url: @error', [
        '@url' => $url,
        '@error' => $e->getMessage(),
      ]);
    }
  }

  // Create log file with detailed information
  $log_file = \Drupal::service('file_system')->getTempDirectory() . '/p_to_h2_conversion_' . date('Y-m-d_H-i-s') . '.log';
  file_put_contents($log_file, implode("\n", $log));

  // Add summary to log file
  $summary_text = "=== SUMMARY ===\n";
  $summary_text .= "Total rows processed: " . count($csv_data) . "\n";
  $summary_text .= "Total nodes processed: {$processed_nodes}\n";
  $summary_text .= "Total entities updated: {$updated_entities}\n";
  $summary_text .= "Total p tags converted to h2: {$total_tags_converted}\n\n";

  // Add fields list
  $summary_text .= "=== FIELDS CHECKED FOR MATCHES ===\n";
  foreach ($fields_checked as $field_id => $field_type) {
    $summary_text .= "$field_id ($field_type)\n";
  }

  file_put_contents($log_file, "\n\n" . $summary_text, FILE_APPEND);

  // Create a demonstration page showing only successful replacements
  try {
    $examples_html = "<h1>Successful P to H2 Conversions</h1>\n";
    $examples_html .= "<p>This page shows the actual HTML patterns that were successfully replaced.</p>\n\n";

    if (empty($successful_replacements)) {
      $examples_html .= "<p><strong>No successful replacements were made.</strong></p>\n";
    } else {
      $examples_html .= "<p><strong>" . count($successful_replacements) . " patterns were successfully replaced.</strong></p>\n\n";

      // Group by URL for better organization
      $by_url = [];
      foreach ($successful_replacements as $replacement) {
        $url = $replacement['url'];
        if (!isset($by_url[$url])) {
          $by_url[$url] = [];
        }
        $by_url[$url][] = $replacement;
      }

      // Create content for each URL
      foreach ($by_url as $url => $replacements) {
        $examples_html .= "<h2>URL: " . htmlspecialchars($url) . "</h2>\n";

        foreach ($replacements as $index => $replacement) {
          $examples_html .= "<h3>Replacement #" . ($index + 1) . "</h3>\n";
          $examples_html .= "<p><strong>Entity:</strong> " . $replacement['entity_type'] . " #" . $replacement['entity_id'] . ", Field: " . $replacement['field_name'] . "</p>\n";

          // Before/After comparison with actual rendered HTML
          $examples_html .= "<div style='display:flex; margin-bottom:20px;'>\n";

          // BEFORE - original p tag (rendered as HTML)
          $examples_html .= "<div style='flex:1; padding:10px; background:#f5f5f5; border:1px solid #ddd; margin-right:10px;'>\n";
          $examples_html .= "<h4>Original HTML (rendered):</h4>\n";
          $examples_html .= $replacement['original_html'] . "\n";
          $examples_html .= "</div>\n";

          // AFTER - new h2 tag (rendered as HTML)
          $examples_html .= "<div style='flex:1; padding:10px; background:#e9f7e9; border:1px solid #cde6cd;'>\n";
          $examples_html .= "<h4>Replaced with (rendered):</h4>\n";
          $examples_html .= $replacement['new_html'] . "\n";
          $examples_html .= "</div>\n";

          $examples_html .= "</div>\n";

          // Plain text version for comparison
          $examples_html .= "<details>\n";
          $examples_html .= "<summary>Show HTML code</summary>\n";
          $examples_html .= "<div style='display:flex; margin-bottom:20px;'>\n";

          // BEFORE - original HTML as code
          $examples_html .= "<div style='flex:1; padding:10px; background:#f5f5f5; border:1px solid #ddd; margin-right:10px;'>\n";
          $examples_html .= "<h4>Original HTML (code):</h4>\n";
          $examples_html .= "<pre>" . htmlspecialchars($replacement['original_html']) . "</pre>\n";
          $examples_html .= "</div>\n";

          // AFTER - new HTML as code
          $examples_html .= "<div style='flex:1; padding:10px; background:#e9f7e9; border:1px solid #cde6cd;'>\n";
          $examples_html .= "<h4>Replaced with (code):</h4>\n";
          $examples_html .= "<pre>" . htmlspecialchars($replacement['new_html']) . "</pre>\n";
          $examples_html .= "</div>\n";

          $examples_html .= "</div>\n";
          $examples_html .= "</details>\n";

          $examples_html .= "<hr>\n";
        }
      }
    }

    // Create a basic page node with these examples
    $node = \Drupal::entityTypeManager()->getStorage('node')->create([
      'type' => 'page',
      'title' => 'P to H2 Conversion Results - ' . date('Y-m-d H:i'),
      'body' => [
        'value' => $examples_html,
        'format' => 'full_html',
      ],
      'status' => 1,
    ]);

    $node->save();

    $log[] = t('Created example page node with ID: @id showing successful replacements', ['@id' => $node->id()]);
    \Drupal::logger('carlson_general')->notice('Created example page node with ID: @id showing successful replacements', ['@id' => $node->id()]);
  } catch (\Exception $e) {
    \Drupal::logger('carlson_general')->error('Error creating example page: @error', ['@error' => $e->getMessage()]);
  }

  $execution_time = microtime(true) - $start_time;
  \Drupal::logger('carlson_general')->notice('Completed p to h2 conversion in @time seconds', [
    '@time' => round($execution_time, 2)
  ]);

  return t('Converted p tags to h2 tags based on CSV input. Processed @processed nodes, updated @updated entities, converted @tags tags. See log at @log', [
    '@processed' => $processed_nodes,
    '@updated' => $updated_entities,
    '@tags' => $total_tags_converted,
    '@log' => $log_file,
  ]);
}
