/**
 * CSM-248 - Convert P tags to H2 tags based on PopeTech Alert data in CSV - exact matches only.
 */
function carlson_general_update_100107() {
  // Set longer execution limits
  ini_set('max_execution_time', 1800);

  $script_name = 'convert_p_to_h2.php';
  $script_path = \Drupal::root() . '/' . drupal_get_path('module', 'carlson_general') . '/scripts/' . $script_name;

  if (!file_exists($script_path)) {
    $error_message = t('Script file @script_name not found at @path. Update failed.', [
      '@script_name' => $script_name,
      '@path' => $script_path,
    ]);
    \Drupal::logger('carlson_general')->error($error_message);
    return $error_message;
  }

  $summary_message = '';
  $log_file_path_message = '';
  $report_file_path_message = ''; // For the HTML report

  try {
    \Drupal::logger('carlson_general')->notice('Starting execution of @script_name via update hook for P to H2 conversion...', ['@script_name' => $script_name]);

    // The script returns a string like:
    // "Summary... Detailed operations log: /path/to/log.txt HTML Report: /path/to/report.html"
    $result_string = include $script_path;

    \Drupal::logger('carlson_general')->notice('Finished running @script_name for P to H2 conversion. Result: @result', [
      '@script_name' => $script_name,
      '@result' => $result_string,
    ]);

    // Parse the result string
    if (is_string($result_string)) {
        if (strpos($result_string, "Detailed operations log:") !== false) {
            list($summary_part, $log_part) = explode("Detailed operations log:", $result_string, 2);
            $summary_message = trim($summary_part);
            if (strpos($log_part, "HTML Report:") !== false) {
                list($log_file_path_message, $report_file_path_message) = explode("HTML Report:", $log_part, 2);
                $log_file_path_message = trim($log_file_path_message);
                $report_file_path_message = trim($report_file_path_message);
            } else {
                $log_file_path_message = trim($log_part); // HTML Report part might be missing if script errored early
            }
        } else {
            $summary_message = $result_string; // Script might have failed early or not returned expected format
        }
    }

    if (strpos(strtolower($summary_message), 'error') !== false || strpos(strtolower($summary_message), 'failed') !== false) {
      \Drupal::logger('carlson_general')->error('Error reported by @script_name: @summary. Log: @log. Report: @report', [
        '@script_name' => $script_name,
        '@summary' => $summary_message,
        '@log' => $log_file_path_message,
        '@report' => $report_file_path_message,
      ]);
      $ui_message = t('Error running @script: @summary. Check logs. Log: @log. Report: @report', [
        '@script' => $script_name,
        '@summary' => $summary_message,
        '@log' => $log_file_path_message ? $log_file_path_message : '(not available)',
        '@report' => $report_file_path_message ? $report_file_path_message : '(not available)',
      ]);
       return $ui_message;
    }

    $ui_message = t('Successfully executed @script. @summary. Log: @log. Report: @report', [
      '@script' => $script_name,
      '@summary' => $summary_message,
      '@log' => $log_file_path_message ? $log_file_path_message : '(not available)',
      '@report' => $report_file_path_message ? $report_file_path_message : '(not available)',
    ]);
    return $ui_message;

  } catch (\Exception $e) {
    $error_message = t('Exception while running @script for P to H2 conversion: @error. Log: @log. Report: @report', [
      '@script' => $script_name,
      '@error' => $e->getMessage(),
      '@log' => $log_file_path_message ? $log_file_path_message : '(details not available)',
      '@report' => $report_file_path_message ? $report_file_path_message : '(details not available)',
    ]);
    \Drupal::logger('carlson_general')->error($error_message);
    return $error_message;
  }
}
