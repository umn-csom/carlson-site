<?php

/**
 * @file
 * Contains carlson_general.install.
 */

/**
 * Execute a script in the carlson_general module.
 *
 * The script is expected to return a string like:
 *     Summary of changes or error message.
 *     Log: /path/to/[scriptname]_[datetime].log
 *     Report: /path/to/[scriptname]_[datetime]_report.csv
 *
 * @param string $script_name
 *   The name of the script to execute.
 *
 * @return string
 *   The result string from the script.
 *
 * @throws \Exception
 *   If the script fails, the update hook will fail.
 */
function _carlson_general_run_script($script_name) {
  $module_path = \Drupal::service('extension.list.module')->getPath('carlson_general');
  $script_path = $module_path . '/scripts/' . $script_name;

  if (!file_exists($script_path)) {
    $error_message = t('Script file @script_name not found at @path. Update failed.', [
      '@script_name' => $script_name,
      '@path' => $script_path,
    ]);
    \Drupal::logger('carlson_general')->error($error_message);
    throw new \Exception($error_message);
  }

  $result_string = include $script_path;

  if (php_sapi_name() !== 'cli') {
    // Convert newlines to <br> tags
    $result_string = str_replace(["\r\n", "\r", "\n"], '<br>', $result_string);

    // Convert URLs to links with basename as text
    $result_string = preg_replace_callback(
      '/(https?:\/\/[^\s<>]+)/i',
      function($matches) {
        $url = $matches[1];
        $basename = basename(parse_url($url, PHP_URL_PATH));
        // If basename is empty (e.g., root URL), use the domain
        if (empty($basename)) {
          $basename = parse_url($url, PHP_URL_HOST);
        }
        return '<a href="' . htmlspecialchars($url) . '" target="_blank">' . htmlspecialchars($basename) . '</a>';
      },
      $result_string
    );
  }

  if (
    strpos(strtolower($result_string), 'error') !== false
    || strpos(strtolower($result_string), 'failed') !== false
  ) {
    throw new \Exception($result_string);
  }

  return $result_string;
}

/**
 * CSM-213: Copy missing alt text to media thumbnail from media image field.
 */
function carlson_general_update_100101() {
  // Set a longer execution time
  // ini_set('max_execution_time', 300); // 5 minutes

  $script_name = 'alt_text_sync.php';
  return _carlson_general_run_script($script_name);
}

