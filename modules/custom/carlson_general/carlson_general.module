<?php

/**
 * @file
 * Contains carlson_general.module.
 */

use Drupal\Core\Breadcrumb\Breadcrumb;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityInterface;
use Drupal\user\Entity\Role;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_theme().
 */
function carlson_general_theme($existing, $type, $theme, $path) {
  return [
    'csm_modal_campaign' => [
      'variables' => [
        'eyebrow' => '',
        'title' => '',
        'body' => NULL,
        'cta_url' => '',
        'cta_text' => '',
        'decline_text' => '',
        'show_decline' => TRUE,
      ],
      'template' => 'csm-modal-campaign',
    ],
  ];
}

/**
 * Implements hook_system_breadcrumb_alter().
 *
 * @param \Drupal\Core\Breadcrumb\Breadcrumb $breadcrumb
 * @param \Drupal\Core\Routing\RouteMatchInterface $route_match
 * @param array $context
 *
 * @return void
 */
function carlson_general_system_breadcrumb_alter(Breadcrumb &$breadcrumb, RouteMatchInterface $route_match, array $context): void {
  // This will work when drupal.org/i/2966004 gets added.
  if (method_exists($breadcrumb, 'filterLinks')) {
    // Remove "More" link in breadcrumb trail.
    $breadcrumb->filterLinks(function ($v, $k) {
      return !($k == 0 && $v->getText() == 'More');
    });
  }
  // But until then, we have to do the following.
  else {
    // Saving the original links and caching.
    $original_links = $breadcrumb->getLinks();
    $filtered_links = [];
    $cacheability = CacheableMetadata::createFromObject($breadcrumb);

    /** @var \Drupal\Core\Link $link */
    foreach ($original_links as $link) {
      // Remove "More" link in breadcrumb trail.
      if ($link->getText() == 'More') {
        continue;
      }
      // Use shorter breadcrumb title from node.
      if (
        $link->getUrl()->isRouted() &&
        $link->getUrl()->getRouteName() == 'entity.node.canonical'
      ) {
        $nid = $link->getUrl()->getRouteParameters()['node'];
        if ($title = _carlson_get_breadcrumb_title($nid)) {
          $link->setText($title);
        }
      }
      if (
        $link->getUrl()->getRouteName() == '<none>' &&
        $route_match->getRouteName() == 'entity.node.canonical'
      ) {
        $nid = $route_match->getRawParameter('node');
        if (
          $link->getText() == _carlson_get_title($nid) &&
          $title = _carlson_get_breadcrumb_title($nid)
        ) {
          $link->setText($title);
        }
      }
      $filtered_links[] = $link;
    }

    // Recreate breadcrumbs using filtered links.
    $breadcrumb = new Breadcrumb();
    $breadcrumb->setLinks($filtered_links);
    $breadcrumb->addCacheableDependency($cacheability);
  }

}

/**
 * Implements hook_library_info_alter().
 */
function carlson_general_library_info_alter(&$libraries, $extension) {

  // Add responsive grid layout for Paragraphs Add Modal.
  $libraries['drupal.paragraphs.modal']['dependencies'][] = 'carlson_general/carlson-general.paragraphs.modal';
}

/**
 * Implements hook_page_attachments().
 */
function carlson_general_page_attachments(array &$attachments): void {
  // Attach site-wide on non-admin routes because legacy Colorbox triggers
  // (e.g. `colorbox-node`, `colorbox-load`) are embedded in WYSIWYG content and
  // can appear on any front-end page; avoid admin routes to reduce risk of
  // interfering with Drupal’s admin UI (core dialogs, editors, media library).
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  $attachments['#attached']['library'][] = 'carlson_general/carlson-general.dialog-modal';
}

function _carlson_get_title($nid) {
  /** @var Drupal\node\Entity\Node $node */
  $node = Node::load($nid);
  return $node->getTitle();
}


function _carlson_get_breadcrumb_title($nid) {
  /** @var Drupal\node\Entity\Node $node */
  $node = Node::load($nid);
  if ($node->hasField('field_breadcrumb_title')) {
    $breadcrumb_title = $node->get('field_breadcrumb_title')->value;
    if (!empty($breadcrumb_title)) {
      return $breadcrumb_title;
    }
  }
}

/**
 * Implements hook_entity_delete().
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function carlson_general_entity_delete(EntityInterface $entity) {
  $entity_type = $entity->getEntityTypeId();
  if ($entity_type == 'ckeditor_templates') {
    $permission_name = 'use ckeditor_template ' . $entity->getOriginalId();
    carlson_general_remove_permission_from_all_roles($permission_name);
  }
}

function carlson_general_remove_permission_from_all_roles($permission_to_remove) {
  // Load all roles.
  $roles = Role::loadMultiple();
  foreach ($roles as $role) {
    // Check if the role has the permission and remove it.
    if ($role->hasPermission($permission_to_remove)) {
      $role->revokePermission($permission_to_remove)->save();
    }
  }
}


/**
 * Implements hook_entity_presave().
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function carlson_general_node_presave(EntityInterface $entity) {
  switch($entity->bundle()) {
    case 'event':
      // in case this gets a similar set up
    break;
    case 'executive_ed_program':
      $performer_string = "";

      foreach ($entity->get('field_ee_faculty') as $accordion) {
        foreach ($accordion->entity->get('field_staff_faculty_item') as $staff_faculty_item) {
          foreach ($staff_faculty_item->entity->get('field_staff_faculty') as $staff_faculty ) {
            $faculty_entity = $staff_faculty->entity;
            $name = $faculty_entity->field_first_name->value . " " . $faculty_entity->field_last_name->value;
            $performer_string .=  " " . $name . ",";
          }
        }
      }

      if ($performer_string != "") {
        $entity->set('field_meta_tags', serialize([
          'schema_event_performer' => 'a:3:{s:5:"pivot";s:1:"1";s:5:"@type";s:6:"Person";s:4:"name";s:37:"' . $performer_string .'";}'
        ]));
      }
    break;
  }
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * @param array $element
 * @param FormStateInterface $form_state
 * @param array $context
 * @return void
 */
function carlson_general_field_widget_single_element_form_alter(array &$element, FormStateInterface &$form_state, $context) {

  // Only process paragraphs that are fully loaded, not collapsed.
  if (empty($element['#paragraph_type']) || empty($element['subform']['#entity_type'])) {
    return;
  }

  switch ($element['#paragraph_type']) {
    case 'course_schedule_info':
      _carlson_general_course_schedule_info_alter($element, $form_state, $context);
      break;
  }
}

/**
 * Implements hook_field_widget_WIDGET_TYPE_form_alter().
 *
 * Alters course schedule info paragraph type subform widget.
 */
function _carlson_general_course_schedule_info_alter(array &$element, FormStateInterface $form_state, $context) {
  $subform = &$element['subform'];

  // Hide deprecated "Schedule Part 1" field, when empty.
  if (
    !empty($subform['field_schedule_part_1']) &&
    empty($subform['field_schedule_part_1']['widget'][0]['value']['#default_value'])
  ) {
    $subform['field_schedule_part_1']['#access'] = FALSE;
  }

  // Hide deprecated "Schedule Part 1" field title, when empty.
  if (
    !empty($subform['field_schedule_part_1_title']) &&
    empty($subform['field_schedule_part_1_title']['widget'][0]['value']['#default_value'])
  ) {
    $subform['field_schedule_part_1_title']['#access'] = FALSE;
  }


  // Hide deprecated "Schedule Part 1" field, when empty.
  if (
    !empty($subform['field_schedule_part_2']) &&
    empty($subform['field_schedule_part_2']['widget'][0]['value']['#default_value'])
  ) {
    $subform['field_schedule_part_2']['#access'] = FALSE;
  }

  // Hide deprecated "Schedule Part 1" field title, when empty.
  if (
    !empty($subform['field_schedule_part_2_title']) &&
    empty($subform['field_schedule_part_2_title']['widget'][0]['value']['#default_value'])
  ) {
    $subform['field_schedule_part_2_title']['#access'] = FALSE;
  }

}

/**
 * Implements hook_preprocess_container().
 */
function carlson_general_preprocess_container(array &$variables) {
  // Check if the container is part of the 'event_channels' view.
  if (
    !empty($variables['element']['#context']['#view_id']) &&
    $variables['element']['#context']['#view_id'] === 'event_channels'
  ) {
    // Remove the 'aria-describedby' attribute from the container's attributes.
    unset($variables['attributes']['aria-describedby']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function carlson_general_media_presave(EntityInterface $entity): void {
  /** @var \Drupal\media\Entity\Media $entity */
  if ($entity->bundle() === 'image'
    && $entity->hasField('thumbnail')
    && $entity->hasField('image')
  ) {
    $entity->thumbnail->alt = $entity->image->alt;
  }
}

/**
 * Display a view as a DataTables style.
 *
 * @see template_preprocess_views_view_table()
 */
function carlson_general_preprocess_views_view_datatables(&$variables) {
  foreach ($variables['rows'] as &$row) {
    $row['attributes']['role'] = 'row';
  }
}

/**
 * Implements hook_preprocess_image().
 */
function carlson_general_preprocess_image(array &$variables) {
  // Check if both alt and title attributes exist
  if (!empty($variables['attributes']['alt']) && !empty($variables['attributes']['title'])) {
    // Trim whitespace from both attributes for accurate comparison
    $alt = trim($variables['attributes']['alt']);
    $title = trim($variables['attributes']['title']);

    // If alt and title are identical, remove the redundant title attribute
    if ($alt === $title) {
      unset($variables['attributes']['title']);
    }
  }
}

/**
 * Implements hook_preprocess_block().
 */
function carlson_general_preprocess_block(array &$variables): void {
  $block_content = $variables['content']['#block_content'] ?? $variables['elements']['content']['#block_content'] ?? NULL;
  if ($block_content && method_exists($block_content, 'bundle') && $block_content->bundle() === 'modal_campaign') {
    // Blocks are placed to use core visibility UI; rendering is handled by the
    // injected modal markup, so hide the placed block output entirely.
    $variables['attributes']['hidden'] = 'hidden';
  }
}

/**
 * Implements hook_blazy_settings_alter().
 */
function carlson_general_blazy_settings_alter(&$build, $object) {
  $blazies = $build['#settings']['blazies'];
  $blazies->set('css.ratio', ['4:1'], TRUE);
}

/**
 * Implements hook_blazy_form_element_alter().
 */
function carlson_general_blazy_form_element_alter(array &$form, array $definition, $scopes) {
  if (isset($form['ratio']['#options'])) {
    // Add the custom aspect ratio.
    $form['ratio']['#options']['4:1'] = '4:1';
  }
}

function carlson_general_token_info() {
  $node['faq_pivoted_questions'] = [
    'name' => t('FAQ Pivoted Questions'),
    'description' => t('Pivots Question/Answer paragraphs into a serialized array for Metatag Schema.'),
  ];
  $node['faq_pivoted_answers'] = [
    'name' => t('FAQ Pivoted Answers'),
    'description' => t('Pivots Question/Answer paragraphs into a serialized array for Metatag Schema.'),
  ];
  return [
    'types' => ['node' => $node],
    'tokens' => ['node' => $node],
  ];
}

/**
 * Implements hook_tokens().
 */
function carlson_general_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];

  if ($type == 'node' && !empty($data['node'])) {
    $node = $data['node'];

    foreach ($tokens as $name => $original) {
      $items = [];
      if ($node->hasField('field_questions')) {
        foreach ($node->get('field_questions')->referencedEntities() as $p) {
          $q = $p->hasField('field_question') ? $p->get('field_question')->value : '';
          $a = $p->hasField('field_answer') ? $p->get('field_answer')->value : '';
          if (!empty($q) && !empty($a)) {
            $items[] = ['q' => $q, 'a' => $a];
          }
          $bubbleable_metadata->addCacheableDependency($p);
        }
      }

      if ($name == 'faq_pivoted_questions') {
        $questions = array_map(fn($i) => Html::decodeEntities(strip_tags($i['q'])), $items);
        $replacements[$original] = !empty($questions) ? implode(',', $questions): '';
      }

      if ($name == 'faq_pivoted_answers') {
        $answers = array_map(fn($i) => Html::decodeEntities(strip_tags($i['a'])), $items);
        $replacements[$original] = !empty($answers) ? implode(',',$answers) : '';
      }
    }
  }
  return $replacements;
}

/**
 * Implements hook_page_bottom().
 */
function carlson_general_page_bottom(array &$page_bottom): void {
  $route_match = \Drupal::routeMatch();

  // Avoid duplicating the demo modal with a selected campaign modal.
  if ($route_match->getRouteName() === 'carlson_general.modal_campaign_demo') {
    return;
  }

  // Don't inject on admin routes.
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  $build = _carlson_general_build_modal_campaign();
  if ($build) {
    $page_bottom['csm_modal_campaign'] = $build;
  }
}

/**
 * Pick a safe, existing text format.
 */
function _carlson_general_pick_text_format(?string $candidate): string {
  static $available = NULL;

  if ($available === NULL) {
    try {
      $available = array_keys(\Drupal::entityTypeManager()->getStorage('filter_format')->loadMultiple());
    } catch (\Throwable $t) {
      $available = [];
    }
  }

  $candidate = $candidate ?: 'full_html';
  if (in_array($candidate, $available, TRUE)) {
    return $candidate;
  }
  if (in_array('full_html', $available, TRUE)) {
    return 'full_html';
  }
  if (in_array('basic', $available, TRUE)) {
    return 'basic';
  }
  return 'plain_text';
}

/**
 * Build a modal campaign render array, based on placed blocks + visibility.
 *
 * Ported from DIG (SHD8-757) selection logic.
 */
function _carlson_general_build_modal_campaign(): ?array {
  try {
    $block_content_storage = \Drupal::entityTypeManager()->getStorage('block_content');
    $modal_campaigns = $block_content_storage->loadByProperties([
      'type' => 'modal_campaign',
      'status' => 1,
    ]);
    if (empty($modal_campaigns)) {
      return NULL;
    }

    // Modal visibility depends on path + roles.
    $cache_contexts = ['user.roles', 'url.path'];
    $cache_tags = [];
    $cache_max_age = Cache::PERMANENT;

    $block_storage = \Drupal::entityTypeManager()->getStorage('block');
    $active_theme = \Drupal::theme()->getActiveTheme();
    $theme = $active_theme->getName();
    $region_order = array_flip(array_keys($active_theme->getRegions()));

    $candidates = [];
    foreach ($modal_campaigns as $campaign) {
      // Safety net: respect publish state even if storage filter fails.
      if (method_exists($campaign, 'isPublished') && !$campaign->isPublished()) {
        continue;
      }

      $plugin_id = 'block_content:' . $campaign->uuid();
      $blocks = $block_storage->loadByProperties([
        'theme' => $theme,
        'status' => TRUE,
        'plugin' => $plugin_id,
      ]);
      if (empty($blocks)) {
        continue;
      }

      // Enforce entity access only when a placed block exists for this campaign.
      $access_result = $campaign->access('view', \Drupal::currentUser(), TRUE);
      $cache_contexts = Cache::mergeContexts($cache_contexts, $access_result->getCacheContexts());
      $cache_tags = Cache::mergeTags($cache_tags, $access_result->getCacheTags());
      $cache_max_age = Cache::mergeMaxAges($cache_max_age, $access_result->getCacheMaxAge());
      if (!$access_result->isAllowed()) {
        continue;
      }

      foreach ($blocks as $b) {
        $candidates[] = [
          'block' => $b,
          'content' => $campaign,
          'region_order' => isset($region_order[$b->getRegion()]) ? $region_order[$b->getRegion()] : PHP_INT_MAX,
          'weight' => (int) $b->getWeight(),
        ];
      }
    }

    if (empty($candidates)) {
      return [
        '#markup' => '',
        '#cache' => [
          'contexts' => $cache_contexts,
          'tags' => $cache_tags,
          'max-age' => $cache_max_age,
        ],
      ];
    }

    // Sort by region order, then weight, then ID for deterministic ties.
    usort($candidates, function ($a, $b) {
      if ($a['region_order'] === $b['region_order']) {
        if ($a['weight'] === $b['weight']) {
          return strcmp($a['block']->id(), $b['block']->id());
        }
        return $a['weight'] <=> $b['weight'];
      }
      return $a['region_order'] <=> $b['region_order'];
    });

    $block = NULL;
    $block_content = NULL;
    foreach ($candidates as $candidate) {
      /** @var \Drupal\block\Entity\Block $candidate_block */
      $candidate_block = $candidate['block'];
      $campaign = $candidate['content'];

      if (!_carlson_general_modal_campaign_block_visible($candidate_block)) {
        continue;
      }

      $block = $candidate_block;
      $block_content = $campaign;

      // Ensure cache metadata follows the selected block.
      $cache_contexts = Cache::mergeContexts($cache_contexts, $candidate_block->getCacheContexts());
      // Merge cache tags from both the block content entity and the block
      // configuration entity so config changes invalidate pages.
      $cache_tags = Cache::mergeTags(
        Cache::mergeTags($cache_tags, $block_content->getCacheTags()),
        $candidate_block->getCacheTags()
      );
      break;
    }

    if (!$block || !$block_content) {
      return [
        '#markup' => '',
        '#cache' => [
          'contexts' => $cache_contexts,
          'tags' => $cache_tags,
          'max-age' => $cache_max_age,
        ],
      ];
    }

    $eyebrow = $block_content->get('field_modal_eyebrow')->value ?? '';
    $title = $block_content->get('field_modal_title')->value ?? '';
    if ($title === '') {
      $title = 'Announcement';
    }
    $decline_text = $block_content->get('field_modal_decline_text')->value ?? 'Maybe Later';
    $show_decline = (bool) ($block_content->get('field_modal_show_decline')->value ?? TRUE);

    $body = '';
    if ($block_content->hasField('field_modal_body') && !$block_content->get('field_modal_body')->isEmpty()) {
      $body_field = $block_content->get('field_modal_body');
      $body = [
        '#type' => 'processed_text',
        '#text' => $body_field->value,
        '#format' => _carlson_general_pick_text_format($body_field->format ?? 'full_html'),
      ];
    }

    $cta_url = '';
    $cta_text = '';
    if ($block_content->hasField('field_modal_cta_url') && !$block_content->get('field_modal_cta_url')->isEmpty()) {
      /** @var \Drupal\link\Plugin\Field\FieldType\LinkItemInterface|null $link */
      $link = $block_content->get('field_modal_cta_url')->first();
      if ($link) {
        $cta_url = $link->getUrl()->toString();
        $cta_text = $link->title ?: 'Learn more';
      }
    }

    $dismiss_days = 7;
    try {
      if ($block_content->hasField('field_modal_dismiss_days') && !$block_content->get('field_modal_dismiss_days')->isEmpty()) {
        $candidate = (int) $block_content->get('field_modal_dismiss_days')->value;
        if ($candidate > 0) {
          $dismiss_days = $candidate;
        }
      }
    } catch (\Throwable $t) {
      // Ignore; fallback to default.
    }

    $session_key = $block_content->get('field_modal_session_key')->value ?? 'modal_campaign';

    return [
      '#theme' => 'csm_modal_campaign',
      '#eyebrow' => $eyebrow,
      '#title' => $title,
      '#body' => $body,
      '#cta_url' => $cta_url,
      '#cta_text' => $cta_text,
      '#decline_text' => $decline_text,
      '#show_decline' => $show_decline,
      '#attached' => [
        'library' => [
          'carlson_general/carlson-general.modal-campaign',
        ],
        'drupalSettings' => [
          'csmModalCampaign' => [
            'sessionKey' => $session_key,
            'dismissDays' => $dismiss_days,
          ],
        ],
      ],
      '#cache' => [
        'contexts' => $cache_contexts,
        'tags' => $cache_tags,
        'max-age' => $cache_max_age,
      ],
    ];
  } catch (\Throwable $t) {
    return NULL;
  }
}

/**
 * Evaluate block visibility rules for a modal campaign placement.
 *
 * Mirrors DIG logic: treat bundle + path as an OR group, then AND with roles.
 */
function _carlson_general_modal_campaign_block_visible(\Drupal\block\Entity\Block $block): bool {
  $visibility = $block->getVisibility();
  $route_match = \Drupal::routeMatch();

  // Evaluate bundle and path as a group: if either is configured, allow OR
  // between them; if neither is configured, the group defaults to TRUE.
  $bundle_configured = isset($visibility['entity_bundle:node']);
  $path_configured = isset($visibility['request_path']);

  $bundle_match = FALSE;
  if ($bundle_configured) {
    $bundles = $visibility['entity_bundle:node']['bundles'] ?? [];
    $node = $route_match->getParameter('node');
    if (!$node instanceof Node && is_scalar($node)) {
      $node = Node::load($node);
    }
    $bundle_match = is_object($node) && in_array($node->bundle(), $bundles);
    if (!empty($visibility['entity_bundle:node']['negate'])) {
      $bundle_match = !$bundle_match;
    }
  }

  $path_match = FALSE;
  if ($path_configured) {
    $path_matcher = \Drupal::service('path.matcher');
    $current_path = \Drupal::service('path.current')->getPath();
    $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $pages = $visibility['request_path']['pages'] ?? '';

    $path_match = $path_matcher->matchPath($current_path, $pages) ||
      $path_matcher->matchPath($path_alias, $pages);

    // Explicit front page support.
    if (!$path_match && strpos($pages, '<front>') !== FALSE) {
      $is_front = in_array($route_match->getRouteName(), ['<front>', 'view.frontpage.page_1']);
      if (!$is_front && $route_match->getRouteName() === 'entity.node.canonical' && ($front_node = $route_match->getParameter('node'))) {
        if (!$front_node instanceof Node && is_scalar($front_node)) {
          $front_node = Node::load($front_node);
        }
        $is_front = is_object($front_node) && \Drupal::config('system.site')->get('page.front') === '/node/' . $front_node->id();
      }
      $path_match = $is_front;
    }

    if (!empty($visibility['request_path']['negate'])) {
      $path_match = !$path_match;
    }
  }

  // Group result: OR across configured bundle/path, TRUE if neither configured.
  $group_ok = ($bundle_configured || $path_configured)
    ? ($bundle_match || $path_match)
    : TRUE;

  // User role condition.
  $role_ok = TRUE;
  if (isset($visibility['user_role'])) {
    $current_user = \Drupal::currentUser();
    $user_roles = $current_user->getRoles();
    $allowed_roles = $visibility['user_role']['roles'] ?? [];
    $negate = !empty($visibility['user_role']['negate']);
    $role_match = !empty(array_intersect($user_roles, $allowed_roles));
    if ($negate) {
      $role_match = !$role_match;
    }
    $role_ok = $role_match;
  }

  return $group_ok && $role_ok;
}
