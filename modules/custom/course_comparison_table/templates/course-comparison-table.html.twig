<div class="comparison-table__container">
    <table id="course-table" class="tablesaw tablesaw-stack comparison-table nowrap" data-tablesaw-mode="stack">
        <thead>
            <tr id="title" class="comparison-table__header" data-mode="stack">
                <th scope="col" class="no-data"></th>
                <th scope="col" class="column-header">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=0 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
                <th scope="col" class="column-header">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=1 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
                <th scope="col" class="column-header">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=2 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
            </tr>
        </thead>

        {%
            set table_rows = [
                {'code': 'name', 'title': 'Name'},
                {'code': 'code', 'title': 'Code'},
                {'code': 'description__value', 'title': 'Description'},
                {'code': 'links', 'title': 'Links'}
            ]
        %}

        <tbody>
            {% for key, row in table_rows %}
            <tr id="{{ row.code }}">
                <th scope="row" class="comparison-table__category">{{ row.title }}</td>
                <td>-</td>
                <td>-</td>
                <td>-</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div id="comparison-menu" class="comparison-menu">
        <div class="comparison-menu__mobile-header">
            <div class="column-header_mobile-container">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=0 ><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div class="column-header_mobile-container">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=1 ><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div class="column-header_mobile-container">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=2 ><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>

        <div class="comparison-menu__add-program">
            <h3 class="comparison-menu__header">Add a Program Headline</h3>
            <hr class="comparison-menu__breakline">
            <label for="comparison-select" class="comparison-menu__label">Program</label>
            <select id="comparison-select" class="comparison-menu__select form-control">
                <option value="">- Select - </option>
            </select>
            <button id="comparison-add" class="maroon-outline-button">Add to Compare</button>
        </div>
    </div>
</div>