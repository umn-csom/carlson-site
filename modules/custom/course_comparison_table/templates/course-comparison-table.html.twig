<div class="comparison-table__container">
    <table id="course-table" class="tablesaw tablesaw-stack comparison-table nowrap" data-tablesaw-mode="stack">
        <thead>
            <tr id="title" class="comparison-table__header" data-mode="stack">
                <th scope="col" class="no-data"></th>
                <th scope="col" class="column-header column-no-content">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=0 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
                <th scope="col" class="column-header column-no-content">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=1 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
                <th scope="col" class="column-header column-no-content">
                    <span class="column-header-text">-</span>
                    <div class="remove-float">
                        Remove <button class="column-header-button" data-table-index=2 ><i class="fas fa-times"></i></button>
                    </div>
                </th>
            </tr>
        </thead>

        {%
            set table_rows = {
                'name': 'Name',
                'code': 'Code',
                'description__value': 'Description',
                'field_access_career_services': "Access Career Services?",
                'field_application_deadline': "Application Deadline",
                'field_application_fee': "Application Fee",
                'field_average_age': "Average Age",
                'field_average_alumni_starting_sa': "Average Alumni Starting Salary",
                'field_average_class_size': "Average Class Size",
                'field_average_gmat_score': "Average GMAT",
                'field_average_gre_score': "Average GRE Score",
                'field_average_work_experience': "Average Work Experience",
                'field_cohort_yes_or_no': "Cohort?",
                'field_course_modality_delivery': "Course Modality Delivery",
                'field_credit_required': "Credits Required",
                'field_degree_required_for_admiss': "Degree Required for Admission",
                'field_experiential_learning': "Experiential Learning",
                'field_gmat_gre_required': "GMAT/GRE Required",
                'field_gpa_average': "GPA Average",
                'field_knowledge_skills': "Knowledge Skills",
                'field_minimum_work_experience_re': "Minimum Work Experience Required",
                'field_program_length': "Program Length",
                'field_scholarship_available_yes_': "Scholarship Available",
                'field_specializations_available_': "Specializations Available?",
                'field_start_terms': "Start Terms",
                'field_tuition': "Tuition",
                'field_undergrad_major': "Undergrad Major",
                'links': 'Links',
            }
        %}

        <tbody>
            {% for key, row in table_rows %}
            <tr id="{{ key }}">
                <th scope="row" class="comparison-table__category">{{ row }}</td>
                <td class="column-no-content">-</td>
                <td class="column-no-content">-</td>
                <td class="column-no-content">-</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div id="comparison-menu" class="comparison-menu">
        <div class="comparison-menu__mobile-header">
            <div class="column-header_mobile-container column-no-content">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=0 ><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div class="column-header_mobile-container column-no-content">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=1 ><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div class="column-header_mobile-container column-no-content">
                <div class="column-header-text__mobile">-</div>
                <div class="remove-float">
                    Remove <button class="column-header-button" data-table-index=2 ><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>

        <div class="comparison-menu__add-program">
            <h3 class="comparison-menu__header">Add a Program Headline</h3>
            <hr class="comparison-menu__breakline">
            <label for="comparison-select" class="comparison-menu__label">Program</label>
            <select id="comparison-select" class="comparison-menu__select form-control">
                <option value="">- Select - </option>
            </select>
            <button id="comparison-add" class="maroon-outline-button">Add to Compare</button>
        </div>
    </div>
</div>