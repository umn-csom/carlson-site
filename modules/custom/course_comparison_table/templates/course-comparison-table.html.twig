<div class="comparison-table__container">
    <table id="course-table" class="tablesaw tablesaw-stack comparison-table nowrap" data-tablesaw-mode="stack">
        <thead>
            <tr id="title" class="comparison-table__header" data-mode="stack">
                <th scope="col" class="no-data"></th>

                {% for index in [0, 1 ,2] %}
                <th scope="col" class="column-header column-no-content">
                    <div class="remove-float">
                        <span>Remove <button class="column-header-button" data-table-index={{ index }} ><i class="fas fa-times"></i></button></span>
                    </div>
                    <div class="column-header-text">-</div>
                </th>
                {% endfor %}

            </tr>
        </thead>

        {%
            set table_rows = {
                'description__value': 'Description',
                'course_modality_delivery': "Course Modality Delivery",
                'full_time_or_part_time': "Full-Time or Part-Time",
                'program_experiences': "Program Experiences",
                'skills_knowledge_gained': "Skills/Knowledge Gained",
                'career_services': "Career Services",
                'minimum_work_experience': "Minimum Work Experience",
                'average_work_experience': "Average Work Experience",
                'gmat_gre_required': "GMAT/GRE Required",
                'undergrad_major': "Undergrad Major",
                'tuition': "Tuition",
                'scholarships': "Scholarships",
                'program_length': "Program Length",
                'start_terms': "Start Times",
                'application_deadlines': "Application Deadline",
                'international_applicants': 'International Applicants',                
                'links': 'Links',
            }
        %}

        <tbody>
            {% for key, row in table_rows %}
            <tr id="{{ key }}">
                <th scope="row" class="comparison-table__category">{{ row }}</td>
                <td class="column-no-content">-</td>
                <td class="column-no-content">-</td>
                <td class="column-no-content">-</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div id="comparison-menu" class="comparison-menu">
        <div class="comparison-menu__mobile-header">
            {% for index in [0, 1 ,2] %}
                <div class="column-header_mobile-container column-no-content">
                    <div class="remove-float">
                        <span>Remove <button class="column-header-button" data-table-index={{ index }} ><i class="fas fa-times"></i></button></span>
                    </div>
                    <div class="column-header-text__mobile">-</div>
                </div>
            {% endfor %}
        </div>

        <div class="comparison-menu__add-program">
            <h3 class="comparison-menu__header">Add a Master's Program</h3>
            <hr class="comparison-menu__breakline">
            <label for="comparison-select" class="comparison-menu__label">Program</label>
            <select id="comparison-select" class="comparison-menu__select form-control">
                <option value="">- Select - </option>
            </select>
            <button id="comparison-add" class="maroon-outline-button">Add to Compare</button>
        </div>
    </div>
</div>