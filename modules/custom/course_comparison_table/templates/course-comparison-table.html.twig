<div class="comparison-table__container">

    <div id="comparison-menu" class="comparison-menu">
        <div class="comparison-menu__mobile-header">
            {% for index in [0, 1 ,2] %}
                <div class="column-header_mobile-container column-no-content">
                    <div class="remove-float">
                        <span>Remove <button class="column-header-button" data-table-index={{ index }} aria-label="Remove column {{ index }}"><i class="fas fa-times"></i></button></span>
                    </div>
                    <div class="column-header-text__mobile">-</div>
                </div>
            {% endfor %}
        </div>

        <div class="comparison-menu__add-program">
            <h3 class="comparison-menu__header">Add a Master's Program</h3>
            <hr class="comparison-menu__breakline">

            <div class="comparison-menu__ui">
                <fieldset class="comparison-select__fieldset">
                    <label for="comparison-select" class="comparison-menu__label">Program</label>
                    <select id="comparison-select" class="comparison-menu__select form-control">
                        <option value="">- Select - </option>
                    </select>
                </fieldset>
                <button id="comparison-add" class="maroon-outline-button py-2 mt-2" aria-label="Add to Compare">Add to Compare</button>
            </div>
        </div>
    </div>

    <table id="course-table" class="tablesaw tablesaw-stack comparison-table nowrap" data-tablesaw-mode="stack">
        <thead>
            <tr id="title" class="comparison-table__header" data-mode="stack">
                <th scope="col" class="no-data" aria-hidden="true">&nbsp;</th>

                {% for index in [0, 1 ,2] %}
                <th scope="col" class="column-header column-no-content">
                    <div class="remove-float">
                        <span>Remove <button class="column-header-button" data-table-index={{ index }} aria-label="Remove column {{ index }}"><i class="fas fa-times"></i></button></span>
                    </div>
                    <div class="column-header-text">-</div>
                </th>
                {% endfor %}

            </tr>
        </thead>

        <tbody>
            {# filled in with comparison-table #}
        </tbody>
    </table>

</div>
