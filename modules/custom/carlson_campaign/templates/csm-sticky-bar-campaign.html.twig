{#
/**
 * @file
 * Sticky Bar Campaign markup.
 */
#}

<aside
  id="{{ sticky_id }}"
  class="campaign-sticky-bar campaign-sticky-bar--{{ sticky_position|clean_class }} campaign-sticky-bar--{{ sticky_color_scheme|clean_class }}"
  data-campaign-id="{{ campaign_id }}"
  role="region"
  aria-label="{{ 'Campaign announcement'|t }}"
  aria-hidden="true"
  hidden
>
  {# Sticky banner container. JS toggles hidden/aria-hidden after delay. #}
  <div class="campaign-sticky-bar__inner">
    {#
      Campaign text is sanitized server-side and may include editor-authored
      <a> tags from CKEditor. JS tracks link clicks by listening on the selector
      ".campaign-sticky-bar__text a" (links inside this wrapper).
    #}
    <div class="campaign-sticky-bar__text">{{ text }}</div>
  </div>
  <button type="button" class="campaign-sticky-bar__close" aria-label="{{ 'Dismiss sticky campaign'|t }}">
    <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
      <circle cx="10" cy="10" r="9.5"/>
      <path d="M6 6L14 14M6 14L14 6"/>
    </svg>
  </button>
</aside>
