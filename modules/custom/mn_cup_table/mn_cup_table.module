<?php
/**
 * Implements hook_theme().
 */
function mn_cup_table_theme($existing, $type, $theme, $path) {
  return [
    'filterable_table' => [
        'variables' => ['title' => NULL, 'description' => NULL],
    ],
  ];
}

function mn_cup_table_preprocess_block(&$variables) {
    $variables['#attached']['library'][] = 'mn_cup_table/mn_cup_table_code';
}