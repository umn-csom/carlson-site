<?php

/**
 * @file
 * Contains carlson_recaptcha.module.
 */

use Drupal\carlson_recaptcha\Render\CaptchaFallbackPreRender;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;

/**
 * Implements hook_form_alter().
 *
 * CAPTCHA's visible "CAPTCHA" legend comes from captcha.settings via theme
 * preprocess, not #title on the element. A trusted #pre_render callback marks
 * the v3→v2 fallback so hook_preprocess_captcha() can strip that legend and
 * so hook_theme_suggestions_captcha_alter() can swap to a Twig layout where the
 * description sits above the widget (captchas render outside Form API order).
 * An #after_build callback floats the v2 checkbox CAPTCHA to the top of its
 * parent group when that fallback is active. Root #after_build applies a form
 * class and attaches CSS/JS (inert + pointer-events) when that fallback is
 * present after build completes.
 */
function carlson_recaptcha_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id
): void {
  if (empty($form['#carlson_recaptcha_form_fallback_chrome_added'])) {
    $form['#carlson_recaptcha_form_fallback_chrome_added'] = TRUE;
    $form['#after_build'][] = [
      CaptchaFallbackPreRender::class,
      'applyFormChrome',
    ];
  }
  _carlson_recaptcha_attach_captcha_fallback_callbacks($form);
}

/**
 * Recursively adds trusted CAPTCHA callbacks for v3→v2 fallback UX.
 *
 * @param array $element
 *   A form subtree.
 */
function _carlson_recaptcha_attach_captcha_fallback_callbacks(array &$element): void {
  foreach (Element::children($element) as $key) {
    if (!isset($element[$key]) || !is_array($element[$key])) {
      continue;
    }
    _carlson_recaptcha_attach_captcha_fallback_callbacks($element[$key]);
  }
  if (($element['#type'] ?? '') !== 'captcha') {
    return;
  }
  if (!empty($element['#carlson_recaptcha_fallback_callbacks_added'])) {
    return;
  }
  $element['#carlson_recaptcha_fallback_callbacks_added'] = TRUE;
  $element['#after_build'][] = [
    CaptchaFallbackPreRender::class,
    'promoteV2FallbackWeight',
  ];
  $element['#pre_render'][] = [
    CaptchaFallbackPreRender::class,
    'markV3V2Fallback',
  ];
}

/**
 * Implements hook_theme().
 */
function carlson_recaptcha_theme($existing, $type, $theme, $path) {
  return [
    'captcha__carlson_recaptcha_fallback' => [
      'base hook' => 'captcha',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for captcha.
 */
function carlson_recaptcha_theme_suggestions_captcha_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  if (!is_array($element) || !_carlson_recaptcha_captcha_is_v3_v2_fallback($element)) {
    return;
  }
  $suggestions[] = 'captcha__carlson_recaptcha_fallback';
}

/**
 * Implements hook_form_FORM_ID_alter() for recaptcha_v3_settings.
 */
function carlson_recaptcha_form_recaptcha_v3_settings_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id
): void {
  if (!_carlson_recaptcha_private_keys_configured('v3')) {
    return;
  }

  $private_key_url = Url::fromRoute(
    'carlson_recaptcha.recaptcha_private_keys',
  )->toString();

  $form['carlson_private_key_file_notice'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => [
      'class' => [
        'messages',
        'messages--status',
      ],
    ],
    'message' => [
      '#markup' => t(
        'The reCAPTCHA v3 site and secret keys are managed in a private, '
        . 'environment-specific JSON file. Use the '
        . '<a href=":url">reCAPTCHA private keys</a> page to update them.',
        [':url' => $private_key_url],
      ),
    ],
  ];

  foreach (['site_key', 'secret_key'] as $key) {
    if (!isset($form[$key])) {
      continue;
    }

    $form[$key]['#required'] = FALSE;
    $form[$key]['#default_value'] = t('Configured in private key file');
    $form[$key]['#description'] = t(
      'This value is loaded from the private key file and is not saved in '
      . 'Drupal configuration.',
    );
    $form[$key]['#attributes']['readonly'] = 'readonly';
  }

  // Form-level #submit only: button #submit replaces defaults and would skip
  // ReCaptchaV3SettingsForm::submitForm().
  $form['#submit'][] = 'carlson_recaptcha_recaptcha_v3_settings_submit';
}

/**
 * Keeps file-based reCAPTCHA v3 keys out of editable configuration.
 */
function carlson_recaptcha_recaptcha_v3_settings_submit(
  array &$form,
  FormStateInterface $form_state
): void {
  if (!_carlson_recaptcha_private_keys_configured('v3')) {
    return;
  }

  \Drupal::configFactory()
    ->getEditable('recaptcha_v3.settings')
    ->set('site_key', '')
    ->set('secret_key', '')
    ->save();
}

/**
 * Implements hook_form_FORM_ID_alter() for recaptcha_admin_settings.
 */
function carlson_recaptcha_form_recaptcha_admin_settings_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id
): void {
  if (!_carlson_recaptcha_private_keys_configured('v2')) {
    return;
  }

  $private_key_url = Url::fromRoute(
    'carlson_recaptcha.recaptcha_private_keys',
  )->toString();

  $form['general']['carlson_private_key_file_notice'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => [
      'class' => [
        'messages',
        'messages--status',
      ],
    ],
    'message' => [
      '#markup' => t(
        'The reCAPTCHA v2 site and secret keys are managed in a private, '
        . 'environment-specific JSON file. Use the '
        . '<a href=":url">reCAPTCHA private keys</a> page to update them.',
        [':url' => $private_key_url],
      ),
    ],
  ];

  foreach (['recaptcha_site_key', 'recaptcha_secret_key'] as $key) {
    if (!isset($form['general'][$key])) {
      continue;
    }

    $form['general'][$key]['#required'] = FALSE;
    $form['general'][$key]['#default_value'] = t(
      'Configured in private key file',
    );
    $form['general'][$key]['#description'] = t(
      'This value is loaded from the private key file and is not saved in '
      . 'Drupal configuration.',
    );
    $form['general'][$key]['#attributes']['readonly'] = 'readonly';
  }

  // Form-level #submit only; see recaptcha_v3 alter comment above.
  $form['#submit'][] = 'carlson_recaptcha_recaptcha_admin_settings_submit';
}

/**
 * Keeps file-based reCAPTCHA v2 keys out of editable configuration.
 */
function carlson_recaptcha_recaptcha_admin_settings_submit(
  array &$form,
  FormStateInterface $form_state
): void {
  if (!_carlson_recaptcha_private_keys_configured('v2')) {
    return;
  }

  \Drupal::configFactory()
    ->getEditable('recaptcha.settings')
    ->set('site_key', '')
    ->set('secret_key', '')
    ->save();
}

/**
 * Implements hook_captcha_alter().
 *
 * Removes legacy hide-badge branding markup from recaptcha_v3 while keeping
 * the recaptcha_v3_no_badge CSS that hides the floating badge.
 *
 * @todo Remove after upstream recaptcha_v3 is 2.0.5 or greater (obsolete
 *   markup dropped there).
 *
 * @param array $captcha
 *   Challenge definition from hook_captcha('generate').
 * @param array $info
 *   CAPTCHA element metadata; includes the implementing module name.
 *
 * @see captcha.api.php
 */
function carlson_recaptcha_captcha_alter(array &$captcha, array $info): void {
  if (($info['module'] ?? '') !== 'recaptcha_v3') {
    return;
  }
  if (empty($captcha['form']['hide_badge'])) {
    return;
  }

  $libraries = $captcha['form']['hide_badge']['#attached']['library'] ?? [];
  if (
    $libraries !== []
    && isset($captcha['form']['captcha_response'])
    && is_array($captcha['form']['captcha_response'])
  ) {
    $existing = $captcha['form']['captcha_response']['#attached']['library']
      ?? [];
    $captcha['form']['captcha_response']['#attached']['library'] =
      array_values(array_unique(array_merge($existing, $libraries)));
  }

  unset($captcha['form']['hide_badge']);
}

/**
 * TRUE when CAPTCHA markup is showing v3 falling back to the v2 checkbox.
 *
 * @param array $element
 *   The CAPTCHA render array passed into captcha theming.
 *
 * @return bool
 *   TRUE when the fallback legend/description tweaks apply.
 */
function _carlson_recaptcha_captcha_is_v3_v2_fallback(array $element): bool {
  return !empty($element['#carlson_recaptcha_v3_v2_fallback'])
    || (
      ($element['#captcha_validate'] ?? '') === 'recaptcha_v3_validate'
      && ($element['#captcha_type_challenge'] ?? '') === 'reCAPTCHA'
    );
}

/**
 * Implements hook_preprocess_captcha().
 *
 * When reCAPTCHA v3 swaps to the v2 checkbox fallback, hide the generic
 * "CAPTCHA" fieldset title and replace the site-wide hint text. Layout order
 * (description above widget) is handled by captcha--carlson-recaptcha-fallback.
 * The fallback is flagged during form build via
 * CaptchaFallbackPreRender::markV3V2Fallback().
 *
 * @param array $variables
 *   Theme variables for captcha.html.twig.
 */
function carlson_recaptcha_preprocess_captcha(array &$variables): void {
  $element = $variables['element'] ?? NULL;
  if (!is_array($element) || !_carlson_recaptcha_captcha_is_v3_v2_fallback($element)) {
    return;
  }

  $variables['title'] = '';
  $variables['description'] = t(
    'We could not verify your browser automatically. Complete the checkbox to confirm you are human. This extra step helps prevent automated spam submissions.'
  );
}

/**
 * Determines whether the private reCAPTCHA key file has a key pair.
 *
 * @param string $version
 *   The reCAPTCHA key version, such as v2 or v3.
 *
 * @return bool
 *   TRUE when the private key file has both key values.
 */
function _carlson_recaptcha_private_keys_configured(string $version): bool {
  if (!\Drupal::hasService('carlson_recaptcha.recaptcha_private_key_file')) {
    return FALSE;
  }

  /** @var \Drupal\carlson_recaptcha\Service\RecaptchaPrivateKeyFile $key_file */
  $key_file = \Drupal::service('carlson_recaptcha.recaptcha_private_key_file');
  $keys = $key_file->read();

  return $key_file->hasValue($keys, $version, 'site_key') &&
    $key_file->hasValue($keys, $version, 'secret_key');
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * @param array $form
 *   The Webform submission form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 * @param string $form_id
 *   The Webform submission form ID.
 *
 * @return void
 */
function carlson_recaptcha_webform_submission_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
): void {
  if (!_carlson_recaptcha_v3_is_ready()) {
    return;
  }

  $captcha_type = 'recaptcha_v3/webform';
  if (
    _carlson_recaptcha_apply_v3_to_captcha_elements(
      $form,
      $captcha_type
    )
  ) {
    return;
  }

  $form['carlson_recaptcha_v3'] = [
    '#type' => 'captcha',
    '#captcha_type' => $captcha_type,
    '#weight' => 99,
  ];
}

/**
 * Determines whether reCAPTCHA v3 can validate Webform submissions.
 *
 * @return bool
 *   TRUE when reCAPTCHA v3 is enabled, keyed, and has the Webform action.
 */
function _carlson_recaptcha_v3_is_ready(): bool {
  $recaptcha_v2_config = \Drupal::config('recaptcha.settings');
  if (
    !$recaptcha_v2_config->get('site_key') ||
    !$recaptcha_v2_config->get('secret_key')
  ) {
    return FALSE;
  }

  $recaptcha_v3_config = \Drupal::config('recaptcha_v3.settings');
  if (
    !$recaptcha_v3_config->get('site_key') ||
    !$recaptcha_v3_config->get('secret_key')
  ) {
    return FALSE;
  }

  return (bool) \Drupal::entityTypeManager()
    ->getStorage('recaptcha_v3_action')
    ->load('webform');
}

/**
 * Updates existing CAPTCHA elements to use the Webform reCAPTCHA v3 action.
 *
 * @param array $element
 *   A form or form element render array.
 * @param string $captcha_type
 *   The CAPTCHA challenge type to apply.
 *
 * @return bool
 *   TRUE if a CAPTCHA element was found and updated.
 */
function _carlson_recaptcha_apply_v3_to_captcha_elements(
  array &$element,
  string $captcha_type
): bool {
  $updated = FALSE;

  foreach ($element as $key => &$child) {
    if (is_string($key) && str_starts_with($key, '#')) {
      continue;
    }
    if (!is_array($child)) {
      continue;
    }
    if (($child['#type'] ?? NULL) === 'captcha') {
      $child['#captcha_type'] = $captcha_type;
      $updated = TRUE;
      continue;
    }
    if (
      _carlson_recaptcha_apply_v3_to_captcha_elements(
        $child,
        $captcha_type
      )
    ) {
      $updated = TRUE;
    }
  }
  unset($child);

  return $updated;
}
