/**
 * Calculate expiration date for a user based on their roles.
 *
 * @param \Drupal\user\Entity\User $user
 *   The user entity.
 *
 * @return int|null
 *   The expiration timestamp or NULL if no expiration applies.
 */
function user_expire_calculate_role_expiration($user) {
  $rules = user_expire_get_role_rules();

  // If no rules are configured at all, return NULL.
  if (empty($rules)) {
    return NULL;
  }

  $inactivity_period = NULL;

  // Check authenticated role first - it applies to ALL logged-in users.
  // If the authenticated role has an expiration rule, it takes precedence over
  // all other role-specific rules since every logged-in user has this role.
  if (isset($rules[RoleInterface::AUTHENTICATED_ID]) && is_numeric($rules[RoleInterface::AUTHENTICATED_ID]) && $rules[RoleInterface::AUTHENTICATED_ID] > 0) {
    $inactivity_period = $rules[RoleInterface::AUTHENTICATED_ID];
  }
  else {
    // If authenticated role has no rule, check specific roles.
    // TRUE excludes 'authenticated' role.
    $user_roles = $user->getRoles(TRUE);
    $shortest_period = NULL;

    // Find the shortest inactivity period among the user's roles.
    // The shortest period determines when the account will expire.
    foreach ($user_roles as $role_id) {
      if (isset($rules[$role_id]) && is_numeric($rules[$role_id]) && $rules[$role_id] > 0) {
        if ($shortest_period === NULL || $rules[$role_id] < $shortest_period) {
          $shortest_period = $rules[$role_id];
        }
      }
    }

    $inactivity_period = $shortest_period;
  }

  if ($inactivity_period && $inactivity_period > 0) {
    $last_access = $user->getLastAccessedTime();
    if ($last_access == 0) {
      // If user never logged in, use creation time.
      $last_access = $user->getCreatedTime();
    }
    return $last_access + $inactivity_period;
  }

  return NULL;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for user entities.
 *
 * If the account was blocked but is now active, update the expiry so it is
 * not re-blocked by the next cron run.
 */
#[LegacyHook]
function user_expire_user_presave(User $account): void {
  \Drupal::service(UserExpireHooks::class)->userPresave($account);
}
