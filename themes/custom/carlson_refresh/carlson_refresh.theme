 */

function carlson_refresh_preprocess_paragraph(&$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $bundle = $paragraph->bundle();

  switch($bundle) {
    case 'carlson_staff_faculty':
      // kint($paragraph);
    break;
  }
  // Add Page Type as variable - needed for execuitve_ed
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
      $variables['node'] = $node;
  }
}

function carlson_refresh_preprocess_field(&$variables, $hook) {
