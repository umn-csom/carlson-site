use Symfony\Component\DependencyInjection\Exception\ServiceNotFoundException;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 */
function carlson_refresh_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['carlson_refresh_navbar_top_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );
  $form['components']['navbar']['carlson_refresh_navbar_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );

  // Work-around for a core bug affecting admin themes. See issue #943212.
  if (isset($form_id)) {
    return;
  }

  unset($form['logo']);
  $form['theme_settings']['#open'] = FALSE;
  $form['favicon']['default_favicon']['#default_value'] = theme_get_setting('favicon.use_default');
  $form['header_options'] = array(
    '#type' => 'details',
    '#title' => t('Header options'),
    '#open' => TRUE,
  );
  $form['header_options']['campus_select'] = array(
    '#type' => 'radios',
    '#title' => t('Select campus'),
    '#default_value' => theme_get_setting('campus_select'),
    '#options' => array(
      'umnhf-campus-tc' => 'Twin Cities',
      'umnhf-campus-c' => 'Crookston',
      'umnhf-campus-d' => 'Duluth',
      'umnhf-campus-e' => 'Extension',
      'umnhf-campus-m' => 'Morris',
      'umnhf-campus-r' => 'Rochester',
    ),
  );
  $form['header_options']['dtd_select'] = array(
    '#type' => 'radios',
    '#title' => t('Use "Driven to Discover"'),
    '#default_value' => theme_get_setting('dtd_select'),
    '#options' => array(
      'dtd' => t('yes'),
      'no-dtd' => t('no'),
    ),
  );
  $form['header_options']['header_color'] = array(
    '#type' => 'radios',
    '#title' => t('Header background color'),
    '#default_value' => theme_get_setting('header_color'),
    '#options' => array(
      'umnhf-background-maroon' => 'maroon',
      'umnhf-background-gold' => 'gold',
    ),
  );
  $form['header_options']['campus_links'] = array(
    '#type' => 'radios',
    '#title' => t('Use campus links'),
    '#options' => array(
      'no-links' => 'No campus links',
      'links' => 'Include campus links',
    ),
    '#description' => t('Choose whether to include links to system campuses.'),
    '#default_value' => theme_get_setting('campus_links'),
  );
  $form['header_options']['myu_text'] = array(
    '#type' => 'radios',
    '#title' => t('MyU link text'),
    '#description' => t('Header MyU link can be configured to either "MyU: For Students, Faculty, and Staff" or just "MyU"'),
    '#options' => array(
      'sfs' => 'use "For Students, Faculty, and Staff',
      'myu' => 'only use "MyU"',
    ),
    '#default_value' => theme_get_setting('myu_text'),
  );
  $form['header_options']['mobile_search'] = array(
    '#type' => 'radios',
    '#options' => array(
      'dropdown' => 'Dropdown',
      'two-tier' => 'Search box always visible',
    ),
    '#default_value' => theme_get_setting('mobile_search'),
    '#title' => t('Mobile search box setting'),
    '#description' => t('Configure how search appears on small screens - expandable with a dropdown button, or always visible'),
  );

  $form['footer_options'] = array(
    '#type' => 'details',
    '#title' => t('Footer options'),
    '#open' => TRUE,
  );
  $form['footer_options']['privacy_link'] = array(
    '#type' => 'textfield',
    '#default_value' => theme_get_setting('privacy_link'),
    '#title' => 'Privacy link',
    '#description' => t('If you are using an alternative privacy statement, replace http://privacy.umn.edu with the appropriate url (include "http://" if on another site, or an absolute path - begins with "/" - if using a page on this website).'),
  );
  $form['footer_options']['footer_date'] = array(
    '#type' => 'radios',
    '#title' => t('Use "Current as of X" Date?'),
    '#options' => array(
      0 => 'No',
      1 => 'Yes',
    ),
    '#default_value' => theme_get_setting('footer_date'),
  );
}

/**
 * Prepares global variables for all templates.
 */
function carlson_refresh_preprocess(&$variables) {
  $handler = \Drupal::service('theme_handler');
  $variables['theme_directory'] = $handler->getTheme('carlson_refresh')->getPath();
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
}

function carlson_refresh_preprocess_html(&$variables) {

  $variables['page']['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        'href' => 'https://fonts.googleapis.com',
      ],
    ],
    'google_api_preconnect'
  ];
  $variables['page']['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        'href' => 'https://fonts.gstatic.com',
        'crossorigin' => ''
      ],
    ],
    'google_static_preconnect'
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 *
 * This hook for adding a custom suggestion page template.
 *
 * Place this function in your THEME_NAME.theme file.
 * then you can use the template page--[content-type].html.twig
 *
 * Tested and worked with Drupal Version 8.3.x
 */
function carlson_refresh_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $content_type = $node->bundle();
    $suggestions[] = 'page__' . $content_type;
  }
}

/**
 * Implements hook_preprocess_node() for NODE document templates.
 */
function carlson_refresh_preprocess_node(&$variables) {

  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  // Check the type
  $bundle = $node->bundle();

  // Allowed view modes
  $view_mode = $variables['view_mode']; // Retrieve view mode
  $allowed_view_modes = ['full']; // Array of allowed view modes (for performance so as to not execute on unneeded nodes)

  // If view mode is in allowed view modes list, pass to THEME_add_regions_to_node()
  if (in_array($view_mode, $allowed_view_modes)) {
    // Allowed regions (for performance so as to not execute for unneeded region)
    $allowed_regions = ['sticky_sidebar', 'inner_nav', 'node_content', 'node_middle', 'node_bottom_left', 'node_bottom_right', 'node_bottom', 'node_top'];
    carlson_refresh_add_regions_to_node($allowed_regions, $variables);
  }
  switch ($bundle) {
    case 'news':
      // Check if there is a sidebar so we can add the right classes
      $sidebar = $node->field_sidebar_content->getValue();
      if (!empty($sidebar)) {
        $variables['has_sidebar'] = TRUE;
      }

      if (!$node->get('field_in_the_media')->isEmpty() && !$node->get('field_featured_media_faculty')->isEmpty()) {
        $referenceItem = $node->get('field_featured_media_faculty')->first();
        $entityReference = $referenceItem->get('entity');
        $entityAdapter = $entityReference->getTarget();
        if (!is_null($entityAdapter)) {
          $referencedEntity = $entityAdapter->getValue();
          $variables['faculty_member'] = $referencedEntity->getTitle();
          $variables['faculty_member_link'] = $referencedEntity->toUrl();
          $variables['faculty_published'] = $referencedEntity->isPublished();
        }
      }
      break;
    case 'blog_entry':
      // Check if there is a sidebar so we can add the right classes
      $sidebar = $node->field_blog_categories->getValue();
      if (!empty($sidebar)) {
        $variables['has_sidebar'] = TRUE;
      }
      $byline = $node->field_blog_by_line->getString();
      if (!empty($sidebar)) {
        $variables['byline'] = '<span class="basic-hero__title--byline"> — by ' . $byline . "</span>";
      }
      break;
    case 'executive_ed_program':
      if ($node->get('field_ee_course_dates')->first()) {
        $referenceItem = $node->get('field_ee_course_dates')->first();
        $entityReference = $referenceItem->get('entity');
        $entityAdapter = $entityReference->getTarget();
        $referencedEntity = $entityAdapter->getValue();
        $variables['register_desc'] = $referencedEntity->get('field_ee_register_desc')->view();
        $variables['register_link'] = $referencedEntity->get('field_ee_register')->view();
        $variables['invoice_link'] = $referencedEntity->get('field_ee_request_invoice')->view();
      }
      break;
  }
}

/**
 * THEME_add_regions_to_node
 */

function carlson_refresh_add_regions_to_node($allowed_regions, &$variables) {
  // Retrieve active theme
  $theme = \Drupal::theme()->getActiveTheme()->getName();

  // Retrieve theme regions
  $available_regions = system_region_list($theme, 'REGIONS_ALL');

  // Validate allowed regions with available regions
  $regions = array_intersect(array_keys($available_regions), $allowed_regions);

  // For each region
  foreach ($regions as $key => $region) {

    // Load region blocks
    $blocks = \Drupal::entityTypeManager()->getStorage('block')->loadByProperties(array('theme' => $theme, 'region' => $region));
    // Sort blocks by weight.
    uasort($blocks, 'Drupal\block\Entity\Block::sort');

    // Capture viewable blocks and their settings to $build
    $build = array();
    foreach ($blocks as $key => $block) {
      if ($block->access('view')) {
        $builder = \Drupal::entityTypeManager()->getViewBuilder('block');
        $build[$key] = $builder->view($block, 'block');
      }
    }

    // Add build to region
    $variables[$region] = $build;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form templates.
 * @param array $suggestions
 * @param array $variables
 */
function carlson_refresh_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  $name = '';
  $id = $variables['elements']['#id'] ?? '';
  $block_content = $variables['elements']['content']['#block_content'] ?? '';
  $region = $id ? (Block::load($id) ? Block::load($id)->getRegion() : '') : '';
  $plugin = $variables['elements']['#base_plugin_id'] ?? '';
  $derivative = $variables['elements']['#derivative_plugin_id'] ?? '';
  $suggestion = $variables['elements']['#configuration']['suggestion'] ?? '';

  // Reset all suggestions.
  $suggestions = [];

  // Normal blocks.
  if ($id) {
    $name = $id;
  }

  // Custom block content blocks.
  if (is_object($block_content)) {
    $name = $block_content->bundle();
  }

  // @todo layout builder blocks
  if (!$name) {
    $name = 'unnamed';
  }

  if ($region) {
    $suggestions[] = 'block__' . $region;
  }

  if ($plugin) {
    $suggestions[] = 'block__' . $plugin;
  }

  if ($name) {
    $suggestions[] = 'block__bundle__' . $name;
  }

  if ($plugin && $region) {
    $suggestions[] = 'block__' . $plugin . '__' . $region;
  }

  if ($plugin && $derivative && $plugin != $derivative) {
    $suggestions[] = 'block__' . $plugin . '__' . $derivative;
  }

  if ($plugin && $suggestion) {
    $suggestions[] = 'block__' . $plugin . '__' . $suggestion;
  }

  if ($plugin && $name) {
    $suggestions[] = 'block__' . $plugin . '__' . $name;
  }

  if ($region) {
    if ($name) {
      $suggestions[] = 'block__' . $region . '__' . $name;
    }

    if ($plugin && $derivative && $plugin != $derivative) {
      $suggestions[] = 'block__' . $region . '__' . $plugin . '__' . $derivative;
    }

    if ($plugin && $name) {
      $suggestions[] = 'block__' . $region . '__' . $plugin . '__' . $name;
    }
  }

  // Remove duplicate suggestions.
  $suggestions = array_unique($suggestions);
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * Pass block region value to content so this can be used in
 * THEME_theme_suggestions_menu_alter.
 */
function carlson_refresh_preprocess_block(&$variables) {
  $id = $variables['elements']['#id'] ?? '';
  $plugin = $variables['elements']['#base_plugin_id'] ?? '';
  $derivative = $variables['elements']['#derivative_plugin_id'] ?? '';
  if (!empty($id)) {
    $region = Block::load($id) ? Block::load($id)->getRegion() : '';
    if (!empty($region)) {
      $variables['content']['#attributes']['data-block']['region'] = $region;
    }
  }
  if (!empty($plugin) && $plugin !== $id) {
    $variables['content']['#attributes']['data-block']['plugin'] = $plugin;
  }
  if (!empty($derivative) && $derivative !== $plugin && $derivative !== $id) {
    $variables['content']['#attributes']['data-block']['derivative'] = $derivative;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function carlson_refresh_theme_suggestions_menu_alter(array &$suggestions, array $variables) {

  $name = $variables['menu_name'] ?? '';
  $region = $variables['attributes']['data-block']['region'] ?? '';
  $plugin = $variables['attributes']['data-block']['plugin'] ?? '';
  $derivative = $variables['attributes']['data-block']['derivative'] ?? '';
  $suggestion = $variables['menu_block_configuration']['suggestion'] ?? '';

  if (empty($name)) {
    return;
  }

  // Remove pollution from simple_megamenu theme suggestions.
  $clean_suggestions = [];
  foreach ($suggestions as $key => $value) {
    if (!str_contains($value, 'simple_megamenu')) {
      $clean_suggestions[] = $value;
    }
  }
  $suggestions = $clean_suggestions;

  if (!empty($region)) {
    // Add suggestion for menu block region name.
    $suggestions[] = 'menu__' . $region;
    $suggestions[] = 'menu__' . $region . '__' . $name;

    if (_carlson_refresh_region_has_simple_megamenu($name, $region)) {
      // Add simple mega menu suggestion from menu block configuration.
      $suggestions[] = 'menu__' . $region . '__simple_megamenu';
      $suggestions[] = 'menu__' . $region . '__' . $name . '__simple_megamenu';
    }
  }

  if (!empty($plugin)) {
    // Add suggestion for block plugin name.
    $suggestions[] = 'menu__' . $plugin;
    $suggestions[] = 'menu__' . $plugin . '__' . $name;
    if (!empty($derivative)) {
      $suggestions[] = 'menu__' . $plugin . '__' . $derivative;
      if ($derivative != $name) {
        $suggestions[] = 'menu__' . $plugin . '__' . $derivative . '__' . $name;
      }
    }
  }

  // Add the menu block suggestion removed in hook_preprocess_block.
  if (!empty($suggestion)) {
    // Sanitize suggestion.
    $suggestion = strtr($suggestion, '-', '_');

    $suggestions[] = 'menu__' . $suggestion;
    if (!empty($plugin)) {
      $suggestions[] = 'menu__' . $plugin . '__' . $suggestion;
    }
    if (!empty($region)) {
      $suggestions[] = 'menu__' . $region . '__' . $suggestion;
      $suggestions[] = 'menu__' . $region . '__' . $name . '__' . $suggestion;
    }
    else {
      $suggestions[] = 'menu__' . $name . '__' . $suggestion;
    }
  }

  // Remove duplicate suggestions.
  $suggestions = array_unique($suggestions);
}

function _carlson_refresh_region_has_simple_megamenu($menu_name, $region) {
  $allowed_regions = ['navbar_primary'];
  if (in_array($region, $allowed_regions)) {
    try {
      /** @var \Drupal\simple_megamenu\SimpleMegaMenuHelperInterface $simple_megamenu_helper */
      $simple_megamenu = \Drupal::service('simple_megamenu.helper');
      return $simple_megamenu->getMegaMenuTypeWhichTargetMenu($menu_name);
    } catch (ServiceNotFoundException $e) {
    }
  }
  return FALSE;
}

