{
    "name": "carlson_refresh",
    "version": "8.4.1",
    "description": "Carlson Refresh theme is an implementation of Barrio SASS.",
    "main": "index.js",
    "keywords": [
        "SASS",
        "Bootstrap",
        "Drupal",
        "Barrio"
    ],
    "author": "@hatuhay",
    "license": "MIT",
    "dependencies": {
        "bootstrap": "^4.6.2",
        "jquery": "^3.6.0",
        "popper.js": "^1.16.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "node-sass": "^9.0.0",
        "postcss": "^8.4.31",
        "postcss-cli": "^10.1.0",
        "postcss-prefixwrap": "^1.55.0",
        "postcss-rem-to-pixel": "^4.1.2",
        "postcss-selector-replace": "^1.0.2",
        "prettier": "^3.5.3",
        "stylelint": "^16.18.0",
        "stylelint-checkstyle-formatter": "^0.1.2",
        "stylelint-config-sass-guidelines": "^12.1.0",
        "stylelint-config-standard": "^38.0.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "stylelint-prettier": "^5.0.3"
    },
    "optionalDependencies": {
        "fsevents": "^2.1.2"
    },
    "engines": {
        "npm": ">=8.0.0",
        "node": ">=18.0.0"
    },
    "scripts": {
        "lint:scss": "stylelint \"scss/**/*.scss\"",
        "lint:scss:fix": "stylelint --fix \"scss/**/*.scss\"",
        "sass": "node-sass scss -o css --output-style nested --source-map true --include-path node_modules --include-path ../../../../../libraries/",
        "sass-watch": "node-sass scss -o css --output-style nested --source-map true --include-path node_modules --include-path ../../../../../libraries/ --watch",
        "icon-font": "node-sass carlson-icons/style.scss carlson-icons/demo-files/style.css --output-style compressed",
        "postcss": "postcss css/style.css -o css/ckeditor-style.css",
        "postcss-watch": "postcss css/style.css -o css/ckeditor-style.css --watch",
        "build": "npm run sass && npm run postcss",
        "watch": "concurrently \"npm run sass-watch\" \"npm run postcss-watch\""
    }
}
