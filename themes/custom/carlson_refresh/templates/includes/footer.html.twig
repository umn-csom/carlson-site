<footer class="footer bg-primary py-10">
  <div class="container">
    <div class="row footer__logo text-center">
      <div class="col-12 text-center pb-10 border-bottom border-white">
        <a class="d-lg-block" href="/"><img src="/{{ directory }}/images/new-footer-logo.png" width="413" height="81" alt="Carlson School of Management (home)"></a>
      </div>
    </div>
    <div class="row footer__content">
      <div class="col-12 pt-10">
        <div class="row">
          {% block footer %}
          {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth %}
          <div class="col-12 col-md-4 col-lg-3 footer__info text-white mb-6 mb-md-0 {{ (page.footer_first|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_first }}
          </div>
          <div class="col-12 col-md-4 col-lg-3 footer__links text-white mb-6 mb-md-0 {{ (page.footer_second|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_second }}
          </div>
          <div class="col-12 col-md-4 col-lg-3 footer__links text-white mb-4 {{ (page.footer_third|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_third }}
          </div>
          <div class="col-12 col-lg-3 footer__connect text-white text-center text-lg-left mt-6 mt-lg-0">
            <p class="text-center text-lg-left mt-0 mb-4 text-uppercase font-weight-semi-bold">Connect with Carlson School</p>
            <ul class="list-unstyled list-inline">
              <li class="list-inline-item mr-4">
                <a class="text-decoration-none" href="https://www.facebook.com/CarlsonSchoolUMN" target="_blank">
                  <i class="fs-40 icon icon-facebook"></i>
                  <span class="sr-only">Carlson School on Facebook</span>
                </a>
              </li>
              {# <li class="list-inline-item mr-4">
                <a class="text-decoration-none" href="https://twitter.com/CarlsonNews" target="_blank">
                  <i class="fs-40 icon icon-twitter"></i>
                  <span class="sr-only">Carlson School on Twitter</span>
                </a>
              </li> #}
              <li class="list-inline-item mr-4">
                <a class="text-decoration-none" href="https://www.instagram.com/carlsonschoolumn/" target="_blank">
                  <i class="fs-40 icon icon-instagram"></i>
                  <span class="sr-only">Carlson School on Instagram</span>
                </a>
              </li>
              <li class="list-inline-item mr-4">
                <a class="text-decoration-none" href="https://www.linkedin.com/school/carlsonschoolumn" target="_blank">
                  <i class="fs-40 icon icon-linkedin"></i>
                  <span class="sr-only">Carlson School on LinkedIn</span>
                </a>
              </li>
              <li class="list-inline-item">
                <a class="text-decoration-none" href="https://www.youtube.com/user/CarlsonSchoolUMN" target="_blank">
                  <i class="fs-40 icon icon-youtube"></i>
                  <span class="sr-only">Carlson School on YouTube</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
        {% endif %}
        {% endblock %}
      </div>
    </div>
  </div>
</footer>
