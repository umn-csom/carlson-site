<div class="footer py-10">
  <div class="container">
    <div class="row footer__logo text-center">
      <div class="col-12 text-center pb-10 border-bottom border-white">
        {% if not is_front %}<a class="d-inline-block" href="/" aria-label="Return to the homepage of theCarlson School of Management at the University of Minnesota">{% endif %}
          {{ source('@carlson_refresh/../logo-footer.svg') }}
        {% if not is_front %}</a>{% endif %}
      </div>
    </div>
    <div class="row footer__content">
      <div class="col-12 pt-10">
        <div class="row">
          {% block footer %}
          {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth %}
          <div class="col-12 col-md-4 col-lg-3 footer__info mb-6 mb-md-0 {{ (page.footer_first|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_first }}
          </div>
          <div class="col-12 col-md-4 col-lg-3 footer__links mb-6 mb-md-0 {{ (page.footer_second|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_second }}
          </div>
          <div class="col-12 col-md-4 col-lg-3 footer__links mb-4 {{ (page.footer_third|render|striptags|trim is not empty) ? '' : 'd-none d-md-flex' }}">
            {{ page.footer_third }}
          </div>
          <div class="col-12 col-lg-3 footer__connect text-center text-lg-left mt-6 mt-lg-0">
            <p>CONNECT WITH MINNESOTA CARLSON</p>
            <ul>
              <li>
                <a href="https://www.facebook.com/CarlsonSchoolUMN" target="_blank">
                  <span class="sr-only">on Facebook</span>
                  {{ source('@carlson_refresh/../images/svg/social-facebook.svg') }}
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/school/carlsonschoolumn" target="_blank">
                  <span class="sr-only">on Linkedin</span>
                  {{ source('@carlson_refresh/../images/svg/social-linkedin.svg') }}
                </a>
              </li>
              {# <li>
                <a href="https://twitter.com/CarlsonNews" target="_blank">
                  <span class="sr-only">on Twitter</span>
                  {{ source('@carlson_refresh/../images/svg/social-twitter.svg') }}
                </a>
              </li> #}
              <li>
                <a href="https://www.instagram.com/carlsonschoolumn" target="_blank">
                  <span class="sr-only">on Instagram</span>
                  {{ source('@carlson_refresh/../images/svg/social-instagram.svg') }}
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/user/CarlsonSchoolUMN" target="_blank">
                  <span class="sr-only">on Youtube</span>
                  {{ source('@carlson_refresh/../images/svg/social-youtube.svg') }}
                </a>
              </li>
            </ul>
          </div>
        </div>
        {% endif %}
        {% endblock %}
      </div>
    </div>
  </div>
</div>
