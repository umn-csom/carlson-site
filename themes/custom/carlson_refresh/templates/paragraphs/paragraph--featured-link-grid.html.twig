{#
/**
 * @file
 * Template to display a featured link grid paragraph.
 */
#}
{%
  set classes = [
    'component-paragraph',
    'featured-link-grid',
    'row',
    'mx-n2',
  ]
%}
{% block paragraph %}
<div{{ attributes.addClass(classes) }}>
  {% block content %}
  {% for item in content.field_featured_links|filter((v, k) => k|first != '#') %}
    <div class="col-12 col-md-6 mb-4 d-flex px-2">
      {{ item }}
    </div>
  {% endfor %}
  {% endblock %}
</div>
{% endblock paragraph %}
