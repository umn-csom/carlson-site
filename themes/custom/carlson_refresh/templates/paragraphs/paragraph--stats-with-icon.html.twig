{% set position = paragraph.field_stats_with_icon_position.value %}

{% set classes = [
  'csom-stats',
  position == 'bottom' ? 'csom-stats-type-1' : '',
  position == 'right' ? 'csom-stats-type-2' : '',
] %}

<section class="narrow" data-description="Stats with icon">
  <div {{ create_attribute({class: classes|join(' ')}) }}>
    <div class="field-logo">
      {{ content.field_stats_with_icon_logo }}
    </div>
    <div class="info">
        <div class="field-title">{{ content.field_stats_with_icon_title }}</div>
        <div class="field-price">{{ content.field_stats_with_icon_value }}</div>
    </div>
  </div>
</section>
