{{ attach_library('carlson_refresh/component-paragraph') }}
{{ attach_library('carlson_refresh/state-map') }}

{% set percent = paragraph.field_state_stat_percent.value %}
<section class="component-paragraph component-paragraph--narrow">
  <div class="csom-state-map">
    <div class="csom-state-map__heading">
      {{ content.field_state_stat_heading }}
