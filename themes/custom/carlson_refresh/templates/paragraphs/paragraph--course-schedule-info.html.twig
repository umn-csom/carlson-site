{#
/**
 * @file
 * Paragraphs display for Executive Ed Course Schedule.
 */
#}
{% set has_legacy_1 = paragraph.field_schedule_part_1.value is not empty %}
{% set has_legacy_2 = paragraph.field_schedule_part_2.value is not empty %}
{% set has_desc_1 = paragraph.field_schedule_part_1_desc.value is not empty %}
{% set has_desc_2 = paragraph.field_schedule_part_2_desc.value is not empty %}
<div{{ attributes.addClass(classes) }}>
  {% if has_desc_1 %}
    {{ content.field_schedule_part_1_desc }}
  {% elseif has_legacy_1 %}
  <div class="container session">
    <div class="card session-card p-4 p-md-5">
      <div class="card-body">
        <div class="row">
          <div class="col-12 col-md-10">
            <div class="session-overview pl-0 pl-md-10">
              <h3 class="session-title">{{ content.field_schedule_part_1_title }}</h3>
              {{ content.field_schedule_part_1 }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {% if has_desc_2 %}
    {{ content.field_schedule_part_2_desc }}
  {% elseif has_legacy_2 %}
  <div class="container session">
    <div class="card session-card p-4 p-md-5">
      <div class="card-body">
        <div class="row">
          <div class="col-12 col-md-10">
            <div class="session-overview pl-0 pl-md-10">
              <h3 class="session-title">{{ content.field_schedule_part_2_title }}</h3>
              {{ content.field_schedule_part_2 }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}
</div>
