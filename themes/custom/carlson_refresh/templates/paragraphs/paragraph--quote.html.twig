{{ attach_library('carlson_refresh/quote') }}

{% set bg_color = content.field_background_color|render ? content.field_background_color[0]['#markup'] : 'bg-gold bg-default' %}
{% set color =  bg_color == 'bg-primary' ? 'text-white' : 'text-body' %}

{% block paragraph %}
  {% block content %}
    <div class="row no-gutters quote flex-grow-1 {{ paragraph.getParentEntity().type.target_id != 'quote_group' ? 'component-paragraph' }}">
      {% if content.field_quote_image|render %}
      <div class="col-12 col-lg-5 position-relative">
        <div class="quote__img embed-responsive embed-responsive-4by3 position-static">
          {% if content.field_quote_image|field_value is not empty %}
            {{ content.field_quote_image }}
          {% endif %}
        </div>
      </div>
      {% endif %}
      <div class="quote__content col-12 col-lg d-flex align-items-center {{ bg_color }} {{ color }} pr-lg-24 pt-10 pb-20 {{ content.field_quote_image|render ? 'ml-lg-n12 px-12' : 'px-lg-24 px-12' }}">
        <div>
          <div class="quote__text font-weight-light ff-serif fs-30 mb-5">
            <em>{{ content.field_quote_text|render|striptags }}</em>
          </div>
          {% if content.field_quote_source|field_value is not empty %}
            <div class="quote__source text-uppercase font-weight-semi-bold fs-base">
              &ndash; {{ content.field_quote_source|field_value }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endblock %}
{% endblock paragraph %}
