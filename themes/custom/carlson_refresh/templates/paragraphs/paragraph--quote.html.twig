#}
<section class="component-paragraph component-paragraph--{{ has_image ? 'medium' : 'narrow' }}">
  <blockquote class="{{ classes|join(' ') }}">
    {% if has_image %}
      {{ content.field_quote_image }}
    {% endif %}
    <p>{{ content.field_quote_text|render|striptags('<a><strong><em>')|raw }}</p>
    {% if has_citation %}
    <footer>
      {% if has_author %}
      <div class="blockquote__author">
        {{ content.field_quote_source }}
      </div>
      {% endif %}
      {% if has_org %}
      <div class="blockquote__organization">
        {{ content.field_quote_source2 }}
      </div>
      {% endif %}
      {% if content.field_link|render %}
        <div class="blockquote__link">{{ content.field_link }}</div>
      {% endif %}
    </footer>
    {% endif %}
  </blockquote>
</section>
