{{ attach_library('carlson_refresh/quote') }}

{% set has_mark = paragraph.field_quote_mark.value %}
{% set has_image = paragraph.field_quote_image.value is not empty %}
{% set has_author = paragraph.field_quote_source is not empty %}
{% set has_org = paragraph.field_quote_source2 is not empty %}
{% set has_citation = has_author or has_org %}
{# {% set is_quote_group = paragraph.getParentEntity().type.target_id == 'quote_group' %} #}
{% set bg_color = paragraph.field_background_color.value ?: 'bg-gold bg-default' %}
{# {% set color = bg_color == 'bg-primary' ? 'text-white' : bg_color == 'bg-light-blue' ? 'text-black' : 'text-body' %} #}
{% set text_align = paragraph.field_quote_align_text.value ?: 'left' %}
{% set style = paragraph.field_quote_style.value ?: 'notch-left' %}
{% set classes = [
    'colorblock' not in style ? 'blockquote',
    bg_color,
    'blockquote--text-' ~ text_align,
    'blockquote--' ~ style,
    has_mark ? 'blockquote--has-quote-mark',
  ]
%}

{#
<section class="{{ has_image ? 'medium' : 'narrow' }}">
  <div class="row no-gutters quote w-100 flex-grow-1 {{ not is_quote_group ? 'component-paragraph' }}">
    {% if has_image %}
    <div class="col-12 col-lg-5 position-relative">
