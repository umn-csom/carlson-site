{% block paragraph %}
    <li class="faculty-profile__selected-works">
        {% block content %}

            <div class="faculty-profile__selected-works--title">

            {% set title_exists = content.field_pub_title|field_value is not empty %}
            {% set url_exists = content.field_url_title|field_value is not empty %}
            {% set author_exists = content.field_pub_author|field_value is not empty %}
            {% set date_exists = content.field_pub_date_year|field_value is not empty %}
            {% set name_exists = content.field_pub_name|field_value is not empty %}
            {% set citation_exists = content.field_pub_citation|field_value is not empty %}
            {# author first #}
            {% if content.field_pub_format|render == 'author_first'%}
                {% if title_exists %}
                    {{ content.field_pub_author }}
                    {% if url_exists %}
                        <a href="{{ content.field_pub_url[0]['#url']|render }}" target="_blank">{{ content.field_pub_title|field_value }}</a>
                    {% else %}
                        {{ content.field_pub_title }}
                    {% endif %}

                    {% if date_exists %} ({{ content.field_pub_date_year }}). {% endif %}
                    {% if name_exists %} {{ content.field_pub_name }}{% if citation_exists %}:{% endif %} {% endif %}
                    {{ content.field_pub_citation }}
                {% endif %}
            {# title first #}
            {% else %}
                {% if title_exists %}
                    {% if url_exists %}
                        <a href="{{ content.field_pub_url[0]['#url']|render }}" target="_blank">{{ content.field_pub_title|field_value }}</a>{% if author_exists or date_exists or name_exists or citation_exists %},{% endif %} 
                    {% else %}
                        {{ content.field_pub_title|field_value }}{% if author_exists or date_exists or name_exists or citation_exists %},{% endif %} 
                    {% endif %}
                    {% if author_exists %}{{ content.field_pub_author }}{% if date_exists or name_exists or citation_exists %},{% endif %} {% endif %}
                    {% if date_exists %} ({{ content.field_pub_date_year }}){% if name_exists or citation_exists %},{% endif %} {% endif %}
                    {% if name_exists %} {{ content.field_pub_name }}{% if citation_exists %}:{% endif %} {% endif %}
                    {{ content.field_pub_citation }}
                {% endif %}
            {% endif %}
            </div>

            {% if content.field_pub_file|field_value is not empty %}
                <div class="faculty-profile__selected-works--file">
                    {{ content.field_pub_file|field_value }}
                </div>
            {% endif %}
        {% endblock %}
    </li>
{% endblock paragraph %}