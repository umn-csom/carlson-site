{{ attach_library('carlson_refresh/card') }}

{% set bg_color = content.field_background_color|render ? content.field_background_color[0]['#markup'] : 'bg-ivory' %}
{% set color =  bg_color == 'bg-primary' ? 'text-white' : 'text-body' %}
{% set arrow_color =  bg_color == 'bg-ivory' ? 'text-primary'  %}

{% block paragraph %}
  {% block content %}
    <div class="carlson-card flex-grow-1 d-flex flex-column">
      {% if content.field_image|render %}
        <a class="carlson-card__img embed-responsive embed-responsive-4by3" href="{{ content.field_link.0['#url'] }}">{{ content.field_image|field_value }}</a>
      {% endif %}
      <a class="carlson-card__content flex-grow-1 d-block px-6 py-6 mt-n5 text-decoration-none {{ bg_color}} {{ color }}" href="{{ content.field_link.0['#url'] }}">
        <div class="text-uppercase font-weight-semi-bold mb-4">{{ content.field_heading }}&nbsp;<span class="icon icon-arrow-right-3 {{ arrow_color }}"></span></div>
        {{ content.field_main_content }}
      </a>
    </div>
  {% endblock %}
{% endblock paragraph %}
