{{ attach_library('carlson_refresh/slide') }}

{% if content.field_slide_image|field_value is not empty %}
  {% set img = content.field_slide_image %}
{% else %}
  {% set img = NULL %}
{% endif %}

{% block paragraph %}
  {% block content %}
    <div class="slide">
      <div class="text-center">
        <div class="slide__img">
            {{ content.field_slide_image }}
        </div>
        <div class="slide__caption">
          {{ content.field_slide_caption }}
        </div>
      </div>
    </div>
  {% endblock %}
{% endblock paragraph %}
