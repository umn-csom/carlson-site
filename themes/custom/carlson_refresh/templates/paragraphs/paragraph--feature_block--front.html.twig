{% set content_data = {
  'image': content.field_image | field_value,
  'heading': content.field_heading,
  'markup': content.field_main_content,
  'link': content.field_link
} %}

{% block paragraph %}
  {% block content %}
    <section class="front--topfeature mb-5 mb-lg-0">

      <div class="container">
        <div class="row d-block d-lg-none">
          <div class="col-12">
            {{ content.field_image|field_value }}
          </div>
        </div>
        <div class="row justify-content-end front--topfeature--row">
          <div class="col-12 col-lg-6 col-xl-4 front--topfeature--row-content">
            <h1 class="my-4">
              {{ content.field_heading }}
            </h1>
            {{ content.field_main_content }}
            <p class="mb-0 mt-5 text-center"><a href="{{ content.field_link.0['#url'] }}" class="btn btn-lg btn-primary--yellow btn-primary--yellow-solid">{{ content.field_link.0['#title'] }}</a></p>
          </div>
          <div class="col-12 col-xl-1 d-none d-xl-block"></div>
        </div>
      </div>

      <div class="d-none d-lg-block front--topfeature--gradient"></div>
      <section class="front--topfeature--bgimg d-none d-lg-block">{{ content.field_image|field_value }}</section>

    </section>
  {% endblock %}
{% endblock paragraph %}
