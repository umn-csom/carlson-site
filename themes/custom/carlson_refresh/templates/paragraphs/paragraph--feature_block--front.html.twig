{{ attach_library('carlson_refresh/front-top-features') }}

{% set content_data = {
  'image': content.field_image | field_value,
  'heading': content.field_heading,
  'markup': content.field_main_content,
  'link': content.field_link
} %}

{%
  set content_position = paragraph.getParentEntity().field_front_top_position is not empty
  and paragraph.getParentEntity().field_front_top_position.value == 'left' ? "" : "justify-content-end"
%}

{%
  set overlay_position = paragraph.getParentEntity().field_front_top_position is not empty
  and paragraph.getParentEntity().field_front_top_position.value == 'left' ? "right" : ""
%}

{% block paragraph %}
  {% block content %}
    <section class="front-top-features position-relative d-flex flex-column flex-lg-row">
      <div class="front-top-features__image-overlay {{ overlay_position }} embed-responsive embed-responsive-21by9 h-100 w-100">
        {{ content.field_image }}
      </div>
      <div class="front-top-features__content container position-relative">
        <div class="row h-100 {{ content_position }}">
          <div class="col-12 col-lg-6 col-xl-5 bg-white-90 p-6 p-lg-12">
            <h1 class="mb-4">{{ content.field_heading }}</h1>
            <div class="mb-8">
              {{ content.field_main_content }}
            </div>
            <a href="{{ content.field_link.0['#url'] }}" class="btn btn-primary">{{ content.field_link.0['#title'] }}</a>
          </div>
        </div>
      </div>
    </section>
  {% endblock %}
{% endblock paragraph %}
