{#
/**
 * @file
 * Paragraph override for info paragraph; used in Executive Ed Program nodes.
 */
#}
{% set is_active = paragraph._referringItem.parent.name == 'field_course_audi' %}
{% set collapsed = is_active ? '' : 'collapsed' %}
{% set expanded = is_active ? 'true' : 'false' %}
{% set show = is_active ? 'show' : '' %}
{% set paragraph_parent = paragraph.getParentEntity() %}
{% set paragraph_id = paragraph.id() %}
{% set has_image = paragraph.field_background_image.entity is not empty %}
{% block paragraph %}
  <div{{attributes.addClass("card")}}>
  {% block content %}
    <div class="card-header">
      <span class="mb-0">
        <button id="heading-{{ paragraph_id }}" class="btn btn-link {{ collapsed }}" type="button" data-toggle="collapse" data-target="#collapse-{{ paragraph_id }}" aria-expanded="{{ expanded }}" aria-controls="collapse-{{ paragraph_id }}">
          {{ content.field_section_headline }}
        </button>
      </span>
    </div>
    <div id="collapse-{{ paragraph_id }}" class="collapse {{ show }} inner" aria-labelledby="heading-{{ paragraph_id }}" data-parent="#accordion-list-ee-course-info" role="region">
      <div class="card-body">
        {% if has_image %}
        <div class="row">
          <div class="col-md-6 col-lg-7">
            {{ content.field_info_section_content }}
          </div>
          <div class="col-md-6 col-lg-5 d-none d-md-block">
            {{ content.field_background_image }}
          </div>
        </div>
        {% else %}
        <div class="col-lg-7">
          {{ content|without('field_section_headline') }}
        </div>
        {% endif %}
      </div>
    </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
