{{ attach_library('carlson_refresh/jquery-match-height') }}

{% if content.field_image|field_value is not empty %}
  {% set img = content.field_image %}
{% else %}
  {% set img = NULL %}
{% endif %}

{% set has_link = has_link|default(false) %}
{% set link_url = link_url|default('') %}
{% set link_title = link_title|default('Learn More') %}
{% set is_external = is_external|default(false) %}
{% set overlay_attributes = overlay_attributes|default(create_attribute({'class': ['stretched-link']})) %}

{% block paragraph %}
  {% block content %}
    <div class="column__inner h-100{% if has_link %} stretched-link-container position-relative{% endif %}">
      {% if has_link %}
        <a href="{{ link_url }}"{{ overlay_attributes }}>
          <span class="sr-only">{{ link_title }}{% if is_external %} (opens in a new window){% endif %}</span>
        </a>
      {% endif %}

      {% if img|field_value is not empty %}
        <div class="column__img mb-3 d-block">
          {{ img|field_value }}
        </div>
      {% endif %}

      <div class="column__content flex-grow-1 d-flex flex-column">
        {% if content.field_heading|field_value  is not empty %}
          <h2 class="column__heading font-weight-normal d-flex align-items-start mb-2 h3" data-mh="columns-title-{{ paragraph.parent_id.value }}">{{ content.field_heading|field_value }}</h2>
        {% endif %}

        {% if content.field_main_content|field_value  is not empty %}
          <div class="column__markup" data-mh="columns-markup-{{ paragraph.parent_id.value }}">
            {{ content.field_main_content|field_value }}
          </div>
        {% endif %}

        {% if has_link %}
          <div class="column__link mt-6 text-center">
            <span class="btn btn-primary px-6 d-flex align-items-center justify-content-center stretched-link-ignore" data-mh="columns-btn-{{ paragraph.parent_id.value }}" aria-hidden="true">
              {{ link_title }}
              {% if is_external %}
                <svg class="external-link-icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.75" style="width:0.8em;height:0.8em;margin-left:0.2em;vertical-align:middle;">
                  <path d="M16 11L16 16.5L2.5 16.5L2.5 3.5L8 3.5 M9 9.5L17.5 1.5 M11.5 1.5L17.5 1.5L17.5 7.5"></path>
                </svg>
                <span class="external-link-text sr-only">(this link opens in a new browser window or tab)</span>
              {% endif %}
            </span>
          </div>
        {% endif %}
      </div>
    </div>


  {% endblock %}
{% endblock paragraph %}
