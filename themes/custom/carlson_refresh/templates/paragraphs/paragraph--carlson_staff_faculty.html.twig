{#
/**
 * @file
 * Paragraph display for Executive Ed Staff/Faculty
 */
#}

{% block paragraph %}
  {% block content %}
    <div class="row component-paragraph accordion-content staff-faculty">
      {% if content.field_staff_faculty_item is not empty %}
        {% set items = content.field_staff_faculty_item|field_value %}

        {% if content.field_main_content|field_value is not empty %}
          <div class="col-12 col-md-10 offset-md-1 staff-faculty__heading text-center">
            <h3 class="label-border yellow">{{ content.field_heading }}</h3>
            {{ content.field_main_content }}
          </div>
        {% endif %}

        {% if items.length > 1 %}
          <div class="accordion col-12" id="staff-faculty-list">
            {% set inc = 0 %}
            {% for item in items %}
              {% set paragraph = item['#paragraph'] %}
              {% if paragraph.field_heading.value is not empty %}
                {% set is_active = inc == 0 %}
                {% set collapsed = is_active ? '' : 'collapsed' %}
                {% set expanded = is_active ? 'true' : 'false' %}
                {% set show = is_active ? 'show' : '' %}
                <div class="card">
                  <div class="card-header">
                    <h5 class="mb-0">
                      <button class="btn btn-link {{ collapsed }}" type="button" data-toggle="collapse" data-target="#collapse{{ inc }}" aria-expanded="{{ expanded }}" aria-controls="collapse{{ inc }}">
                        {{ paragraph.field_heading.value }}
                      </button>
                    </h5>
                  </div>
                  <div id="collapse{{ inc }}" class="collapse {{ show }} inner" aria-labelledby="heading{{ inc }}" data-parent="#staff-faculty-list">
                    <div class="card-body">
                      <div class="row">
                        {{ item }}
                      </div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="card">
                  <div class="card-body">
                    <div class="row">
                      {{ item }}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% set inc = inc+1 %}
            {% endfor %}
          </div>
        {% else %}
          {% for item in items %}
            {{ item }}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>
  {% endblock %}
{% endblock paragraph %}
