{#
/**
 * @file
 * Paragraph display for Executive Ed Staff/Faculty
 */
#}

{% block paragraph %}
  {% block content %}
    {{ attach_library('carlson_refresh/accordion') }}
    {{ attach_library('carlson_refresh/staff-faculty') }}
    <div class="accordion__wrapper row component-paragraph staff-faculty">
      {% if paragraph.field_main_content.value is not empty %}
        <div class="col-12 col-md-10 offset-md-1 staff-faculty__heading text-center">
          <h2 class="h3 label-border yellow">{{ content.field_heading }}</h2>
          {{ content.field_main_content }}
        </div>
      {% endif %}

      {% if paragraph.field_staff_faculty_item.value is not empty %}
        {% set paragraphId = paragraph.id() %}
        {% set items = content.field_staff_faculty_item|filter((item, key) => key|first != '#') %}
        {% if items|length > 1 %}
          <div class="accordion col-12" id="staff-faculty-list-{{ paragraphId}}">
            {% for key, item in items %}
              {% set inc = loop.index0 %}
              {% set accordion_item = item['#paragraph'] %}
              {% if accordion_item.field_heading.value is not empty %}
                {% set is_active = inc == 0 %}
                {% set collapsed = is_active ? '' : 'collapsed' %}
                {% set expanded = is_active ? 'true' : 'false' %}
                {% set show = is_active ? 'show' : '' %}
                <div class="accordion-item accordion-item--edge-expand-mobile">
                  <button id="heading{{ inc }}"
                    class="accordion-button {{ collapsed }}"
                    type="button"
                    data-toggle="collapse"
                    data-target="#collapse{{ inc }}"
                    aria-expanded="{{ expanded }}"
                    aria-controls="collapse{{ inc }}">
                    {{ source('@carlson_refresh/../images/svg/plus.svg') }}
                    {{ source('@carlson_refresh/../images/svg/minus.svg') }}
                    {{ accordion_item.field_heading.value }}
                  </button>
                  <div id="collapse{{ inc }}"
                    class="accordion-content collapse {{ show }}"
                    aria-labelledby="heading{{ inc }}"
                    data-parent="#staff-faculty-list-{{ paragraphId }}"
                    role="region">
                    <div class="accordion-content-inner">
                      <div class="row justify-content-center">
                        {{ item }}
                      </div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="card">
                  <div class="card-body">
                    <div class="row justify-content-center">
                      {{ item }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          {% for item in items %}
            {{ item }}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>
  {% endblock %}
{% endblock paragraph %}
