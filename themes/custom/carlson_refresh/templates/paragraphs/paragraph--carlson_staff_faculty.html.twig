{#
/**
 * @file
 * Paragraph display for Executive Ed Staff/Faculty
 */
#}

{% block paragraph %}
  {% block content %}
    <div class="row component-paragraph accordion-content staff-faculty">
      {% if paragraph.field_main_content.value is not empty %}
        <div class="col-12 col-md-10 offset-md-1 staff-faculty__heading text-center">
          <h2 class="h3 label-border yellow">{{ content.field_heading }}</h2>
          {{ content.field_main_content }}
        </div>
      {% endif %}

      {% if paragraph.field_staff_faculty_item.value is not empty %}
        {% set items = content.field_staff_faculty_item|filter((item, key) => key|first != '#') %}
        {% if items|length > 1 %}
          <div class="accordion col-12" id="staff-faculty-list">
            {% for key, item in items %}
              {% set inc = loop.index0 %}
              {% set accordion_item = item['#paragraph'] %}
              {% if accordion_item.field_heading.value is not empty %}
                {% set is_active = inc == 0 %}
                {% set collapsed = is_active ? '' : 'collapsed' %}
                {% set expanded = is_active ? 'true' : 'false' %}
                {% set show = is_active ? 'show' : '' %}
                <div class="card">
                  <div class="card-header">
                    <span class="mb-0">
                      <button class="btn btn-link {{ collapsed }}" type="button" data-toggle="collapse" data-target="#collapse{{ inc }}" aria-expanded="{{ expanded }}" aria-controls="collapse{{ inc }}">
                        {{ accordion_item.field_heading.value }}
                      </button>
                    </span>
                  </div>
                  <div id="collapse{{ inc }}" class="collapse {{ show }} inner" aria-labelledby="heading{{ inc }}" data-parent="#staff-faculty-list">
                    <div class="card-body">
                      <div class="row">
                        {{ item }}
                      </div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="card">
                  <div class="card-body">
                    <div class="row">
                      {{ item }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          {% for item in items %}
            {{ item }}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>
  {% endblock %}
{% endblock paragraph %}
