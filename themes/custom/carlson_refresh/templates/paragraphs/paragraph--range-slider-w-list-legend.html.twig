
<div class="row component-paragraph basic-paragraph narrow" data-description="Range slider">
    <div class="csom-range-slider">
        <h2 class="h4">{{ content.field_heading_range }}</h2>
        <ul>
            <li>
                <span class="label sr-only">Range</span>
                <span class="sr-only">{{ content.field_range_bottom }} up to {{ content.field_range_top }}</span>
                <span class="value" aria-hidden="true">{{ content.field_range_bottom }}</span>
                <span class="value" aria-hidden="true">{{ content.field_range_top }}</span>
            </li>
            <li>
                <span class="label">Mean</span>
                <span class="value">{{ content.field_mean }}</span>
            </li>
            <li>
                <span class="label">Median</span>
                <span class="value">{{ content.field_median }}</span>
            </li>
        </ul>
    </div>

    {{ content.field_description_range }}
</div>