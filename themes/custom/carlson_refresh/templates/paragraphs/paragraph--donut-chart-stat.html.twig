<div class="narrow" data-description="Donut chart stat">
    <div class="csom-stat-donut csom-stat-donut--col bg-primary text-light">
        <h2 class="csom-stat-donut__title h4">{{ content.field_heading_donut }}</h2>
        <div class="csom-stat-donut__circle csom-stat-donut__circle--gold animate" style="--csom-stat-donut-percentage:{{ paragraph.field_range.value }};">
            <div class="csom-stat-donut__text-wrapper">
                <div class="csom-stat-donut__text csom-stat-donut__text--36">{{ content.field_range }}</div>
                <div class="csom-stat-donut__text csom-stat-donut__text--15">{{ content.field_range_text }}</div>
            </div>
        </div>
        <div class="csom-stat-donut__description">{{ content.field_description_donut_chart }}</div>
    </div>
    {{ content.field_dark_background }} 
    {{ content.field_position_description }}
    
   
</div>