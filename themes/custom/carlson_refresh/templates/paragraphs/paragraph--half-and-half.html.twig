<div class="container-fluid container-xl component-paragraph half-and-half px-0">
    <div class="row">
        {% if content.field_left_content.0['#paragraph'].field_main_content.0.value %}
            <div class="col-12 col-md-6 order-2 order-md-1">
        {% else %}
            <div class="col-12 col-md-6 order-1">
        {% endif %}
            <div class="left mb-6 mb-xl-0">
                {{ content.field_left_content }}
            </div>
        </div>
        {% if content.field_right_content.0['#paragraph'].field_main_content.0.value %}
            <div class="col-md-6 order-2">
        {% else %}
            <div class="col-md-6 order-1 order-md-2">
        {% endif %}
            <div class="right mb-6 mb-xl-0">
                {{ content.field_right_content }}
            </div>
        </div>
    </div>
</div>
