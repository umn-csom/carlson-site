<div class="image-with-offset-back pb-6">
  <div class="embed-responsive embed-responsive-11by7 overflow-initial">
    {{ content.field_front_image }}
    {% if content.field_hex_color|render %}
      <div class="background embed-responsive-item" style="background-color: {{ content.field_hex_color.0 }}"></div>
    {% else %}
      <div class="background embed-responsive-item bg-ivory d-flex"><div class="flex-grow-1"></div><div class="bg-gold"><div class="background__inner bg-light-blue px-6 h-100"></div></div></div>
    {% endif %}
  </div>
</div>
