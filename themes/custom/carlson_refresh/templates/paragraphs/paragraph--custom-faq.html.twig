{%
  set classes = [
    'component-paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}

{{ attach_library('carlson_refresh/accordion') }}
{{ attach_library('carlson_refresh/faq') }}

{% block paragraph %}
  {% block content %}
  <div class="accordion col-12" id="accordion-list-{{ paragraph.id() }}">
      {% set collapsed = 'collapsed' %}
      {% set expanded = 'false' %}
      {% set show = '' %}
      <div class="accordion-item accordion-item--edge-expand-mobile">
        <button id="faq-heading-{{ paragraph.id() }}"
          class="accordion-button {{ collapsed }}"
          type="button"
          data-toggle="collapse"
          data-target="#collapse{{ paragraph.id() }}"
          aria-expanded="{{ expanded }}"
          aria-controls="collapse{{ paragraph.id() }}">
          {{ source('@carlson_refresh/../images/svg/plus.svg') }}
          {{ source('@carlson_refresh/../images/svg/minus.svg') }}
          {{ content.field_question }}
        </button>
        <div id="collapse{{ paragraph.id() }}"
          class="accordion-content collapse {{ show }}"
          aria-labelledby="faq-heading-{{ paragraph.id() }}"
          data-parent="#accordion-list-{{ paragraph.id() }}"
          role="region">
          <div class="accordion-content-inner">
            {{ content.field_answer }}
          </div>
        </div>
      </div>
  </div>
  {% endblock %}
{% endblock paragraph %}
