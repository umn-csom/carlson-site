{{ attach_library('carlson_refresh/front-statistics') }}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
    {% block content %}
      <div class="row justify-content-center mb-6">

        <div class="col-12 col-md-9 col-lg-8 col-xl-7 text-center">
          {% if content.field_heading|field_value is not empty %}
            <h2 class="text-white mb-2">{{ content.field_heading }}</h2>
          {% endif %}

          {% if content.field_main_content|field_value is not empty %}
            <div class="text-white">{{ content.field_main_content }}</div>
          {% endif %}
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-12">
          {{ drupal_view('front_stats', 'block_1') }}
        </div>
      </div>
    {% endblock %}
{% endblock paragraph %}
