{#
/**
 * @file
 * Theme template for custom "CTA block" type links (paragraph bundle)
 */
#}
{{ attach_library('carlson_refresh/cta-link') }}
{% block paragraph %}
  {% block content %}
    {% set icon = paragraph.field_cta_icon.value|clean_class %}
    {% set url = content.field_link.0['#url'].toString() %}
    {% set has_link = url is not empty %}
  <div class="cta-link__wrapper col col-lg-12 d-flex">
    {%
      set classes = [
        'btn',
        'btn-primary',
        'cta-link',
        'cta-link--' ~ icon,
        'text-lg-left',
      ]
    %}
    {% if has_link %}
      {% if '1' in content.field_show_in_modal[0] %}
        {{ attach_library('carlson_refresh/ui-dialog') }}
        <a class="{{ classes|join(' ') }} use-ajax" data-dialog-type="modal" href="{{ url }}" data-dialog-options="{&quot;width&quot;:600}">
      {% else %}
        <a class="{{ classes|join(' ') }}" href="{{ url }}">
      {% endif %}
    {% else %}
      <div class="{{ classes|join(' ') }}">
    {% endif %}
        <div class="cta-link__icon d-lg-none">
          {# <span class="icon {{ icon }}"></span> #}
          {{ source('@carlson_refresh/../images/cta-link/' ~ icon ~ '.svg') }}
        </div>
        <div class="cta-link__anchor">
          {{ content.field_link.0['#title'] }}
        </div>
    {% if has_link %}
      </a>
    {% else %}
      </div>
    {% endif %}
  </div>
  {% endblock %}
{% endblock paragraph %}
