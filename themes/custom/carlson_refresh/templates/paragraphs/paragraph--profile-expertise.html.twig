{% block paragraph %}
    <li class="faculty-profile__expertise--item">
        {% block content %}
        <div class="faculty-profile__expertise--item--desc">
            {% if content.field_expertise_url[0]['#url'] is not empty %}
                <a href="{{ content.field_expertise_url[0]['#url'] }}">
                    {{ content.field_expertise_description|field_value }}
                </a>
            {% else %}
                {{ content.field_expertise_description|field_value }}
            {% endif %}
        </div>
        {% endblock %}
    </li>
{% endblock paragraph %}