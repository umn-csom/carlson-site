{#
/**
 * @file
 * Template to display a video with text below.
 */
#}
{{ attach_library('carlson_refresh/component-paragraph') }}
{{ attach_library('carlson_refresh/videos') }}
{{ attach_library('carlson_refresh/ui-dialog') }}

{% set id = paragraph.field_video_anchor_id.value %}
{% set label = paragraph.field_heading.value %}

{% block paragraph %}
  {% block content %}
    {% if id is not empty %}
      <a id="{{ id }}"></a>
    {% endif %}
    <div class="row no-gutters component-paragraph video video--textbelow my-0 justify-content-center">
      <div class="col-12 video__media position-relative border-top border-left border-right">
        <div class="video__image embed-responsive embed-responsive-16by9 position-static">
          <a
            class="use-ajax video__link video__link--below"
            href="/media/{{ content.field_video_embed.0 }}"
            data-dialog-type="modal"
            data-dialog-options="{&quot;width&quot;:800}"
            aria-label="Play video {{ label }}">
            {{ content.field_video_thumb|field_value }}
            {{ source('@carlson_refresh/../images/svg/play-encircled.svg') }}
          </a>
        </div>
      </div>
      {% if content.field_video_caption|render|striptags|trim or content.field_heading|render|striptags|trim %}
      <div class="col-12 video__details p-6 bg-gold">
        <h2 class="text-center video__heading fs-24 font-weight-semi-bold text-uppercase mb-4 ff-sans-serif">{{ content.field_heading }}</h2>
          <div class="text-center video__caption">{{ content.field_video_caption }}</div>
      </div>
      {% endif %}
    </div>
  {% endblock %}
{% endblock paragraph %}
