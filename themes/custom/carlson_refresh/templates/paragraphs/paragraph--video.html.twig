{#
/**
 * @file
 * Template to display a full-width video with caption below.
 */
#}
{{ attach_library('carlson_refresh/component-paragraph') }}
{{ attach_library('carlson_refresh/videos') }}
{{ attach_library('carlson_refresh/ui-dialog') }}

{% set id = paragraph.field_video_anchor_id.value %}
{% set label = paragraph.field_heading.value %}

{% block paragraph %}
  {% block content %}
    {% if id is not empty %}
      <a id="{{ id }}"></a>
    {% endif %}
    {% if content.field_video_embed|field_value is empty %}
      <div class="row component-paragraph video--fullwidth no-video">
        <div class="col-12 video__media">
          <div class="video__image embed-responsive embed-responsive-16by9">
            {{ content.field_video_thumb|field_value }}
          </div>
          <div class="video__caption">{{ content.field_video_caption }}</div>
        </div>
      </div>
    {% else %}
      <div class="row component-paragraph video--fullwidth">
        <div class="col-12">
          <div class="video__image embed-responsive embed-responsive-16by9">
            <a
              class="use-ajax video__link"
              href="/media/{{ content.field_video_embed.0 }}"
              data-dialog-type="modal"
              data-dialog-options="{&quot;width&quot;:800}">
              {{ content.field_video_thumb|field_value }}
              {{ source('@carlson_refresh/../images/svg/play-encircled.svg') }}
            </a>
          </div>
          <div class="video__caption">{{ content.field_video_caption }}</div>
        </div>
      </div>
    {% endif %}
  {% endblock %}
{% endblock paragraph %}
