{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
    'component-paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
    {% block content %}
    {% set custom_id = paragraph.field_custom_id.value ? paragraph.field_custom_id.value|clean_id : '' %}
    <div{% if custom_id %} id="{{ custom_id }}"{% endif %} class="row component-paragraph accordion-content">
      {% if content.field_tab_accordion_item is not empty %}
        {% set items = content.field_tab_accordion_item|field_value %}
        {% set paragraphId = paragraph.id() %}

        {% if (content.field_heading|field_value is not empty) or (content.field_main_content|field_value is not empty) %}
        <div class="col-12 accordion-content__heading">
          <h2 class="h3 label-border yellow">{{ content.field_heading }}</h2>
          {{ content.field_main_content }}
        </div>
        {% endif %}

        <div class="accordion col-12" id="accordion-list-{{paragraphId}}">
          {% set inc = 0 %}
          {% for item in items %}
              {% set paragraph = item['#paragraph'] %}
              <div class="card">
                  <div class="card-header">
                      <span class="mb-0">

                          {% set collapsed = 'collapsed' %}
                          {% set expanded = 'false' %}
                          {% set show = '' %}

                          <button id="heading{{paragraphId}}-{{ inc }}" class="btn btn-link {{ collapsed }}" type="button" data-toggle="collapse" data-target="#collapse{{paragraphId}}-{{ inc }}" aria-expanded="{{ expanded }}" aria-controls="collapse{{paragraphId}}-{{ inc }}">
                              {{ paragraph.field_heading.0.value }}
                          </button>
                      </span>
                  </div>
                  <div id="collapse{{paragraphId}}-{{ inc }}" class="collapse {{ show }} inner" aria-labelledby="heading{{paragraphId}}-{{ inc }}" data-parent="#accordion-list-{{paragraphId}}">
                      <div class="card-body">
                            {% set body = {
                            '#type': 'processed_text',
                            '#text': paragraph.field_main_content.0.value,
                            '#format': paragraph.field_main_content.0.format
                            } %}
                          {{ body }}

                          {# subaccordion #}
                          {% if paragraph.field_tab_accordion_subitem is not empty %}
                          <div class="row component-paragraph accordion-content">
                            {% set subitems = paragraph.field_tab_accordion_subitem %}

                            <div class="accordion sub-accordion col-12" id="accordion-list-{{paragraphId}}-{{ inc }}">
                              {% set subinc = 0 %}
                              {% for subitem in subitems %}
                                  {% set subparagraph = subitem.entity %}
                                  <div class="card">
                                      <div class="card-header">
                                          <span class="mb-0">

                                              {% set collapsed = 'collapsed' %}
                                              {% set expanded = 'false' %}
                                              {% set show = '' %}

                                              <button id="heading{{paragraphId}}-{{ inc }}-{{ subinc }}" class="btn btn-link {{ collapsed }}" type="button" data-toggle="collapse" data-target="#collapse{{paragraphId}}-{{ inc }}-{{ subinc }}" aria-expanded="{{ expanded }}" aria-controls="collapse{{paragraphId}}-{{ inc }}-{{ subinc }}">
                                                  {{ subparagraph.field_heading.0.value }}
                                              </button>
                                          </span>
                                      </div>
                                      <div id="collapse{{paragraphId}}-{{ inc }}-{{ subinc }}" class="collapse {{ show }} inner" aria-labelledby="heading{{paragraphId}}-{{ inc }}-{{ subinc }}" data-parent="#accordion-list-{{paragraphId}}-{{ inc }}">
                                          <div class="card-body">
                                                {% set body = {
                                                '#type': 'processed_text',
                                                '#text': subparagraph.field_main_content.0.value,
                                                '#format': subparagraph.field_main_content.0.format
                                                } %}
                                              {{ body }}
                                          </div>
                                      </div>
                                  </div>
                                  {% set subinc = subinc+1 %}
                              {% endfor %}
                            </div>
                          </div>
                          {% endif %}
                          {#  end subaccordion #}

                      </div>
                  </div>
              </div>
              {% set inc = inc+1 %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% endblock %}
{% endblock paragraph %}
