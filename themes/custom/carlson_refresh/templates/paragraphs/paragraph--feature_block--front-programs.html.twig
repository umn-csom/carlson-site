{{ attach_library('carlson_refresh/programs') }}

{% set bg_color = content.field_background_color|render ? content.field_background_color[0]['#markup'] : 'bg-primary' %}
{% set color = bg_color == 'bg-primary' ? 'text-white' : bg_color == 'bg-light-blue' ? 'text-black' : 'text-body' %}

{% block paragraph %}
  {% block content %}
        <div class="col-12 col-sm-6 col-md-6 col-lg-6 col-xl-3 mb-5 mb-xl-0">
          <div class="programs__item">
            <a class="embed-responsive embed-responsive-4by3" href="{{ content.field_link.0['#url'] }}">{{ content.field_image|field_value }}</a>
            <a class="programs__item__link d-block px-3 py-5 text-uppercase font-weight-semi-bold mt-n5 fs-22 {{ bg_color}} {{ color }}" href="{{ content.field_link.0['#url'] }}">{{ content.field_heading }}&nbsp;{{ source(directory ~ '/images/svg/arrow-right-cta.svg')}}</a>
          </div>
        </div>
  {% endblock %}
{% endblock paragraph %}
