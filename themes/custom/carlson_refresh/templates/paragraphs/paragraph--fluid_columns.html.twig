{{ attach_library('carlson_refresh/fluid-columns') }}
{% block paragraph %}
{% set paragraph_parent = paragraph.getParentEntity() %}
    {% block content %}
      <div class="row mb-8 mb-lg-12 fluid-columns {{ paragraph_parent.field_hex_color.0.value is defined ? 'gray-bg' : '' }}">
		{% if content.field_column_item is not empty %}
			{% set data = content.field_column_item|field_value %}
			{% set len = data|length %}
			{% set divide = 12/len %}

			{% for key,value in data %}
			<div class="col-12 col-md-6 col-lg-{{ divide }} fluid-columns__item">
				{{ data[key] }}
			</div>
			{% endfor %}
		{% endif %}
		</div>
    {% endblock %}
{% endblock paragraph %}
