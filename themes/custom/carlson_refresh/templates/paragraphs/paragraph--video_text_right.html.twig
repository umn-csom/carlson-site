{#
/**
 * @file
 * Template to display a video with text right.
 */
#}
{{ attach_library('carlson_refresh/component-paragraph') }}
{{ attach_library('carlson_refresh/videos') }}
{{ attach_library('carlson_refresh/ui-dialog') }}


{% set id = paragraph.field_video_anchor_id.value %}
{% set label = paragraph.field_heading.value %}

{% block paragraph %}
  {% block content %}
    {% if id is not empty %}
      <a id="{{ id }}"></a>
    {% endif %}
    <div class="row no-gutters component-paragraph video video--textright bg-gold my-0">
      <div class="col-12 col-lg-7 video__media position-relative">
        <div class="video__image embed-responsive embed-responsive-16by9 position-static">
          <a
            class="use-ajax video__link video__link--below"
            href="/media/{{ content.field_video_embed.0 }}"
            data-dialog-type="modal"
            data-dialog-options="{&quot;width&quot;:800}"
            aria-label="Play video {{ label }}">
              {{ content.field_video_thumb|field_value }}
              {{ source('@carlson_refresh/../images/svg/play-encircled.svg') }}
          </a>
         </div>
      </div>

      <div class="col-12 col-lg-5 video__details text-center p-6 d-flex align-items-center">
        <div class="flex-grow-1">
          <h2 class="video__heading text-center fs-24 font-weight-semi-bold text-capitalize mb-4 ff-sans-serif">{{ content.field_heading }}</h2>
          <div class="video__caption text-center">{{ content.field_video_caption }}</div>
        </div>
      </div>

    </div>
  {% endblock %}
{% endblock paragraph %}
