{#
/**
 * @file
 * Theme override to display front_blocks top_feature rows.
 */
#}
{% for row in rows %}
  {% if 'front-blocks-item--inactive' not in row.attributes.class %}
    <div{{ row.attributes.addClass(default_row_class ? 'views-row') }}>
      {{ row.content }}
    </div>
  {% endif %}
{% endfor %}
