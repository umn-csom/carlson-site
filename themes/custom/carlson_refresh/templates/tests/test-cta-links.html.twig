  <section class="mb-5">
    <h2>Modal Dialog</h2>

    <div class="row no-gutters">
      <div class="col-6 col-md-4 cta-link__wrapper">
        <a class="btn btn-primary cta-link cta-link--icon-apply use-ajax" data-dialog-type="modal" href="/styleguide/cta-links-modal" data-dialog-options="{&quot;width&quot;:600}">
          <div class="cta-link__icon">
            {{ source('@carlson_refresh/../images/cta-link/icon-apply.svg') }}
          </div>
          <div class="cta-link__anchor">
            Modal link w/ inline SVG
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 cta-link__wrapper">
        <a class="btn btn-primary cta-link cta-link--icon-apply use-ajax" data-dialog-type="modal" href="/styleguide/cta-links-modal" data-dialog-options="{&quot;width&quot;:600}">
          <div class="cta-link__icon">
            {{ source('@carlson_refresh/../images/cta-link/icon-apply.svg') }}
          </div>
          <div class="cta-link__anchor">
            Ajax throbber active
          </div>
        </a>
        <div class="ajax-progress ajax-progress-throbber"><div class="throbber">&nbsp;</div></div>
      </div>
    </div>
  </section>

  <section class="mb-5">
    <div class="row no-gutters">
      <div class="col-10 mb-3 col-md-6 col-lg-4 mb-md-0 mt-md-3 mt-lg-0 cta-link__wrapper">
        <a
          href="https://choose.umn.edu/apply/"
          class="btn btn-lg cta-link"
          target="_blank">
          <div class="cta-link__anchor">
            Ready to get started?<br>
            Apply now
          </div>
        </a>
      </div>

      <div class="col-10 mb-3 col-md-6 col-lg-4 mb-md-0 cta-link__wrapper">
        {{ attach_library('carlson_refresh/ui-dialog') }}
        <a
          class="btn btn-lg cta-link use-ajax"
          href="/lp/summer-rush-ptmba"
          data-dialog-type="modal"
          data-dialog-options="{&quot;width&quot;:600}">
          <div class="cta-link__anchor">
            Get more info about<br>
            Part-time MBA
          </div>
        </a>
      </div>

      <div class="col-10 mb-3 col-md-6 col-lg-4 mb-md-0 cta-link__wrapper">
        <a
          class="cta-link use-ajax"
          href="/lp/summer-rush-ptmba"
          data-dialog-type="modal"
          data-dialog-options="{&quot;width&quot;:600}">
          <div class="cta-link__icon">
            {{ source('@carlson_refresh/../images/cta-link/icon-request-circle.svg') }}
          </div>
          <div class="cta-link__anchor">
            Request Information
          </div>
        </a>
      </div>
    </div>
  </section>
</div>
