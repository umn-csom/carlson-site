{#
/**
 * @file
 * Theme override for the typography styleguide page.
 */
#}
<div class="container py-5">
  <section class="mb-5">
    <h2 class="mb-4">Headings</h2>
    <div class="card p-4 mb-4">
      <h1>H1 Heading - {{ '5rem'|t }}</h1>
      <h2>H2 Heading - {{ '4.2rem'|t }}</h2>
      <h3>H3 Heading - {{ '3.4rem'|t }}</h3>
      <h4>H4 Heading - {{ '2.5rem'|t }}</h4>
      <h5>H5 Heading - {{ '2rem'|t }}</h5>
      <h6>H6 Heading - {{ '1.6rem'|t }}</h6>
    </div>

    <div class="card p-4">
      <p class="h1">Paragraph with .h1 class</p>
      <p class="h2">Paragraph with .h2 class</p>
      <p class="h3">Paragraph with .h3 class</p>
      <p class="h4">Paragraph with .h4 class</p>
      <p class="h5">Paragraph with .h5 class</p>
      <p class="h6">Paragraph with .h6 class</p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Headings with links</h2>
    <div class="card p-4 mb-4">
      <p class="h1"><a href="#">H1 Heading with link</a></p>
      <p class="h2"><a href="#">H2 Heading with link</a></p>
      <p class="h3"><a href="#">H3 Heading with link</a></p>
      <p class="h4"><a href="#">H4 Heading with link</a></p>
      <p class="h5"><a href="#">H5 Heading with link</a></p>
      <p class="h6"><a href="#">H6 Heading with link</a></p>
      <p><a href="#">Paragraph with link</a></p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Font Families</h2>
    <div class="card p-4 mb-4">
      <p class="ff-sans-serif mb-3">Sans-serif font family (Open Sans): <code>ff-sans-serif</code></p>
      <p class="ff-serif mb-3">Serif font family (Newsreader): <code>ff-serif</code></p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Font Sizes</h2>
    <div class="card p-4 mb-4">
      <p class="fs-18 mb-3">Font size 18px: <code>fs-18</code></p>
      <p class="fs-20 mb-3">Font size 20px: <code>fs-20</code></p>
      <p class="fs-22 mb-3">Font size 22px: <code>fs-22</code></p>
      <p class="fs-24 mb-3">Font size 24px: <code>fs-24</code></p>
      <p class="fs-32 mb-3">Font size 32px: <code>fs-32</code></p>
      <p class="fs-30 mb-3">Font size 30px: <code>fs-30</code></p>
      <p class="fs-40 mb-3">Font size 40px: <code>fs-40</code></p>
      <p class="fs-64 mb-3">Font size 64px: <code>fs-64</code></p>
      <p class="fs-base mb-3">Font size base: <code>fs-base</code></p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Font Weights</h2>
    <div class="card p-4 mb-4">
      <p class="font-weight-light mb-3">Font weight light (300): <code>font-weight-light</code></p>
      <p class="font-weight-normal mb-3">Font weight normal (400): <code>font-weight-normal</code></p>
      <p class="font-weight-medium mb-3">Font weight medium (500): <code>font-weight-medium</code></p>
      <p class="font-weight-semi-bold mb-3">Font weight semi-bold (600): <code>font-weight-semi-bold</code></p>
      <p class="font-weight-bold mb-3">Font weight bold (700): <code>font-weight-bold</code></p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Line Heights and Letter Spacing</h2>
    <div class="card p-4 mb-4">
      <p class="lh-1 mb-4">Line height 1: <code>lh-1</code> - This is sample text to demonstrate line height 1. This is sample text to demonstrate line height 1.</p>
      <p class="lh-13 mb-4">Line height 1.3: <code>lh-13</code> - This is sample text to demonstrate line height 1.3. This is sample text to demonstrate line height 1.3.</p>
      <p class="letter-spacing-1 mb-4">Letter spacing 0.1em: <code>letter-spacing-1</code></p>
      <p class="letter-spacing-05 mb-4">Letter spacing 0.05em: <code>letter-spacing-05</code></p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Text Styling</h2>
    <div class="card p-4 mb-4">
      <p class="mb-3">Regular paragraph text. The base font size is 1.6rem (16px). This is a paragraph with normal styling to demonstrate how text appears on the site.</p>
      <p class="mb-3"><strong>Bold text</strong> using the strong tag.</p>
      <p class="mb-3"><em>Italic text</em> using the em tag.</p>
      <p class="mb-3"><u>Underlined text</u> using the u tag.</p>
      <p class="mb-3"><code>Code text</code> using the code tag.</p>
      <p class="mb-3"><mark>Highlighted text</mark> using the mark tag.</p>
      <p class="mb-3">Superscript: x<sup>2</sup> using the sup tag.</p>
      <p class="mb-3">Subscript: H<sub>2</sub>O using the sub tag.</p>
      <p class="mb-3"><small>Small text</small> using the small tag.</p>
      <p class="mb-3">
        <span class="ff-sans-serif">Sans-serif font family (Open Sans): <code>ff-sans-serif</code></span>
        <span class="ff-serif">Serif font family (Newsreader): <code>ff-serif</code></span>
      </p>
      <p class="mb-3"><span class="text-uppercase">Uppercase text:</span> <code>text-uppercase</code></p>
      <p class="mb-3"><span class="text-lowercase">Lowercase text:</span> <code>text-lowercase</code></p>
      <p class="mb-3"><span class="text-capitalize">Capitalize text:</span> <code>text-capitalize</code></p>
      <p class="text-underline mb-3">Text with underline class: <code>text-underline</code></p>
      <p class="text-underline-hover mb-3">Text with underline on hover: <code>text-underline-hover</code> (hover to see effect)</p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Theme Colors</h2>
    <div class="card p-4 mb-4">
      <div class="row">
        <div class="col-md-3 mb-3">
          <div class="p-3 bg-primary text-white">Primary (Maroon)</div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="p-3 bg-secondary text-dark">Secondary (Gold)</div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="p-3" style="background-color: #f5f5f5; color: #363230;">Light Gray</div>
        </div>
        <div class="col-md-3 mb-3">
          <div class="p-3" style="background-color: #363230; color: white;">Slate</div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Links</h2>
    <div class="card p-4 mb-4">
      <p class="mb-3"><a href="#">Default link style</a> - Links are maroon with font-weight 600.</p>
      <p class="mb-3"><a href="#" class="text-underline">Link with underline class</a></p>
      <p class="mb-3"><a href="#" class="text-underline-hover">Link with underline on hover</a> (hover to see effect)</p>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Lists</h2>
    <div class="card p-4 mb-4">
      <h3 class="h4">Unordered List</h3>
      <ul>
        <li>First list item</li>
        <li>Second list item with longer text to demonstrate wrapping and spacing between list items</li>
        <li>Third list item
          <ul>
            <li>Nested list item 1</li>
            <li>Nested list item 2</li>
          </ul>
        </li>
        <li>Fourth list item</li>
      </ul>

      <h3 class="h4 mt-4">Ordered List</h3>
      <ol>
        <li>First list item</li>
        <li>Second list item with longer text to demonstrate wrapping and spacing between list items</li>
        <li>Third list item
          <ol>
            <li>Nested list item 1</li>
            <li>Nested list item 2</li>
          </ol>
        </li>
        <li>Fourth list item</li>
      </ol>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-4">Blockquotes</h2>
    <div class="card p-4 mb-4">
      <blockquote class="blockquote">
        <p>This is a blockquote to demonstrate how quoted content appears. The Carlson School of Management is America's leading business school for developing ethical, innovative and principled leaders of organizations and society.</p>
        <footer class="blockquote-footer">Blockquote footer with <cite title="Source Title">source title</cite></footer>
      </blockquote>
    </div>
  </section>
</div>
