{{ attach_library('carlson_refresh/folwell_emergency_banner') }}


<aside
  class="emergency-campaign-sticky-bar campaign-sticky-bar campaign-sticky-bar--top campaign-sticky-bar--{{ content.field_campaign_color_scheme }}"
  role="region"
  aria-label="{{ 'Campaign announcement'|t }}"
  aria-hidden="false"
>
  <div class="campaign-sticky-bar__inner">
    <div class="campaign-sticky-bar__text">{{ content|without('field_campaign_color_scheme') }}</div>
  </div>
  <button type="button" class="emergency-campaign-sticky-bar__close campaign-sticky-bar__close" aria-label="{{ 'Dismiss sticky campaign'|t }}">
    <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
      <circle cx="10" cy="10" r="9.5"/>
      <path d="M6 6L14 14M6 14L14 6"/>
    </svg>
  </button>
</aside>
