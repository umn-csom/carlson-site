{# extends @bootstrap_barrio/layout/block.html.twig
/**
 * @file
 * Theme override for tabs.
 */
#}
{% block content %}
  {% if content %}
    <nav class="tab my-3" role="navigation" aria-label="{{ 'Tabs'|t }}">
      <div class="container-fluid container-xl">
        {{ content }}
      </div>
    </nav>
  {% endif %}
{% endblock %}
