{#
/**
 * @file
 * Bootstrap Barrio's theme implementation for a branding block.
 *
 * Each branding element variable (logo, name, slogan) is only available if
 * enabled in the block configuration.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}
{% if site_logo or site_name %}
  {{ attach_library('carlson_refresh/site-branding') }}
  {% if not is_front %}<a href="{{ path('<front>') }}" aria-label="Go to the Carlson School homepage" title="Home" rel="home" class="site-branding">
  {% else %}
    <span class="site-branding">
  {% endif %}
    {% if site_logo %}
      {{ source('@carlson_refresh/images/svg/site-branding__logo-mn-carlson--desktop.svg') }}
    {% elseif site_name %}
      {{ site_name }}
    {% endif %}
  {% if not is_front %}</a>{% else %}</span>{% endif %}
{% endif %}
{% if site_slogan %}
  {{ attach_library('carlson_refresh/site-name-slogan') }}
  <div class="d-inline-block align-top site-name-slogan">
    {{ site_slogan }}
  </div>
{% endif %}
