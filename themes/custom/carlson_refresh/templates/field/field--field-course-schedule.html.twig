{#
/**
 * @file
 * Theme override for the Executive Ed Course Schedule.
 */
#}

{{ attach_library('carlson_refresh/component-paragraph') }}

<!-- Accordion for Mobile -->
{{ attach_library('carlson_refresh/accordion') }}
<div class="accordion d-block d-lg-none mb-0">
  <div class="row component-paragraph">
    {% if items is not empty %}

      <div class="accordion col-12" id="accordion-list-course-schedule">
        {% set inc = 0 %}
        {% for item in items %}
          {% set paragraph = item.content['#paragraph'] %}
          {% set paragraphId = paragraph.id() %}
          {% set is_active = inc == 0 %}
          {% set collapsed = is_active ? '' : 'collapsed' %}
          {% set expanded = is_active ? 'true' : 'false' %}
          {% set show = is_active ? 'show' : '' %}
          <div class="accordion-item accordion-item--edge-expand-mobile">
            <button id="heading-{{ paragraphId }}-{{ inc }}"
              class="accordion-button {{ collapsed }}"
              type="button"
              data-toggle="collapse"
              data-target="#collapse-{{ paragraphId }}-{{ inc }}"
              aria-expanded="{{ expanded }}"
              aria-controls="collapse-{{ paragraphId }}-{{ inc }}">
              {{ source('@carlson_refresh/../images/svg/plus.svg') }}
              {{ source('@carlson_refresh/../images/svg/minus.svg') }}
              {{ paragraph.field_day_title.value }}
            </button>
            <div id="collapse-{{ paragraphId }}-{{ inc }}"
              class="accordion-content collapse {{ show }}"
              aria-labelledby="heading-{{ paragraphId }}-{{ inc }}"
              data-parent="#accordion-list-course-schedule"
              role="region">
              <div class="accordion-content-inner">
                {{ item.content }}
              </div>
            </div>
          </div>
          {% set inc = inc + 1 %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<!-- Tabs for Desktop -->
{{ attach_library('carlson_refresh/tabbed-content') }}
<div class="tabbed-content d-none d-lg-block mb-0">

  <div class="tabbed-content__nav--container">
    <div class="tabbed-content__nav--positioner">
      {{ attach_library('carlson_refresh/tabs') }}
      <ul class="tabbed-content__nav nav nav-tabs" role="tablist">
        {% set inc = 0 %}
        {% for item in items %}
          {% set paragraph = item.content['#paragraph'] %}
          {% set paragraphId = paragraph.id() %}
          {% if inc == 0 %}
            {% set selected = 'true' %}
            {% set active = 'active show' %}
          {% else %}
            {% set selected = 'false' %}
            {% set active = '' %}
          {% endif %}
          <li class="nav-item" role="presentation">
            <a class="nav-link tab-link {{ active }}" id="tab-{{ paragraphId }}-{{ inc }}" data-toggle="tab" href="#content-{{ paragraphId }}-{{ inc }}" role="tab" aria-controls="content-{{ paragraphId }}-{{ inc }}" aria-selected="{{ selected }}">
              {{ paragraph.field_day_title.value }}
            </a>
          </li>
          {% set inc = inc + 1 %}
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="tab-content tabbed-content__content pt-8">
    {% set cont = 0 %}
    {% for item in items %}
      {% set paragraph = item.content['#paragraph'] %}
      {% set paragraphId = paragraph.id() %}
      {% if cont == 0 %}
        {% set active = 'show active' %}
      {% else %}
        {% set active = '' %}
      {% endif %}
      <div class="tab-pane tabbed-content__content--itemtab-pane {{ active }}" id="content-{{ paragraphId }}-{{ cont }}" role="tabpanel" aria-labelledby="tab-{{ paragraphId }}-{{ cont }}">
        {{ item.content }}
      </div>
      {% set cont = cont + 1 %}
    {% endfor %}
  </div>
</div>
