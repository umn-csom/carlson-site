{#
/**
 * @file
 * Theme override of an image.
 *
 * Available variables:
 * - attributes: HTML attributes for the img tag.
 * - style_name: (optional) The name of the image style applied.
 *
 * @see template_preprocess_image()
 */
#}
{% set classes = [
  style_name ? 'image-style-' ~ style_name|clean_class,
  'img-fluid'|clean_class,
]
%}
{% if attributes.loading == 'eager' %}
{% set attributes = attributes.setAttribute('fetchpriority', 'high') %}
{% endif %}
{% set lqip = attributes['data-lqip']|render %}
{% if lqip %}
<img{{ attributes.addClass(classes).removeAttribute('data-lqip') }}
style="
background-image: url({{ lqip }});
background-size: cover;
background-position: center;
"
onload="this.style.backgroundImage='none';"
/>
{% else %}
<img{{ attributes.addClass(classes) }} />
{% endif %}
