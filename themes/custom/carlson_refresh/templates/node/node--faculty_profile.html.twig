{#{{ attach_library('bootstrap_barrio/node') }}#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <div{{ content_attributes.addClass('node__content', 'clearfix', 'faculty-profile') }}>
    <div class="row justify-content-center">
      <div class="col-12">
        <section class="faculty-profile__top mb-4">
          <div class="row">
            <div class="col-12 col-md-6 col-lg-4 faculty-profile__top--headshot-wrapper d-flex">
                <div class="faculty-profile__experience__bg bg-gold d-flex">
                  <div class="faculty-profile__experience__bg__inner bg-primary px-6"></div>
                </div>
                <div class="w-100 embed-responsive embed-responsive-1by1">
                  {% if content.field_profile_img|field_value is not empty %}
                    <div class="faculty-profile__top--headshot">
                      {{ content.field_profile_img|field_value }}
                    </div>
                  {% else %}
                    <div class="faculty-profile__top--headshot">
                      <img src="/sites/carlsonschool.umn.edu/themes/custom/carlson_refresh/images/placeholder.jpg" alt="placeholder photo">
                    </div>
                  {% endif %}
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-8 profile-content-wrapper d-flex mb-6 mb-md-0">
              <div class="px-6 py-6 py-lg-10 w-100">
                <h1 class="faculty-profile__top--name">
                  {{ node.label }}
                </h1>
                {% if content.field_profile_title|field_value is not empty %}
                  <div class="faculty-profile__top--title fs-18 font-weight-semi-bold text-uppercase mb-1">
                    {{ content.field_profile_title|field_value }}
                  </div>
                {% endif %}
                {% if content.field_profile_title_2|field_value is not empty %}
                  <div class="faculty-profile__top--title fs-18 font-weight-semi-bold text-uppercase mb-1">
                    {{ content.field_profile_title_2|field_value }}
                  </div>
                {% endif %}
                {% if content.field_profile_title_3|field_value is not empty %}
                  <div class="faculty-profile__top--title fs-18 font-weight-semi-bold text-uppercase mb-1">
                    {{ content.field_profile_title_3|field_value }}
                  </div>
                {% endif %}
                {% if content.field_profile_title_4|field_value is not empty %}
                  <div class="faculty-profile__top--title fs-18 font-weight-semi-bold text-uppercase mb-1">
                    {{ content.field_profile_title_4|field_value }}
                  </div>
                {% endif %}
                {% if content.field_profile_dept|field_value is not empty %}
                  <div class="faculty-profile__top--dept fs-18 font-weight-semi-bold mb-1">
                    {{ content.field_profile_dept|field_value }}
                  </div>
                {% endif %}
{#                {% if node.body.summary is not empty %}#}
{#                  <div class="faculty-profile__top--summary">#}
{#                    {{ node.body.summary }}#}
{#                  </div>#}
{#                {% endif %}#}
                <div class="mt-6 font-weight-bold">
                  <h2 class="ff-sans-serif fs-18 font-weight-semi-bold text-uppercase mb-4">Contact</h2>
                  <div class="">
                    <div class="row">
                      <div class="col-12 col-lg-6">
                        {% if content.field_office_phone|field_value is not empty %}
                          <div class="faculty-profile__contact--phone d-flex align-items-center mb-1">
                            <span class="icon icon-mobile-phone mr-1 font-weight-bold"></span>
                            <a href="tel:{{ content.field_office_phone|field_value }}">
                              {{ content.field_office_phone|field_value }}
                            </a>
                          </div>
                        {% endif %}

                        {% if content.field_profile_address|field_value is not empty %}
                          <div class="faculty-profile__contact--address d-flex align-items-center mb-1">
                            <span class="icon icon-map-pin mr-1 font-weight-bold"></span>{{ content.field_profile_address|field_value }}
                          </div>
                        {% endif %}

                        {% if content.field_email|field_value is not empty %}
                          <div class="faculty-profile__contact--email d-flex align-items-center mb-1">
                            <span class="icon icon-envelope mr-1 font-weight-bold"></span>
                            <a href="mailto:{{ content.field_email|field_value }}">
                              {{ content.field_email|field_value }}
                            </a>
                          </div>
                        {% endif %}
                      </div>
                      <div class="col-12 col-lg-6">
                        {% if content.field_profile_cvc|field_value is not empty %}
                          <div class="faculty-profile__contact--cvc d-flex align-items-center mb-1">
                            <span class="icon icon-download mr-1 font-weight-bold"></span>
                            <a href="{{ file_url( node.field_profile_cvc.entity.uri.value  ?: '') }}">
                              Curriculum Vitae
                            </a>
                          </div>
                        {% endif %}

                        {% if content.field_profile_url|field_value is not empty %}
                          <div class="faculty-profile__contact--link d-flex align-items-center mb-1">
                            <span class="icon icon-link mr-1 font-weight-bold"></span>
                            {{ content.field_profile_url|field_value }}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
{#            <div class="col-12 col-lg-4 faculty-profile__contact d-flex mb-6">#}
{#              <div class="bg-primary text-white p-6 p-md-10 w-100">#}

{#              </div>#}
{#            </div>#}
            {% if content.field_profile_degrees|render|striptags|trim != "" or content.field_profile_expertise|render|striptags|trim != "" %}
              <div class="col-12 col-lg-12 faculty-profile__experience d-flex mb-6">
                <div class="p-6 p-md-10 bg-ivory flex-grow-1">
                  <div class="row">
                    <div class="col-12 col-md-6">
                      {% if content.field_profile_degrees|render|striptags|trim != "" %}
                        <h2 class="ff-sans-serif fs-24 font-weight-semi-bold text-uppercase mb-4">Education:</h2>
                        <ul>
                          {{ content.field_profile_degrees|field_value }}
                        </ul>
                      {% endif %}
                    </div>
                    <div class="col-12 col-md-6">
                      {% if content.field_profile_expertise|render|striptags|trim != "" %}
                        <h2 class="ff-sans-serif fs-24 font-weight-semi-bold text-uppercase mb-4">Expertise:</h2>
                        <ul>
                          {{ content.field_profile_expertise|field_value }}
                        </ul>
                      {% endif %}
                    </div>
                  </div>
              </div>
              </div>
            {% endif %}
          </div>
        </section>

        {% if node.body.value|raw is not empty %}
          <section class="faculty-profile__about mb-10">
              <div class="row">
                  <div class="col-12">
                    <h2>Biography</h2>
                    <div class="faculty-profile__about--summary">
                      {{ node.body.value|raw }}
                    </div>
                  </div>
              </div>
          </section>
        {% endif %}

{#        <hr />#}

        {% if content.field_profile_works|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty or
          content.field_profile_activities|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty or
          node.id == 100151 %}
          <section class="faculty-profile__works mb-10">
              <div class="row">
                  <div class="col-12 text-center">
                    <h2 class="faculty-profile__works--heading">Selected Works & Activities</h2>
                  </div>
              </div>
              <div class="row">
                <div class="col-12">
                    {% set accordion_data = [] %}
                    {% if node.id == 100151 %}
                      {% set accordion_data = accordion_data|merge([
                          {
                            'label': 'Selected Works, 2014–present',
                            'markup': drupal_view('faculty_profile_works_additional', 'block_1', '100151'),
                            'wrapper':'<ul class="faculty-profile__works--selected">'
                          }
                        ])
                      %}
                      {% set accordion_data = accordion_data|merge([
                          {
                            'label': 'Selected Works, 2010–2013',
                            'markup': drupal_view('faculty_profile_works_additional', 'block_1', '99906'),
                            'wrapper':'<ul class="faculty-profile__works--selected">'
                          }
                        ])
                      %}
                      {% set accordion_data = accordion_data|merge([
                          {
                            'label': 'Selected Works, 1999–2009',
                            'markup': drupal_view('faculty_profile_works_additional', 'block_1', '99921'),
                            'wrapper':'<ul class="faculty-profile__works--selected">'
                          }
                        ])
                      %}
                    {% else %}
                      {% if content.field_profile_works|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                        {% set accordion_data = accordion_data|merge([
                            {
                              'label': 'Selected Works',
                              'markup': content.field_profile_works|field_value,
                              'wrapper':'<ul class="faculty-profile__works--selected">'
                            }
                          ])
                        %}
                      {% endif %}
                    {% endif %}

                    {% if content.field_profile_activities|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                    {% set accordion_data = accordion_data|merge([
                        {
                          'label': 'Current Activities',
                          'markup': content.field_profile_activities|field_value,
                          'wrapper':'<ul class="faculty-profile__works--activities">'
                        }
                      ])
                    %}
                  {% endif %}

                    {% if accordion_data is not empty %}
                      {% include directory ~ '/templates/components/accordion.html.twig' with { 'accordion_data': accordion_data } %}
                    {% endif %}
                </div>
              </div>
          </section>
        {% endif %}

        {% if logged_in %}
          <a href="/node/{{ node.id }}/edit" rel="nofollow" class="faculty-profile__edit"><span class="sr-only">Edit Profile</span></a>
        {% else %}
          <button id="faculty-profile__modal" class="faculty-profile__edit"><span class="sr-only">Log In to Edit Page</span></button>
          <dialog id="faculty-profile__confirm" class="faculty-profile__confirm">
            <i id="faculty-profile__close" class="fas fa-times faculty-profile__close"></i>
            <h3>Edit This Page</h3>

            <section class="faculty-profile__buttons">
              <div class="faculty-profile__column">
                <a href="https://form.asana.com/?k=p2h5OJXeyM2-bOxRCt9jSg&d=939683240123509" target="_blank" class="btn btn-primary btn-md">Request Edit Access</a>
              </div>

              <div class="faculty-profile__column">
                <a href="/saml_login?destination=/node/{{ node.id }}/edit" rel="nofollow" class="btn btn-primary btn-md">Log in to Edit</a>
                <div>Only select this option if you already have access to a Carlson School Drupal account.</div>
              </div>
            </section>

          </dialog>
        {% endif %}
      </div>
    </div>
  </div>
</article>
