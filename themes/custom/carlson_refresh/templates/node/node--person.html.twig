{#{{ attach_library('bootstrap_barrio/node') }}#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <div{{ content_attributes.addClass('node__content', 'clearfix', 'person-profile') }}>
    <div class="row justify-content-center mt-6">
      <div class="col-12">
        <section class="person-profile__top">
          <div class="row justify-content-center">
            <div class="col-12 d-md-none">
              <h1 class="h2 student-profile__top--name mb-3">
                {{ node.label }}
              </h1>
            </div>
            <div class="col-9 col-sm-6 col-md-4 mb-6 mb-md-10">
              <div class="image-with-offset-back pb-6 pl-6">
                <div class="person-profile__top--headshot embed-responsive embed-responsive-5by7 overflow-initial border">
                  <div class="background embed-responsive-item bg-ivory d-flex ml-n6 mt-6">
                    <div class="bg-gold">
                      <div class="background__inner bg-light-blue px-6 h-100" style="clip-path: polygon(0 65%, 100% 75%, 100% 100%, 0 100%);"></div>
                    </div>
                    <div class="flex-grow-1"></div>
                  </div>
                  {% if content.field_profile_img|field_value is not empty %}
                    {{ content.field_profile_img|field_value }}
                  {% else %}
                    <img src="/{{ directory }}/images/placeholders/profile-image-placeholder.jpg" alt="Profile image" class="img-fluid">
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="col-12 col-md-8 mb-10 person-profile__top--wrap">
                <div class="h2 person-profile__top--name mb-1 d-none d-md-block">
                  {{ node.label }}
                </div>

                {% if content.field_profile_title|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                  <div class="person-profile--title mb-4 text-uppercase font-weight-semi-bold">{{ content.field_profile_title }}</div>
                {% endif %}

              {% if content.field_office_phone|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty or
                content.field_profile_address|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty or
                content.field_email|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                <div class="person-profile__contact mb-4">
                  <h2 class="h3">Contact:</h2>
                  {% if content.field_office_phone|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                    <div class="person-profile__contact--phone">
                      <a href="tel:{{ content.field_office_phone|field_value }}">
                        {{ content.field_office_phone|field_value }}
                      </a>
                    </div>
                  {% endif %}

                  {% if content.field_profile_address|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                  <div class="person-profile__contact--address">
                    {{ content.field_profile_address|field_value }}
                  </div>
                  {% endif %}

                  {% if content.field_email|field_value|render|striptags|replace({"\n": "", "\r": "", "\t": "", " ": ""}) is not empty %}
                    <div class="person-profile__contact--email">
                      <a href="mailto:{{ content.field_email|field_value }}">
                        {{ content.field_email|field_value }}
                      </a>
                    </div>
                  {% endif %}
                </div>
              {% endif %}

                {% if content.field_profile_quote|field_value is not empty %}
                <div class="person-profile__top--quote bg-gold p-6">
                    {{ content.field_profile_quote|field_value }}
                </div>
                {% endif %}
            </div>
          </div>

        </section>

        {% if node.body.value|raw is not empty %}
          <section class="mb-10">
            <div class="row">
              <div class="col-12 person-profile__summary">
                <h3>About</h3>
                {{ node.body.value|raw }}
              </div>
            </div>
          </section>
        {% endif %}
      </div>
    </div>
  </div>
</article>
