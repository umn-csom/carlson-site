<section class="py-10">
  <div class="container">
    <div class="row mb-10">
      <div class="col-12 text-center">
        <h2 class="m-0">{{ content.field_front_programs_head }}</h2>
      </div>
    </div>
  <div class="row justify-content-center">
    {{ content.field_front_programs }}
  </div>
</div>
</section>

<section class="py-10">
  <div class="container-fluid container-xl">
    <div class="row justify-content-center">
      <div class="col-12">
        <h2 class="mb-6 mb-lg-10 text-center">Featured at Carlson</h2>
      </div>
      <div class="col-12 mb-3 mb-lg-6">
        {{ drupal_view('front_blocks', 'feature_news') }}
      </div>
      <div class="col-12 col-lg-4 mb-3 mb-lg-0 row row-cols-1 no-gutters">
        {{ drupal_view('front_blocks', 'feature_events') }}
      </div>
      <div class="col-12 col-lg-4 mb-3 mb-lg-0 row row-cols-1 no-gutters">
        {{ drupal_view('front_blocks', 'feature_discover') }}
      </div>
      <div class="col-12 col-lg-4 row row-cols-1 no-gutters">
        {{ drupal_view('front_deadlines', 'block_1') }}
      </div>
    </div>
  </div>
</section>


