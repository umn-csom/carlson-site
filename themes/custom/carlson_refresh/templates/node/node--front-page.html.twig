<section class="front-statistics bg-light-blue d-flex">
  <div class="front-statistics__container py-10 bg-primary w-100">
    <div class="container-fluid container-xl">
      {{ content.field_front_statistics }}
    </div>
  </div>
</section>

<section style="background-image: url('{% spaceless %}{{ content.field_front_advantage_bg[0]['#markup'] }}{% endspaceless %}');" class="front__advantage">
  <div class="container-fluid container-lg p-0 px-lg-3">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">
        <div class="row justify-content-lg-end">
          <div class="col-12 d-lg-none">
            <img alt="" src="{% spaceless %}{{ content.field_front_advantage_bg[0]['#markup'] }}{% endspaceless %}" class="img-fluid">
          </div>
          <div class="col-12 col-lg-7">
            <div class="bg-white p-6 px-lg-8 py-lg-12">
              <h2 class="h1 mb-6 text-center text-lg-left">{{ content.field_field_front_advantage_head }}</h2>
              <div class="mb-6 mb-lg-12">
                <p class="front__advantage__subheading text-uppercase mb-2 font-weight-semi-bold">{{ content.field_front_advantage_1head }}</p>
                {{ content.field_front_advantage_1copy }}
                <a href="{{ content.field_front_advantage_1link.0['#url'] }}" class="btn btn-primary">{{ content.field_front_advantage_1link.0['#title'] }}</a>
              </div>
              <div>
                <p class="front__advantage__subheading text-uppercase mb-2 font-weight-semi-bold">{{ content.field_field_front_advantage_2hea }}</p>
                {{ content.field_front_advantage_2copy }}
                <a href="{{ content.field_front_advantage_2link.0['#url'] }}" class="btn btn-primary">{{ content.field_front_advantage_2link.0['#title'] }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="bg-info" style="height: 35px;"></div>


<section class="py-12 py-lg-24">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">
        <div class="row">
          {% spaceless %}
          <div class="col-12 col-xl-6 mb-6 mb-xl-0">
            {{ node_bottom_left }}
          </div>
          <div class="col-12 col-xl-6">
            {{ node_bottom_right }}
          </div>
          {% endspaceless %}
    </div>
  </div>
</div>
</div>
</section>
