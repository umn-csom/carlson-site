{{ attach_library('carlson_refresh/front-advantage') }}
<section class="front-advantage">
  <img
    alt=""
    src="{% apply spaceless %}{{ content.field_front_advantage_bg[0]['#markup'] ?? '/sites/carlsonschool.umn.edu/themes/custom/carlson_refresh/images/building-homepage-min.webp' }}{% endapply %}"
    class="front-advantage__img"
    loading="lazy"
    fetchpriority="low"
    width="1920"
    height="1080"
  >
  <div class="container-fluid container-lg p-0 px-lg-3">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">
        <div class="row justify-content-lg-end">
          <div class="col-12 col-lg-7">
            <div class="bg-white-90 p-6 px-lg-8 py-lg-12">
              <h2 class="h1 mb-6 text-center text-lg-left">{{ content.field_field_front_advantage_head|render|trim is not empty ? content.field_field_front_advantage_head : 'Experience the Carlson Advantage' }}</h2>
              <div class="mb-6 mb-lg-12">
                <p class="front-advantage__subheading text-capitalize mb-2 font-weight-semi-bold">{{ content.field_front_advantage_1head|render|trim is not empty ? content.field_front_advantage_1head : 'Reputation and rankings' }}</p>
                {{ content.field_front_advantage_1copy|render|trim is not empty ? content.field_front_advantage_1copy : "<p>The Carlson School of Management's educational programs and faculty are highly ranked, both nationally and internationally.</p>" }}
                <a href="{{ content.field_front_advantage_1link.0['#url']|render|trim is not empty ? content.field_front_advantage_1link.0['#url'] : '/about-us/facts-figure' }}" class="btn btn-primary">{{ content.field_front_advantage_1link.0['#title']|render|trim is not empty ? content.field_front_advantage_1link.0['#title'] : 'More facts' }}</a>
              </div>
              <div>
                <p class="front-advantage__subheading text-capitalize mb-2 font-weight-semi-bold">{{ content.field_field_front_advantage_2hea |render|trim is not empty ? content.field_field_front_advantage_2hea : 'Join a vibrant business community' }}</p>
                {{ content.field_front_advantage_2copy|render|trim is not empty ? content.field_front_advantage_2copy : "<p>The Carlson School is located in the heart of Minneapolis-St. Paul: a thriving business community and one of the nation's top-rated places to live, work, and play.</p>" }}
                <a href="{{ content.field_front_advantage_2link.0['#url']|render|trim is not empty ? content.field_front_advantage_2link.0['#url'] : '/degrees/master-business-administration/full-time-mba/student-life/living-in-minneapolis' }}" class="btn btn-primary">{{ content.field_front_advantage_2link.0['#title']|render|trim is not empty ? content.field_front_advantage_2link.0['#title'] : 'Learn more' }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="bg-info" style="height: 35px;"></div>


<section class="py-12 py-lg-24">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">
        <div class="row">
          {% apply spaceless %}
          <div class="col-12 col-xl-6 mb-6 mb-xl-0">
            {{ node_bottom_left }}
          </div>
          <div class="col-12 col-xl-6">
            {{ node_bottom_right }}
          </div>
          {% endapply %}
    </div>
  </div>
</div>
</div>
</section>
