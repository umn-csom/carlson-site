{#{{ attach_library('bootstrap_barrio/node') }}#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix'
  ]
%}

<article{{ attributes.addClass(classes) }}>
<div{{ content_attributes.addClass('node__content', 'clearfix', 'basic-page') }}>
  {# Render hero with hero-basic component #}
  {% if content.field_hero_media|field_value is empty %}
    <section>
      {{ attach_library('carlson_refresh/hero-basic') }}
      <div class="row basic-hero travel-hero">
        <div class="col-11 col-lg-10 offset-lg-1 basic-hero__title">
          <h1>{{ label }}</h1>
        </div>
      </div>
    </section>
  {% else %}
    <section>
      {{ attach_library('carlson_refresh/hero-basic') }}
      <div class="row basic-hero travel-hero">
        <div class="col-lg-12 basic-hero__img">
          {{ content.field_hero_media }}
        </div>
        <div class="col-10 offset-1 basic-hero__title">
          <div class="basic-hero__title-inner">
            <h1>{{ label }}</h1>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

<!--- START-->
    <section class="row justify-content-center">
      <div id="quiz_container" class="col-12 col-xl-10"></div>
    </section>

  <div class="row justify-content-center mt-5 pt-5"><div class="col-12 col-md-10 col-xl-5">
    <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <a href="/em/recruiting-events"><img src="/{{ directory }}/images/html_campaign/ontheroad-mn.jpg" alt="An aerial photo of downtown Minneapolis overlaid with an outline of the state of Minnesota." class="img-fluid"></a>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 pb-3">
      <a href="/em/recruiting-events" class="btn btn-lg btn-outline-secondary btn-block">Register for an MBA&amp;MS Tour event</a>
    </div>
  </div>
  </div>
  </div>

<!--END-->


    <section class="row basic-page__content">
      <div class="col-lg-10 offset-lg-1 main-content basic-page__content--inner">
        {# inner_nav region #}
        {% if inner_nav %}
        {{ attach_library('carlson_refresh/inner-nav') }}
        <div class="row inner_nav">
          <div class="col-12">
            <div class="row">
              {{ inner_nav }}
            </div>
          </div>
        </div>
        {% endif %}

        {# Course brochure link #}
        {% if content.field_ee_catalog_link|field_value is not empty %}
        {{ attach_library('carlson_refresh/basic-page__catalog') }}
        <div class="row basic-page__catalog">
          <div class="col-12 text-center">
            {{ content.field_ee_catalog_link }}
          </div>
        </div>
        {% endif %}

        <div class="row">

          {# Stick sidebar region #}
          {% if sticky_sidebar | render %}
          <div class="col-lg-3 sticky-sidebar pl-lg-2 pb-4">
            <div class="row h-100">
              <div class="col-12 h-100">
                <div class="sticky-sidebar__inner h-100">
                {{ sticky_sidebar }}
                </div>
              </div>
            </div>
          </div>
          {% endif %}

          <div class="{{ (sticky_sidebar | render) ? 'col-lg-9' : 'col-12' }} basic-page__content-components">

            {# Inner node region for blocks #}
            {% if node_top %}
              {{ node_top }}
            {% endif %}

            {# Home Flexible feature paragraphs #}
            <div class="row component-paragraph">
              <div class="col-12">
                {{ content.body }}
              </div>
            </div>

            {# Inner node region for blocks #}
            {% if node_content %}
              {{ node_content }}
            {% endif %}

            {{ content.field_flexible_features }}

            {% if node_middle %}
              {{ node_middle }}
            {% endif %}

            {{ content.field_contact_info }}

            {% if node_bottom %}
              {{ node_bottom }}
            {% endif %}

            {# Bottom node region for blocks #}
            {{ attach_library('carlson_refresh/node__bottom') }}
            <div class="row node__bottom">
              {% apply spaceless %}
              <div class="node__bottom__col">
                {{ node_bottom_left }}
              </div>
              <div class="node__bottom__col">
                {{ node_bottom_right }}
              </div>
              {% endapply %}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</article>
