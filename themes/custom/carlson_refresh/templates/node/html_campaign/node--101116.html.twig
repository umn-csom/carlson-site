              </ul>
              <h3 class="mt-5">North Dakota</h3>
              <ul>
                <li><a href="/events/ontheroad_lunch_fargo">Fargo: October 11</a></li>
                <li><a href="/events/ontheroad_lunch_fargo-nov">Fargo: November 8</a></li>
              </ul>
              <h3 class="mt-5">Texas</h3>
              <ul>
                <li><a href="/events/ontheroad_austin">Austin: October 21</a></li>
                <li><a href="/events/ontheroad_dallas">Dallas: October 22</a></li>
                <li><a href="/events/ontheroad_sanantonio">San Antonio: November 14–15</a></li>
              </ul>
<!--
              <h3 class="mt-5">Utah</h3>
              <ul>
                <li>Salt Lake City: <em>Details coming soon</em></li>
              </ul>
-->
              <h3 class="mt-5">Washington</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_seattle">Seattle: August 20</a></li>
              </ul>

              <h3 class="mt-5">Wisconsin</h3>
              <ul>
                <li><a href="/events/ontheroad_lunch_madison">Madison: October 17</a></li>
                <li><a href="/events/ontheroad_lunch_milwaukee">Milwaukee: October 16</a></em></li>
              </ul>
              <!-- end col 2-->
            </div>
          </div>


{% if node_content %}
{{ node_content }}
{% endif %}

        </div>
      </section>
  </div>
</article>
