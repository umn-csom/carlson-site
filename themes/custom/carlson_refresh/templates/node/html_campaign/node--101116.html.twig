{#{{ attach_library('bootstrap_barrio/node') }}#}

{%
set classes = [
'node',
'node--type-' ~ node.bundle|clean_class,
node.isPromoted() ? 'node--promoted',
node.isSticky() ? 'node--sticky',
not node.isPublished() ? 'node--unpublished',
view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
'clearfix'
]
%}

<article{{ attributes.addClass(classes) }}>
  <header>
  {{ title_prefix }}
  {% if not page %}
    <h2{{ title_attributes.addClass('node__title') }}>
    <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}
  </header>


  <div{{ content_attributes.addClass('node__content', 'clearfix', 'basic-page') }}>
    {# Render hero with hero-basic component #}
      {% if content.field_hero_media|field_value is empty %}
        <section>
          <div class="row basic-hero travel-hero">
            <div class="col-11 col-lg-10 offset-lg-1 basic-hero__title">
              <h1>{{ label }}</h1>
              <h3 class="mt-3 mb-0 p-0" style="color:#fff;"><em>Meet us in a city near you</em></h3>
            </div>
          </div>
        </section>
      {% else %}
        <section>
          <div class="row basic-hero">
            <div class="col-lg-12 basic-hero__img">
              {{ content.field_hero_media }}
            </div>
            <div class="col-12 basic-hero__title">
              <div class="basic-hero__title-inner">
                <h1>{{ label }}</h1>
              </div>
            </div>
          </div>
        </section>
      {% endif %}

      <section class="row justify-content-center basic-page__content">
        <div class="col-11 main-content basic-page__content--inner">
          <!--start -->
          <div class="row">
            <div class="col-12 col-md-7 col-lg-9 order-2 order-md-1 map-container map-usa">
              <div class="jvmap-smart" id="usamap"></div>
            </div>
            <div class="col-12 col-md-5 col-lg-3 order-1 order-md-2 copy--tighter">
              <div class="row component-paragraph">
                <div class="col-12">
                  {{ content.body }}
                  <div id="copy"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="row component-paragraph justify-content-center mb-5 d-flex d-lg-none">
            <div class="col-12 col-sm-6 copy--tighter">
              <!-- col 1-->
              <h3>California</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_sanfranscisco">San Francisco: August 22</a></li>
                <li><a href="/events/ontheroad_qs_sanfranscisco">San Francisco: September 14</a></li>
              </ul>
              <h3 class="mt-5">District of Columbia</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_washingtondc">Washington: August 12</a></li>
                <li><a href="/events/ontheroad_qs_washingtondc">Washington: September 26</a></li>
                <li><a href="/events/ontheroad_qsconnect_washingtondc">Washington: November 14</a></li>
              </ul>
              <h3 class="mt-5">Georgia</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_atlanta">Atlanta: August 14</a></li>
                <li><a href="/events/ontheroad_qs_atlanta">Atlanta: October 17</a></li>
              </ul>

              <h3 class="mt-5">Illinois</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_chicago">Chicago: August 27</a></li>
                <li><a href="/events/ontheroad_qs_chicago">Chicago: October 1</a></li>
                <li><a href="/events/ontheroad_idealist_chicago">Chicago: October 3</a></li>
                <li><a href="/events/ontheroad_coffeechat_chicago">Chicago: October 4</a></li>
                <li><a href="/events/ontheroad_coffeechat_chicago_2">Chicago: October 15, 2:30–5&nbsp;p.m.</a></li>
                <li><a href="/events/ontheroad_inside_chicago">Chicago: October 15, 6–8:30&nbsp;p.m.</a></li>
              </ul>

              <h3 class="mt-5">Iowa</h3>
              <ul>
                <li><a href="/events/ontheroad_lunch_desmoines">Des Moines: October 15</a></li>
              </ul>

              <h3 class="mt-5">Maryland</h3>
              <ul>
                <li><a href="/events/ontheroad_baltimore">Baltimore: October 31</a></li>
              </ul>
              <!--end col 1-->
            </div>
            <div class="col-12 col-sm-6 copy--tighter">
              <!-- col 2-->
              <h3 class="mt-5">Minnesota</h3>
              <ul>
                <li><a href="/events/ontheroad_lunch_duluth">Duluth: October 8</a></li>
                <li><a href="/events/ontheroad_diversity_minneapolis">Minneapolis: September 17</a></li>
                <li><a href="/events/ontheroad_idealist_minneapolis">Minneapolis: October 2</a></li>
                <li><a href="/events/ontheroad_inside_minneapolis">Minneapolis: October 16</a></li>
                <li><a href="/events/ontheroad_qs_minneapolis">Minneapolis: October 24</a></li>
                <li><a href="/events/ontheroad_lunch_rochester">Rochester: October 14</a></li>
                <li><a href="/events/ontheroad_coffeechat_stcloud">St. Cloud: October 11</a></li>
              </ul>
              <h3>New York</h3>
              <ul>
                <li><a href="/events/ontheroad_forte_newyork_1">New York: August 28</a></li>
