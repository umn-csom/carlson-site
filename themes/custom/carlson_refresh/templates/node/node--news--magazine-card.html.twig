{{ attach_library('carlson_refresh/magazine') }}

<article class="row no-gutters magazine--section-item justify-content-center stretched-link-container">
  {% if content.field_hero_media|field_value is not empty %}
  <div class="col-4 col-md-4 col-lg-5 col-xl-4 pr-4">
    {{ content.field_hero_media }}
  </div>
  <div class="col-8 col-md-8 col-lg-7 col-xl-8 magazine--section-item--summary position-static d-flex align-items-center">
  {% else %}
  <div class="col-12 magazine--section-item--summary position-static d-flex align-items-center">
  {% endif %}
    <h3 class="magazine--section-item--title {% if content.field_hero_media|field_value is not empty %}magazine--section-item--title--alumni-position{% endif %}">
      <a href="{{ url }}" class="stretched-link">{{ label }}</a>
    </h3>

  </div>
</article>
