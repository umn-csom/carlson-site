{#
/**
 * @file
 * Bootstrap Barrio's theme implementation to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
     Only "getter" methods (method names starting with "get", "has", or "is")
     and a few common methods such as "id" and "label" are available. Calling
     other methods (such as node.delete) will result in an exception.
 * - label: The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - metadata: Metadata for this node.
 * - date: Themed creation date field.
 * - author_name: Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - node: The current template type (also known as a "theming hook").
 *   - node--type-[type]: The current node type. For example, if the node is an
 *     "Article" it would result in "node--type-article". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - node--view-mode-[view_mode]: The View Mode of the node; for example, a
 *     teaser would result in: "node--view-mode-teaser", and
 *     full: "node--view-mode-full".
 *   The following are controlled through the node publishing options.
 *   - node--promoted: Appears on nodes promoted to the front page.
 *   - node--sticky: Appears on nodes ordered above other non-sticky nodes in
 *     teaser listings.
 *   - node--unpublished: Appears on unpublished nodes visible only to site
 *     admins.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main
 *   content tag that appears in the template.
 * - author_attributes: Same as attributes, except applied to the author of
 *   the node tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state. Will be true if view_mode is 'teaser'.
 * - page: Flag for the full page state. Will be true if view_mode is 'full'.
 * - readmore: Flag for more state. Will be true if the teaser content of the
 *   node cannot hold the main body content.
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_node()
 */
#}
{#{{ attach_library('bootstrap_barrio/node') }}#}

{{ attach_library('carlson_refresh/fee-table') }}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <header>
    {{ title_prefix }}
    {% if not page %}
      <h2{{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}
  </header>

  <div{{ content_attributes.addClass('node__content', 'clearfix', 'ed-abroad') }}>
    <section class="row justify-content-center ed-abroad__top">
      <div class="col-12">
        {# Program Hero #}
        {{ attach_library('carlson_refresh/hero-program') }}
        <div class="row align-items-center component-paragraph hero-program">
          <div class="col-12 col-lg-7 mb-6 mb-lg-0 hero-program__img">
            <div class="image-with-offset-back pb-6 pl-6">
              <div class="embed-responsive embed-responsive-16by9 overflow-initial border">
                <div class="background embed-responsive-item bg-ivory d-flex ml-n6 mt-6">
                  <div class="bg-gold">
                    <div class="background__inner bg-light-blue px-6 h-100" style="clip-path: polygon(0 65%, 100% 75%, 100% 100%, 0 100%);"></div>
                  </div>
                  <div class="flex-grow-1"></div>
                </div>
                  {{ content.field_hero_media }}
              </div>
            </div>
          </div>
          <div class="col-12 col-lg-5 hero-program__content">
            <div class="row">
              <div class="col-12">
                <h1 class="h2 hero-program__title">{{ node.label }}</h1>
                {{ content.field_short_sub_heading }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="row ed-abroad__content mb-12">
      <div class="col-12 main-content ed-abroad__content--inner">
        <div class="row">
          <div class="col-12 col-lg-8">

            {% if (content.field_ea_program_dates_info|field_value is not empty) or (content.field_ea_program_dates|field_value is not empty) %}
              <div class="component-paragraph">
              <h2>Program Dates:</h2>
              {{ content.field_ea_program_dates }}
              {{ content.field_ea_program_dates_info }}
              </div>
            {% endif %}

            {# Home Flexible feature paragraphs #}
            {{ content.field_flexible_features }}

            <h2 class="ed-abroad__content--details text-center">Program Details</h2>
            {% if content.program_details_intro|field_value is not empty %}
              <div class="d-abroad__content--leadin text-center">
                {{ content.program_details_intro }}
              </div>
            {% endif %}
            {# Accordion #}

            <div class="row">
              <div class="col-12">
                {% set accordion_data = [] %}

                {% if content.field_ea_program_objective|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Objective',
                        'markup': content.field_ea_program_objective|field_value,
                        'wrapper':'<ul class="ed-abroad__content--objective">'
                      }
                    ])
                  %}
                {% endif %}
                {% if content.field_ea_program_location_info|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Location Details',
                        'markup': content.field_ea_program_location_info|field_value,
                        'wrapper':'<ul class="ed-abroad__content--location-details">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_housing_food|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Accommodations',
                        'markup': content.field_ea_program_housing_food|field_value,
                        'wrapper':'<ul class="ed-abroad__content--accomodations">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_academics|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Academics & Credits',
                        'markup': content.field_ea_program_academics|field_value,
                        'wrapper':'<ul class="ed-abroad__content--academics">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_internship|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Optional Internship Information',
                        'markup': content.field_ea_program_internship|field_value,
                        'wrapper':'<ul class="ed-abroad__content--internship">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_eligibility|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Eligibility',
                        'markup': content.field_ea_program_eligibility|field_value,
                        'wrapper':'<ul class="ed-abroad__content--eligibility">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_visa_and_passport|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Visa & Passport',
                        'markup': content.field_visa_and_passport|field_value,
                        'wrapper':'<ul class="ed-abroad__content--visa">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_app_admission|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Application & Admissions',
                        'markup': content.field_ea_program_app_admission|field_value,
                        'wrapper':'<ul class="ed-abroad__content--application">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_aid_scholarhips|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Financial Aid & Scholarship',
                        'markup': content.field_ea_program_aid_scholarhips|field_value,
                        'wrapper':'<ul class="ed-abroad__content--aid">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_business_exch|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Business Exchange',
                        'markup': content.field_ea_program_business_exch|field_value,
                        'wrapper':'<ul class="ed-abroad__content--business-exchange">'
                      }
                    ])
                  %}
                {% endif %}


                {% if content.field_ea_program_audience|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Audience',
                        'markup': content.field_ea_program_audience|field_value,
                        'wrapper':'<ul class="ed-abroad__content--audience">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_predep_classes|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Pre-departure Classes',
                        'markup': content.field_ea_program_predep_classes|field_value,
                        'wrapper':'<ul class="ed-abroad__content--pre-departure-classes">'
                      }
                    ])
                  %}
                {% endif %}

                {% if content.field_ea_program_schedule|field_value is not empty %}
                  {% set accordion_data = accordion_data|merge([
                      {
                        'label': 'Schedule',
                        'markup': content.field_ea_program_schedule|field_value,
                        'wrapper':'<ul class="ed-abroad__content--schedule">'
                      }
                    ])
                  %}
                {% endif %}

                {% if accordion_data is not empty %}
                  {% include directory ~ '/templates/components/accordion.html.twig' with { 'accordion_data': accordion_data } %}
                {% endif %}
              </div>
            </div>
            <h2>Cost</h2>
            {% if content.field_ea_cost_summary|field_value is not empty %}
              {{ content.field_ea_cost_summary }}
            {% endif %}

            {% if content.field_ea_cost_table|field_value is not empty %}
              <div class="component-paragraph">{{ content.field_ea_cost_table }}</div>
            {% endif %}

            {# Home Flexible feature paragraphs #}
            {{ content.field_cost_paragraphs }}
          </div>
          <div class="col-12 col-lg-4 ed-abroad__sidebar">
            <div class="border p-6">
              <h2 class="ed-abroad__sidebar--title">Details:</h2>
              {{ content.field_ea_program_status }}
              {{ content.field_ea_staff }}
              {{ content.field_ea_faculty }}
              {{ content.field_links }}
              {{ content.field_ea_fact_sheet }}
              {{ content.field_grade_credit_chart }}
              {{ content.field_ea_terms }}
              {{ content.field_ea_program_degree_level }}
              {{ content.field_ea_program_region }}
              {{ content.field_ea_program_country }}
              {{ content.field_ea_program_city }}
              {{ content.field_logo }}
              {{ content.field_ea_program_host_school }}
              {{ content.field_ea_office }}
              {{ content.field_field_ea_program_model }}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</article>
