{{ attach_library('carlson_refresh/magazine') }}

{% set magazine = content.field_magazine_publication['#items'].getString() %}

<section class="magazine--pdf pb-5 mb-4">
  <div class="row justify-content-center">
  {% if content.field_magazine_cover_image|render %}
      <figure class="col-4">
        {% if content.field_magazine_pdf | render %}
          <a href="{{ content.field_magazine_pdf|render|striptags }}" target="_blank">
        {% endif %}
          <img src="{% apply spaceless %}{{ content.field_magazine_cover_image|render|striptags }}{% endapply %}" alt='{{ label|field_value }} {% if magazine == "alumni" %}alumni {% elseif magazine == "discovery" %}Discovery {% endif %}magazine cover' Cover class="img-fluid magazine--cover-angle">
          {% if content.field_magazine_pdf | render %}
          </a>
        {% endif %}
      </figure>
  {% endif %}
    <div class="col-8">
      <a href="{{ url }}" target="_blank">
        {% if magazine == "alumni" %}Alumni Magazine {% elseif magazine == "discovery" %}Discovery at Carlson {% endif %}
        {{ source('@carlson_refresh/../images/svg/arrow-right-cta.svg') }}
      </a>
      {{ content.field_teaser }}
    </div>
  </div>
</section>
