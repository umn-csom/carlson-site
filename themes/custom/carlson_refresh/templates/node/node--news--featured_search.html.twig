<article class="row justify-content-center front--featured-news">
  <div class="col-12 col-lg-7 mb-6">
    <div class="col-12">
      <h4 class="featured-news-header">Featured News</h4>
      <hr class="featured-news-line">
    </div>
    <figure class="col-12">
      <a href="{{ url }}">{{ content.field_hero_media }}</a>
    </figure>
    <div class="col-12">
      <a href="{{ url }}">
        <h3><em>{{ label }}</em></h3>
      </a>
      <section class="front--featured-news--copy">{{ content.body }}</section>
      <a href="{{ url }}"><p class="mt-4 mb-0"><span class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Read more</span></p></a>
    </div>
  </div>
  <div class="col-12 col-lg-5">
    <div class="row justify-content-center">

      {{ drupal_view('magazine_index', 'alumni_card') }}
      {{ drupal_view('magazine_index', 'discovery_card') }}

      <a href="/events"><p class="mt-4 mb-0"><span class="">Browse Events</span></p></a>
      <a href="/contact/media"><p class="mt-4 mb-0"><span class="">Make Media Request</span></p></a>

    </div>
  </div>  
</article>
