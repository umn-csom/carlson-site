<article class="row justify-content-center front--featured-news stretched-link-container">
  <div class="col-12 col-lg-7 mb-6">
    <div class="col-12">
      <h2 class="featured-news-header h4">Featured News</h2>
      <hr class="featured-news-line">
    </div>
    <figure class="col-12">
      {{ content.field_hero_media }}
    </figure>
    <div class="col-12">
      <a href="{{ url }}" class="stretched-link">
        <h3><em>{{ label }}</em></h3>
      </a>
      <section class="front--featured-news--copy">{{ content.body }}</section>
      <p class="mt-4 mb-0"><span class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Read more</span></p>
    </div>
  </div>
  <div class="col-12 col-lg-5 featured-news-links justify-content-center p-5">
    <div class="col-12">
      {{ drupal_view('magazine_index', 'alumni_card') }}
      {{ drupal_view('magazine_index', 'discovery_card') }}
    </div>
    <div class="col-12">
      <a href="/events">Browse Events <span class="ml-3 icon icon-carrot"></span></a>
    </div>
    <div class="col-12">
      <a href="/contact/media">Make Media Request <span class="ml-3 icon icon-carrot"></span></a>
    </div>
  </div>  
</article>
