<article class="row justify-content-center front--featured-news">
  <div class="col-12 col-lg-7 mb-6">
    <div class="col-12">
      <h4 class="featured-news-header">Featured News</h4>
      <hr class="featured-news-line">
    </div>
    <figure class="col-12">
      <a href="{{ url }}">{{ content.field_hero_media }}</a>
    </figure>
    <div class="col-12">
      <a href="{{ url }}">
        <h3><em>{{ label }}</em></h3>
      </a>
      <section class="front--featured-news--copy">{{ content.body }}</section>
      <a href="{{ url }}"><p class="mt-4 mb-0"><span class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Read more</span></p></a>
    </div>
  </div>
  <div class="col-12 col-lg-5">
    <div class="row justify-content-center">

      <div class="row">
        <img class="col-4" src="/{{ directory }}/images/magazine-discovery-desktop.png" alt='magazine cover' class="img-fluid mt-1">
        <div class="col-8">Stay up-to-date on the latest research effrots from the Carlson School’s world-class faculty.</div>
      </div>

      <div class="row">
        <img class="col-4"src="/{{ directory }}/images/magazine-discovery-desktop.png" alt='magazine cover' class="img-fluid mt-1">
        <div class="col-8">Stay up-to-date on the latest research effrots from the Carlson School’s world-class faculty.</div>
      </div>

      <div class="row">
        Browse Events
      </div>
      <div class="row">
        Make Media Request
      </div>
    </div>
  </div>  
</article>
