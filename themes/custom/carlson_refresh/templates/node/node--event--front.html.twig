  {% if content.field_event_date|field_value is not empty %}
    {% set timestamp = content.field_event_date.0.start_date['#attributes']['datetime'] %}
    {% set month = timestamp|date('M') ~ '.' %}
    {% if month == 'Mar.'%}
      {% set month = 'March' %}
    {% endif %}
    {% if month == 'Apr.'%}
      {% set month = 'April' %}
    {% endif %}
    {% if month == 'Jun.'%}
      {% set month = 'June' %}
    {% endif %}
    {% if month == 'Jul.'%}
      {% set month = 'July' %}
    {% endif %}
    {% if month == 'Sep.'%}
      {% set month = 'Sept.' %}
    {% endif %}

    <div class="bg-gold px-7 py-5 d-flex flex-column align-items-start h-100 stretched-link-container">
      <a href="{{ url }}" class="stretched-link"><span class="sr-only"> Event on {{ timestamp|date('F j') }}: {{ label|render|striptags }}</span></a>
      <span class="fs-24 font-weight-semi-bold text-uppercase mb-4">Event</span>
      <p class="mb-4 h3"><em>{{ month }} {{ timestamp|date('j') }}</em></p>
      <h3 class="h4 flex-grow-1 mb-4 text-body">{{ label }}</h3>
      <span class="btn btn-primary btn-md" aria-hidden="true">Read More</span>
    </div>
  {% endif %}
