  {% if content.field_event_date|field_value is not empty %}
    <div class="bg-gold px-7 py-5 d-flex flex-column align-items-start h-100">
      <span class="fs-24 font-weight-semi-bold text-uppercase mb-4">Event</span>
      {% set timestamp = content.field_event_date.0.start_date['#attributes']['datetime'] %}
      {% set month = timestamp|date('M') ~ '.' %}
      {% if month == 'Mar.'%}
        {% set month = 'March' %}
      {% endif %}
      {% if month == 'Apr.'%}
        {% set month = 'April' %}
      {% endif %}
      {% if month == 'Jun.'%}
        {% set month = 'June' %}
      {% endif %}
      {% if month == 'Jul.'%}
        {% set month = 'July' %}
      {% endif %}
      {% if month == 'Sep.'%}
        {% set month = 'Sept.' %}
      {% endif %}
      <p class="mb-4 h3"><em>{{ month }} {{ timestamp|date('j') }}</em></p>
      <h3 class="h4 flex-grow-1 mb-4">{{ label }}</h3>
      <a class="btn btn-primary px-3 py-2 lh-1" href="{{ url }}">Read More</a>
    </div>
  {% endif %}
