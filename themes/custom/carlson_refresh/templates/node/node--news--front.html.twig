<div class="row no-gutters justify-content-center stretched-link-container">
  <div class="col-12 col-md-6">
    <div class="embed-responsive embed-responsive-11by7 position-static">
      {{ content.field_hero_media }}
    </div>
  </div>
  <div class="col-12 col-md-6 p-6 p-md-10 d-flex flex-column align-items-start justify-content-between bg-ivory position-static">
    <span class="fs-24 font-weight-semi-bold text-uppercase mb-4">News</span>
    <h3 class="mb-4 fs-40">
      <a href="{{ url }}" class="stretched-link text-body text-decoration-none">{{ label|render|striptags }}</a>
    </h3>
    <span class="btn btn-primary btn-md" aria-hidden="true">Read More</span>
  </div>
</div>
