{#{{ attach_library('bootstrap_barrio/node') }}#}
{{ attach_library('carlson_refresh/magazine') }}

{% set magazine = content.field_magazine_publication['#items'].getString() %}

<section class="mt-5 mb-5 row justify-content-center">
  <div class="col-12 col-lg-8 p-4 mt-5 magazine--promobar">
    <div class="row">
      <div class="col-12">
        {% if content.field_magazine_cover_image|render is not empty %}
        <img
          src="{{ content.field_magazine_cover_image|render|striptags }}"
          class="img-fluid float-left magazine--cover-angle"
          alt='{{ label|field_value }} {% if magazine == "alumni" %}alumni {% elseif magazine == "discovery" %}Discovery {% endif %}magazine cover' >
        {% endif %}
        <h2>This article appeared in the {{ label }} {% if magazine == "alumni" %}alumni {% elseif magazine == "discovery" %}Discovery {% endif %}magazine</h2>
        {{ content.field_teaser }}
        <p class="text-right mb-1 pb-0"><a href="{{ url }}" class="btn maroon-solid-button btn-sm py-2 px-3">{{ label }} table of contents <i class="fas fa-angle-right"></i></a></p>
        {# <p class="text-right mb-0 pb-0"><a href="http://magazine.case.org/survey/index.cfm/event/home/key/9B922AE0-16B6-4E56-9B1B20F4EB6585C4" class="btn maroon-solid-button btn-sm py-2 px-3">Tell us what you think <i class="fas fa-angle-right"></i></a></p> #}
      </div>
    </div>
  </div>
</section>
