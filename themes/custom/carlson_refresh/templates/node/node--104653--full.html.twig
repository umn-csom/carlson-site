{#{{ attach_library('bootstrap_barrio/node') }}#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix'
  ]
%}
<section class="row basic-page__content">
  <div class="col-12 main-content basic-page__content--inner">

    {# Inner node region for blocks #}
    {% if node_top %}
      {{ node_top }}
    {% endif %}

    {# Home Flexible feature paragraphs #}
    {% if content.body|render is not empty %}
    <div class="row component-paragraph">
      <div class="col-12">
        {{ content.body }}
      </div>
    </div>
    {% endif %}

    {# Inner node region for blocks #}
    {% if node_content %}
      {{ node_content }}
    {% endif %}

    {{ content.field_flexible_features }}

    {% if node_middle %}
      {{ node_middle }}
    {% endif %}

    {{ content.field_contact_info }}

    {% if node_bottom %}
      {{ node_bottom }}
    {% endif %}

    {# Bottom node region for blocks #}
    <div class="row node__bottom">
      {% apply spaceless %}
        <div class="node__bottom__col">
          {{ node_bottom_left }}
        </div>
        <div class="node__bottom__col">
          {{ node_bottom_right }}
        </div>
      {% endapply %}
    </div>
  </div>
</section>
