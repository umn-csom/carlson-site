{{ attach_library('carlson_refresh/accordion') }}
{%
    set accordion_data_sample = [
        {
            'label': 'Item 1',
            'markup': '<li>Item 1 - Sub Item 1</li><li>Item 1 - Sub Item 2</li><li>Item 1 - Sub Item 3</li>',
            'wrapper': '<ul class="something">'
        },
        {
            'label': 'Item 2',
            'markup': '<li>Item 2 - Sub Item 1</li>',
            'wrapper': '<ul class="something">'
        }
    ]
%}

{% if accordion_data is empty %}
    {% set accordion_data = accordion_data_sample %}
{% endif %}

<div class="accordion" id="accordion-list">
    {% set inc = 0 %}
    {% for item in accordion_data %}
        {% set collapsed = 'collapsed' %}
        {% set expanded = 'false' %}
        {% set show = '' %}
        <div class="accordion-item">
            <button id="heading{{ inc }}"
                class="accordion-button {{ collapsed }}"
                type="button"
                data-toggle="collapse"
                data-target="#collapse{{ inc }}"
                aria-expanded="{{ expanded }}"
                aria-controls="collapse{{ inc }}">
                {{ source('@carlson_refresh/../images/svg/plus.svg') }}
                {{ source('@carlson_refresh/../images/svg/minus.svg') }}
                {{ item.label }}
            </button>
            <div id="collapse{{ inc }}"
                class="accordion-content collapse {{ show }}"
                aria-labelledby="heading{{ inc }}"
                data-parent="#accordion-list"
                role="region">
                <div class="accordion-content-inner">
                    {{ item.wrapper|raw }}
                    {{ item.markup|raw }}
                </div>
            </div>
        </div>
        {% set inc = inc+1 %}
    {% endfor %}
</div>
