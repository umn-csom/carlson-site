{#
/**
 * @file
 * Template for the Alumni Default page.
 */
#}
{{ attach_library('carlson_refresh/alumni-landing-page') }}

{% include directory ~ '/templates/layout/_campaign-header-shell.html.twig' %}

<main role="main" aria-label="Primary content area">
{% if page.local_tasks %}
  {{ page.local_tasks }}
{% endif %}

{# Only rendered if something is placed in this region #}
{% if page.highlighted %}
  <div class="highlighted">
    <aside class="{{ container }} section clearfix" role="complementary">
      {{ page.highlighted }}
    </aside>
  </div>
{% endif %}

{% if page.breadcrumb %}
{{ page.breadcrumb }}
{% endif %}

{# Start of main page wrapper #}
{% block content %}
<a id="main-content" tabindex="-1"></a>
{{ page.content }}
{% endblock %}
{# End of the main page wrapper #}
</main>

{# Beginning of footer #}
<footer role="contentinfo" aria-label="Site links and info">
{% include '@carlson_refresh/includes/footer.html.twig' %}

{% include directory ~ '/templates/layout/umn-footer.html.twig' %}
</footer>
