{#
/**
 * @file
 * Template for the Alumni Default page.
 */
#}
{{ attach_library('carlson_refresh/alumni-landing-page') }}

<header role="banner" aria-label="Site header" class="umnhf-hw">
{% include directory ~ '/templates/layout/umn-header.html.twig' %}
{% if page.header %}
  {{ page.header }}
{% endif %}
</header>

<div id="sticky-top-sentinel" style="height: 1px;"></div>
<div role="region" aria-label="Site navigation" class="sticky-top site-nav">
{% if page.navbar_primary %}
  {{ page.navbar_primary }}
{% endif %}
{% if page.navbar_secondary %}
  {{ page.navbar_secondary }}
{% endif %}
</div>

<main role="main" aria-label="Primary content area">
{% if page.local_tasks %}
  {{ page.local_tasks }}
{% endif %}

{# Only rendered if something is placed in this region #}
{% if page.highlighted %}
  <div class="highlighted">
    <aside class="{{ container }} section clearfix" role="complementary">
      {{ page.highlighted }}
    </aside>
  </div>
{% endif %}

{% if page.breadcrumb %}
{{ page.breadcrumb }}
{% endif %}

{# Start of main page wrapper #}
{% block content %}
<a id="main-content" tabindex="-1"></a>
{{ page.content }}
{% endblock %}
{# End of the main page wrapper #}
</main>

{# Beginning of footer #}
<footer role="contentinfo" aria-label="Site links and info">
{% include '@carlson_refresh/includes/footer.html.twig' %}

{% include directory ~ '/templates/layout/umn-footer.html.twig' %}
</footer>
