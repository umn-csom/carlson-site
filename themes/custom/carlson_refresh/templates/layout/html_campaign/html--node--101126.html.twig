{%
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'page-node-type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
    theme.settings.navbar_position ? 'navbar-is-' ~ theme.settings.navbar_position,
    theme.has_glyphicons ? 'has-glyphicons',
  ]
%}
<!DOCTYPE html>
<html {{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>




    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">

      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jquery-jvectormap-2.0.3.css" type="text/css" media="screen"/>
      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jvectormap-custom.css" type="text/css" media="screen"/>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-2.0.3.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-africa-mill.js"></script>


  </head>
  <body{{ attributes.addClass(body_classes) }}>
    <div id="skip">
      <a href="#main-content" class="sr-only focusable skip-link">
        {{ 'Skip to main content'|t }}
      </a>
    </div>

    {{ page_top }}
    {{ page }}
    {{ page_bottom }}


<!--start AFRICA -->
<script>

var  markers = [
  {latLng: [5.6, -0.19], name: 'Accra', dates: 'October 14', weburl : "/events/ontheroad_accra"},
  {latLng: [-26.20, 28.05], name: 'Johannesburg', dates: 'October 7', weburl : "/events/ontheroad_johannesburg"},
  {latLng: [6.52, 3.38], name: 'Lagos', dates: 'October 12', weburl : "/events/ontheroad_lagos"},
  {latLng: [-1.29, 36.82], name: 'Nairobi', dates: 'October 10', weburl : "/events/ontheroad_nairobi"},
];



  $(function(){
    $('#africamap').vectorMap({
      map: 'africa_mill',
      normalizeFunction: 'polynomial',
      backgroundColor: 'transparent',
      regionStyle: {
        initial: {
          fill: '#f9f7f6',
        },
      },
      series: {
        regions: [{
          values: {
            'NG': '#ffde7a',
            'GH': '#ffde7a',
            'KE': '#ffde7a',
            'ZA': '#ffde7a',
          },
          attribute: 'fill'
        }]
      },
      markerStyle: {
          initial: {
              fill: '#900021',
              "fill-opacity": 1,
              "stroke-width": 0,
              "stroke-opacity": 1,
              r: 8,
          },
          hover: {
            fill: '#7a0019',
          }
      },
      onMarkerClick: function(event, index) {
          alert(markers[index].weburl);
      },
      markers: markers,
      onMarkerClick: function(events, index) {
        $(location).attr('href',markers[index].weburl);
      },
      onMarkerTipShow: function (e, el, code) {
        var markers = $('#africamap').vectorMap('get', 'mapObject').markers;
        if (typeof markers[code].config.dates !== 'undefined') {
          el.html(el.html() + '<br /><span class="mapdate">' + markers[code].config.dates + '</span>');
        } else {
          el.html(el.html());
        }
      },
      labels: {
        regions: false
      },
      onRegionOver: function (event, code, region) {
        if (activeNations.indexOf(code) === -1) {
          event.preventDefault();
        }
      },
      zoomButtons: false,
      zoomOnScroll: false,
      panOnDrag: false,
    });
  });
</script>

<!--end-->





<js-bottom-placeholder token="{{ placeholder_token|raw }}">

