{#
/**
 * @file
 * Template for the paid media page.
 */
#}
{# Header that contains main menu/branding #}
<header id="header" class="header carlson-header" role="banner" aria-label="{{ 'Site header'|t}}">
  {# Add in Carlson inverted logo #}
</header>

<main>
{% if page.local_tasks %}
  {{ page.local_tasks }}
{% endif %}

{# Start of main page wrapper #}
<div id="main-wrapper" class="layout-main-wrapper clearfix">
  {% block content %}
    <div id="main" class="container">
      <div class="row row-offcanvas row-offcanvas-left clearfix">
        <main{{ content_attributes }}>
            <a id="main-content" tabindex="-1"></a>
            {# Node templates are rendered here #}
            {{ page.content }}
        </main>
      </div>
    </div>
  {% endblock %}
</div>
{# End of the main page wrapper #}
</main>

{# Beginning of footer #}
{% include '@carlson_refresh/includes/footer.html.twig' %}

{% include directory ~ '/templates/layout/umn-footer.html.twig' %}
