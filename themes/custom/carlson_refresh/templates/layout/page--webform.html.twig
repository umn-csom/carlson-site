{#
/**
 * @file
 * Template for the webform page.
 */
#}
<header role="banner" aria-label="Site header" class="umnhf-hw">
{% include directory ~ '/templates/layout/umn-header.html.twig' %}
{% if page.header %}
  {{ page.header }}
{% endif %}
</header>

<div id="sticky-top-sentinel" style="height: 1px;"></div>
<div role="region" aria-label="Site navigation" class="sticky-top site-nav">
{% if page.navbar_primary %}
  {{ page.navbar_primary }}
{% endif %}
{% if page.navbar_secondary %}
  {{ page.navbar_secondary }}
{% endif %}
</div>

<main role="main" aria-label="Primary content area">
{% if page.local_tasks %}
  {{ page.local_tasks }}
{% endif %}

{# Only rendered if something is placed in this region #}
{% if page.highlighted %}
  <div class="highlighted">
    <aside class="{{ container }} section clearfix" role="complementary">
      {{ page.highlighted }}
    </aside>
  </div>
{% endif %}

{# Only rendered if something is placed in this region #}
{% if page.featured_top %}
  {% block featured %}
    <div class="featured-top">
      <aside class="featured-top__inner section {{ container }} clearfix" role="complementary">
        {{ page.featured_top }}
      </aside>
    </div>
  {% endblock %}
{% endif %}

{% if page.breadcrumb %}
{{ page.breadcrumb }}
{% endif %}

{# Start of main page wrapper #}
<div id="main-wrapper" class="layout-main-wrapper clearfix">
  {% block content %}
    <div id="main" class="container">
      <div class="row row-offcanvas row-offcanvas-left clearfix">
        <main{{ content_attributes }}>
          <section class="section">
            <a id="main-content" tabindex="-1"></a>
            {{ page.page_title }}

            {{ page.content }}
          </section>
        </main>
        {% if page.sidebar_first %}
          <div{{ sidebar_first_attributes }}>
            <aside class="section" role="complementary">
              {{ page.sidebar_first }}
            </aside>
          </div>
        {% endif %}
        {% if page.sidebar_second %}
          <div{{ sidebar_second_attributes }}>
            <aside class="section" role="complementary">
              {{ page.sidebar_second }}
            </aside>
          </div>
        {% endif %}
      </div>
    </div>
  {% endblock %}
</div>
{# End of the main page wrapper #}

{# Only rendered if something is placed in this region #}
{% if page.featured_bottom_first or page.featured_bottom_second or page.featured_bottom_third %}
  <div class="featured-bottom">
    <aside class="{{ container }} clearfix" role="complementary">
      {{ page.featured_bottom_first }}
      {{ page.featured_bottom_second }}
      {{ page.featured_bottom_third }}
    </aside>
  </div>
{% endif %}
</main>

{# Beginning of footer #}
<footer role="contentinfo" aria-label="Site links and info">
{% include '@carlson_refresh/includes/footer.html.twig' %}

{% include directory ~ '/templates/layout/umn-footer.html.twig' %}
</footer>
