{#
/**
 * @file
 * Default theme implementation to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 *
 * @ingroup themeable
 */
#}
<div class="d-none d-lg-block">
  <div class="container-fluid container-xl pl-0">
    {# <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCarlson" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button> #}
    <div class="collapse navbar-collapse" id="navbarCarlson">
      {% import _self as menus %}
      {{ menus.menu_links(items, attributes, 0, false) }}

      {% macro menu_links(items, attributes, menu_level, last_parent) %}
        {% import _self as menus %}
        {% if items %}
          {% if menu_level == 0 %}
            <ul class="navbar-nav  navbar-nav--primary" >
          {% else %}
            <ul class="dropdown-animate dropdown-slide dropdown-menu dropdown-menu-left" >
          {% endif %}
              {% for item in items %}
              {% set last = last_parent or (menu_level == 0 and loop.last) %}
              {% set is_top_level = menu_level == 0 %}
              {% set is_sub_level = menu_level > 0 %}
              {%
                set item_classes = [
                  'nav-item',
                  item.below ? 'dropdown',
                  item.below and is_sub_level ? 'dropdown-submenu',
                  item.below and is_sub_level and last ? 'dropleft',
                  item.below and is_sub_level and not last ? 'dropright',
                  item.in_active_trail ? 'is-active-trail',
                ]
              %}
              {%
                set link_classes = [
                  is_top_level ? 'nav-link' : 'dropdown-item',
                  is_top_level and item.below and is_link ? 'is-unreachable',
                  item.below and is_sub_level ? 'dropdown-toggle',
                  item.in_active_trail ? 'is-active-trail',
                ]
              %}
              {% set link_attrs = {
                'class': link_classes,
              } %}
              {% if item.below %}
                {% set link_attrs = link_attrs|merge({
                  'role': 'button',
                  'data-toggle': 'dropdown',
                  'aria-haspopup': 'true',
                  'aria-expanded': 'false',
                }) %}
                  {% if is_top_level %}
                    <li{{ item.attributes.addClass(item_classes) }}>
                      {{ link(item.title, item.url, link_attrs) }}
                      {{ menus.menu_links(item.below, attributes, menu_level + 1, last) }}
                    </li>
                  {% else %}
                    <li{{ item.attributes.addClass(item_classes) }}>
                      {{ link(item.title, item.url, link_attrs) }}
                      {{ menus.menu_links(item.below, attributes, menu_level + 1, last) }}
                    </li>
                  {% endif %}
                {% else %}
                  <li{{ item.attributes.addClass(item_classes) }}>
                    {{ link(item.title, item.url, link_attrs) }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        {% endmacro %}
      </div>
    </div>
  </div>
<!-- end navbar -->
