{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{#{{ attach_library('bootstrap_barrio/breadcrumb') }}#}

{% if breadcrumb %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {% for item in breadcrumb %}
            {% if item.text%}
            {
              "@type": "ListItem",
              "position": {{ loop.index }},
              "item":
                {
                  "@id": "{{ url('<front>')|render|split('/', -1)|join('/') ~ item.url }}",
                  "name": "{{ item.text }}"
                }
            {% if loop.last %}
            }
            {% else %}
            },
            {% endif%}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>


  <nav role="navigation" aria-label="breadcrumb">
    <ol class="breadcrumb">
    {% for item in breadcrumb %}
      <li class="breadcrumb-item text-uppercase">
        {% if not loop.last %}
          <small><a href="{{ item.url }}">{{ item.text }}</a></small>
        {% else %}
          <small>{{ item.text }}</small>
        {% endif %}
      </li>
    {% endfor %}
    </ol>
  </nav>
{% endif %}
