{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{#{{ attach_library('bootstrap_barrio/breadcrumb') }}#}

{% if breadcrumb %}
  {% if breadcrumb|length == 1 and breadcrumb[0].url == '/' %}
    {% set breadcrumb = breadcrumb|merge([{'text': drupal_token('current-page:title'), 'url': path('<current>')}]) %}
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {% for item in breadcrumb %}
          {% if item.text %}
            {
              "@type": "ListItem",
              "position": {{ loop.index }},
              "item": {
                "@id": "{{ url('<front>')|render|split('/', -1)|join('/') ~ item.url }}",
                "name": "{{ item.text }}"
              }
            {% if loop.last %}
            }
            {% else %}
            },
            {% endif %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>

  {% if breadcrumb|length > 0 %}
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        {% for item in breadcrumb %}
          <li class="breadcrumb-item">
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.text|raw }}</a>
            {% else %}
              <span>{{ item.text|raw }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% endif %}
{% endif %}