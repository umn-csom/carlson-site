{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  {% if breadcrumb|length == 1 and breadcrumb[0].url == '/' %}
    {% set breadcrumb = breadcrumb|merge([{'text': drupal_token('current-page:title'), 'url': path('<current>')}]) %}
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {% for item in breadcrumb %}
          {% if item.text %}
            {
              "@type": "ListItem",
              "position": {{ loop.index }},
              "item": {
                "@id": "{{ url('<front>')|render|split('/', -1)|join('/') ~ item.url }}",
                "name": "{{ item.text }}"
              }
            {% if loop.last %}
            }
            {% else %}
            },
            {% endif %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>

  {% set has_url = false %}
  {% for item in breadcrumb %}
    {% if item.url %}
      {% set has_url = true %}
    {% endif %}
  {% endfor %}

  {% if has_url %}
    {{ attach_library('carlson_refresh/crumbs') }}
    <nav class="crumbs" aria-label="breadcrumb">
      <ol>
        {% apply spaceless %}
          {% for item in breadcrumb %}
          <li>
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.text|raw }}</a>
            {% else %}
              <span>{{ item.text|raw }}</span>
            {% endif %}
          </li>
          {% endfor %}
        {% endapply %}
      </ol>
    </nav>
  {% endif %}
{% endif %}
