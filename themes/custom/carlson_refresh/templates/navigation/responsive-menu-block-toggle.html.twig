{#
/**
 * @file
 * Template to output the menu toggle icon (burger).
 */
#}
<a id="toggle-icon" class="menu-toggle menu-toggle--mobile-flyout d-lg-none" title="Menu" href="#off-canvas">
  <span class="menu-toggle__button menu-toggle__button--mobile-flyout">
    <span class="menu-toggle__label">{{ 'Menu'|t }}</span>
    <span class="menu-toggle__icon">
      {{ source(theme_directory ~ '/images/svg/icon-menu-search.svg') }}
    </span>
  </span>
</a>
