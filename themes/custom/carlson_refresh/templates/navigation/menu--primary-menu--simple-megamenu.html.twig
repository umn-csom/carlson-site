<div class="container-fluid container-xl pl-0">
  {% import _self as menus %}

  {#
    We call a macro which calls itself to render the full tree.
    @see http://twig.sensiolabs.org/doc/tags/macro.html
  #}
  {{ attach_library('simple_megamenu/base') }}
  {% set attributes = create_attribute() %}
  {{ menus.menu_links(items, 'navbar-nav', 0) }}

  {% macro menu_links(items, classes, menu_level) %}
    {% import _self as menus %}
    {% if items %}
      <ul class="{{ classes }}" role="menu">
      {% for item in items %}
        {%
          set classes = [
            'nav-item',
            item.below ? 'dropdown',
            item.below and has_megamenu(item.url) ? 'dropdown--mega-menu',
            item.in_active_trail ? 'active',
            not menu_level == 0 and not has_megamenu(item.url) ? 'dropright dropdown-submenu'
          ]
        %}
        <li{{ item.attributes.addClass(classes) }}>
        {% if item.below %}
          {% if has_megamenu(item.url) %}
            <a href="{{ item.url }}" class="nav-link" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ item.title }}</a>
            <div class="navbar-primary--animate navbar-primary--slide dropdown-menu dropdown-menu--mega-menu dropdown-menu-left" role="menu">
              <div class="mega-menu-background"></div>
              {{ view_megamenu(item.url, 'before') }}
              {# {{ menus.menu_links(item.below, 'sub-menu', menu_level + 1) }} #}
              {# {{ view_megamenu(item.url, 'after') }} #}
            </div>
          {% elseif menu_level == 0 %}
            <a href="{{ item.url }}" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link" >{{ item.title }}</a>
            {{ menus.menu_links(item.below, 'navbar-primary--animate navbar-primary--slide dropdown-menu dropdown-menu-left', menu_level + 1) }}
          {% else %}
            <a href="{{ item.url }}" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="dropdown-item dropwdown-dark dropdown-toggle">{{ item.title }}</a>
            {% set attrs = create_attribute() %}
            {{ menus.menu_links(item.below, 'navbar-primary--animate navbar-primary--slide dropdown-menu dropdown-menu-left', menu_level + 1) }}
          {% endif %}
        {% else %}
          <a href="{{ item.url }}" class="{% if menu_level == 0 %}nav-link{% else %}dropdown-item{% endif %}">{{ item.title }}</a>
        {% endif %}
        </li>
        {# <li{{item.attributes.addClass(classes)}}>
          {{ link(item.title, item.url) }}
          {% if item.below %}
            {% if has_megamenu(item.url) %}
              <div class="mega-menu-wrapper">
                <div class="mega-menu-background"></div>
                {{ view_megamenu(item.url, 'before') }}
                {{ menus.menu_links(item.below, attributes.addClass('mega-menu-item'), menu_level + 1) }}
                {{ view_megamenu(item.url, 'after') }}
              </div>
            {% else %}
              {{ menus.menu_links(item.below, attributes.removeClass('mega-menu-item'), menu_level + 1) }}
            {% endif %}
          {% endif %}
        </li> #}
      {% endfor %}
      </ul>
    {% endif %}
  {% endmacro %}
</div>
