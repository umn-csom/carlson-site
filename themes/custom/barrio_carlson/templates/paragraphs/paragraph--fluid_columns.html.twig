
{% block paragraph %}
{# set paragraph_parent = paragraph.getParentEntity() %}
{% for key in paragraph_parent.parent_field_name|keys %}
	<p>{{ key }}</p>
{% endfor #}
<p></p>
    {% block content %}
	<div class="container">
      <div class="row component-paragraph fluid-columns">
		    {% if content.field_column_item is not empty %}
		      {% set data = content.field_column_item|field_value %}
		      {% set len = data|length %}
		      {% set divide = 12/len %}

		      {% for key,value in data %}
		        <div class="col-md-{{ divide }} fluid-columns__item">
		          {{ data[key] }}
		        </div>
		      {% endfor %}
		    {% endif %}  
		  </div>
		</div>
    {% endblock %}
{% endblock paragraph %}