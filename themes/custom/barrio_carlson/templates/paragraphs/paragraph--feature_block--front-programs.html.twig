{% set content_data = {
  'image': content.field_image | field_value,
  'heading': content.field_heading,
  'markup': content.field_main_content,
  'link': content.field_link
} %}

{% block paragraph %}
  {% block content %}
        <div class="col-12 col-sm-6 col-md-5 col-xl-3 mb-5 mb-xl-0">
          <h3 class="front--programs--block--heading m-0 mb-3">
            {{ content.field_heading }}
          </h3>
          <div class="front--programs--block-img">
            <a href="{{ content.field_link.0['#url'] }}">{{ content.field_image|field_value }}</a>
          </div>
            <div class="front--programs--block-text mt-2"><a href="{{ content.field_link.0['#url'] }}">
          {{ content.field_main_content }}
        </a></div>
          <p class="mb-0 mt-3 text-right"><a href="{{ content.field_link.0['#url'] }}" class="front--programs--block-button">{{ content.field_link.0['#title'] }} <i class="fas fa-arrow-right fa-sm"></i></a></p>
        </div>
  {% endblock %}
{% endblock paragraph %}
