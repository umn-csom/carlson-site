{% set content_data = {
  'image': content.field_image|field_value,
  'heading': content.field_heading, 
  'markup': content.field_main_content, 
  'link': content.field_link, 
  }
%} 

{% block paragraph %}
    {% block content %}
			<div class="row component-paragraph feature-block">
		    <div class="col-md-6 pr-md-0 feature-block__img">
		      {{ content_data['image']|raw }}
		    </div>
		    <div class="col-md-6 pl-md-0 feature-block__content">
		    	<div class="feature-block__content--inner">
			      <h3 class="feature-block__content--title">{{ content_data['heading'] }}</h3>
			      {{ content_data['markup']|raw }}
			      <span class="feature-block__content--link">{{ content_data['link']|raw }}</span>
			    </div>
		    </div>
		  </div>
    {% endblock %}
{% endblock paragraph %}
