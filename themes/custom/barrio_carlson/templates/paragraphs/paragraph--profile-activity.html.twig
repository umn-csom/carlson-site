{% block paragraph %}
    <li class="faculty-profile__activity">
        {% block content %}
            <div class="faculty-profile__activity--title">
                {% if content.field_activity_link[0]['#url'] is not empty %}
                    <a href="{{ content.field_activity_link[0]['#url'] }}"
                        alt="{{ content.field_activity_link[0]['#title'] }}">
                        {{ paragraph.field_activity_type.entity.name.value }}
                    </a>
                {% else %}
                    {{ content.field_activity_type|field_value }}
                {% endif %}
            </div>
            <div class="faculty-profile__activity--desc">
                {{ content.field_activity_description|field_value }}
            </div>
        {% endblock %}
    </li>
{% endblock paragraph %}