{% if content.field_image|field_value is not empty %}
  {% set img = content.field_image %}
{% else %}
  {% set img = NULL %}
{% endif %}

{% block paragraph %}
  {% block content %}
    {% include directory ~ '/templates/components/column.html.twig' with 
      {
        'column_imgsrc': img|field_value, 
        'column_heading': content.field_heading|field_value,
        'column_markup': content.field_main_content|field_value,
        'column_link': content.field_link|field_value,
      } 
    %}
  {% endblock %}
{% endblock paragraph %}

