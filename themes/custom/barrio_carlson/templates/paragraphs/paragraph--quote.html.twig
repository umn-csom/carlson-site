{% if content.field_quote_image|field_value is not empty %}
  {% set img = content.field_quote_image %}
{% else %}
  {% set img = NULL %}
{% endif %}

{% block paragraph %}
  {% block content %}
    {% include directory ~ '/templates/components/quote.html.twig' with 
      {
        'img_src': img, 
        'quote_text': content.field_quote_text,
        'quote_source': content.field_quote_source,
      } 
    %}
  {% endblock %}
{% endblock paragraph %}
