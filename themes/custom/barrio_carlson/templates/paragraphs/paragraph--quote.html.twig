
{% block paragraph %}
  {% block content %}
    <div class="row quote">
      <div class="col-12 text-center">
        <div class="quote__img">
          {% if content.field_quote_image|field_value is not empty %}
            {{ content.field_quote_image }}
          {% endif %}
          <div class="quote__img--icon">“</div> 
        </div>
        <div class="quote__text">
            <p>"{{ content.field_quote_text|render|striptags }}"</p>
        </div>
        <div class="quote__source">
          {{ content.field_quote_source|render|striptags }}
        </div>
      </div>
    </div>
  {% endblock %}
{% endblock paragraph %}
