<section>
    <div class="bs-component hero-basic">
      <div class="col-md-12 img-wrapper">
        {% if img_src is defined %}
         {{ img_src | raw }}
        {% else %}
          <img src="{{ base_path ~ directory }}/images/placeholders/full-width-hero-image-1600x512.jpg"/>
        {% endif %}
      </div>
      <div class="col-10 col-md-10 content-wrapper">
        <h1>{{ heading | default('Using Business to Fight for Human Rights')}}</h1>
        <div class="row">
          <div class="col col-sm-12 col-md-6 d-none d-sm-block post-col">
            <p><span class="date">{{ published_on | default('October 10, 2017') }}</span> - <span class="author">By {{ author | default('Jonathan Smith') }}</span></p>
          </div>
          <div class="col col-sm-12 col-md-6 d-none d-sm-block share-col">
            <p class="share-this">Share This</p>
          </div>
        </div>
      </div>
    </div>
</section>
