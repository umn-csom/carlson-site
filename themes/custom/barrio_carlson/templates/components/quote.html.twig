{% if content is empty %}
	{% set img_src = '<img src="http://placekitten.com/592/412" />' %}
	{% set quote_text = '<p>This is a quote from a source about how great the program is.</p>' %}
	{% set quote_source = 'John Doe' %}
{% endif %}

<div class="quote">
	<div class="text-center">
		<div class="quote__img">
			{% if img_src is defined %}
				{{ img_src|raw }}
			{% endif %}
		</div>
		<div class="quote__text">
			{{ quote_text|raw }}
		</div>
		<div class="quote__source">
			{{ quote_source }}
		</div>
	</div>
</div>
