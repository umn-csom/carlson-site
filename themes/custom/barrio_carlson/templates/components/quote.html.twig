<div class="row quote">
	<div class="col-6 col-centered text-center">
		<div class="quote__img">
			{% if img_src is defined %}
				{{ img_src }}
			{% else %}
				<img src="http://placekitten.com/592/412" />
			{% endif %}
		</div>
		<div class="quote__text">
			{{ quote_text | default('<p>This is a quote from a source about how great the program is.</p>')|raw }}
		</div>
		<div class="quote__source">
			{{ quote_source | default('John Doe') }}
		</div>
	</div>
</div>
