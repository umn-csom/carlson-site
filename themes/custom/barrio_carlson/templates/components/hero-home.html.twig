{%
    set content_sample = {
          'heading': '<img src="/sites/default/themes/custom/barrio_carlson/images/placeholders/full-width-hero-image-1600x512.jpg"/>',
          'sub_head': 'A caption about the video here',
        }
%}

{% if content_data is empty %}
    {% set content_data = content_sample %}
{% endif %}

<div class="home-hero">
  <div class="row">
          <h2>{{ heading | default('A Heading here')}}</h2>
      
          {{ sub_head | default('<p>A sub-heading text that is longer goes here.</p>') | raw }}
        
        {% if img_src is defined %}
          {{ img_src | raw }}
        {% else %}
          <img class="img-fluid" src="{{ base_path ~ directory }}/images/placeholders/home-hero-image-1290x500.jpg"/>
        {% endif %}

</div>
