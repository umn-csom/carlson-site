<section>
  <div class="row">
    {% if content is defined %}
      {% set data = content|field_value %}
      {% set len = data|length %}
      {% set divide = 12/len %}

      {% for key,value in data %}
        <div class="col-lg-{{ divide }}">
          {{ data[key] }}
        </div>
      {% endfor %}
    {% endif %}  
  </div>
</section>