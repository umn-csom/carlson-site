<div class="row stats">
  <div class="col-12">
    <h2 class="stats__heading text-center">{{ heading | default('Results that stand out')}}</h2>
  </div>
  <div class="col-md-8 offset-md-2 text-center">
    <p>{{ sub_head | default('<p>But don’t just take our word for it, the facts speak for themselves. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec risus urna, lacinia non magna ut, commodo ultrices risus.</p>') | raw }}</p>
  </div>
  <div class="col-12">
    <div class="row stats__blocks">
      {% if content is defined %}
        {{ content }}
      {% endif %}

      {% if content is empty %}
        <div class="col-md">
          <div class="stats__single text-center">
            <label class="stats__single-value">96%</label>
            <p class="stats__single-desc">96% of graduates received job offers 90 days after graduation.<p>
          </div>
        </div>
        <div class="col-md">
          <div class="stats__single text-center">
            <label class="stats__single-value">96%</label>
            <p class="stats__single-desc">96% of graduates received job offers 90 days after graduation.<p>
          </div>
        </div>
        <div class="col-md">
          <div class="stats__single text-center">
            <label class="stats__single-value">96%</label>
            <p class="stats__single-desc">96% of graduates received job offers 90 days after graduation.<p>
          </div>
        </div>        
      {% endif %}
    </div>
  </div>
</div>
