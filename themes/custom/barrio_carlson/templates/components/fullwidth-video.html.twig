{%
    set content_sample = {
          'thumb': '<img class="img-fluid" src="/sites/default/themes/custom/barrio_carlson/images/placeholders/full-width-hero-image-1600x512.jpg"/>',
          'caption': 'A caption about the video here',
          'video': '66',
        }
%}

{% if content_data is empty %}
    {% set content_data = content_sample %}
{% endif %}

<section>
  <div class="row fullwidth-video">
    <div class="fullwidth-video__wrapper">
      <div class="col-12">
         <div class="fullwidth-video__image">{{ content_data['thumb']|raw }}</div>
         <a class="use-ajax fullwidth-video__link" data-dialog-type="modal" href="/media/{{ content_data['video'] }}" data-dialog-options="{&quot;width&quot;:800}"><span class="play-btn">&gt;</span></a>
         <div class="fullwidth-video__caption">{{ content_data['caption']|raw }}</div>
      </div>
    </div>
  </div>
</section>