{%
    set content_sample = {
          'thumb': '<img src="/sites/default/themes/custom/barrio_carlson/images/placeholders/full-width-hero-image-1600x512.jpg"/>',
			    'caption': 'A caption about the video here',
			    'video': '66',
        }
%}

{% if content_data is empty %}
    {% set content_data = content_sample %}
{% endif %}

<section>
	<div class="row fullwidth-video">
		<div class="col-12">
			<a class="use-ajax video-full__link" data-dialog-type="modal" href="/media/{{ content_data['video'] }}" data-dialog-options="{&quot;width&quot;:800}">{{ content_data['thumb']|raw }}</a>
		  <caption class="video-full__caption">{{ content_data['caption']|raw }}</caption>
		</div>
	</div>
</section>