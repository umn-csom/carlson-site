{%
    set content_sample = {
            'heading': 'Find the MBA Program That’s Right for you.',
            'link': '<a href="#" class="">Learn More</a>',
        }
%}

{% if content is empty %}
    {% set content = content_sample %}
{% endif %}

<section>
  <div class="page-cta-container container-fluid">
    <div class="row">
      <div class="col-sm-9 page-cta-intro-container">
        <div class="page-cta-intro">
          <p>{{ content['heading'] }}</p>
        </div>
      </div>
      <div class="col-sm-3 page-cta-link-container">
        <div class="page-cta-link">
          {{ content['link']|raw }}
        </div>
      </div>
    </div>
  </div>
</section>