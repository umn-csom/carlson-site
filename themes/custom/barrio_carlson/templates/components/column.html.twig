{%
    set content_sample = {
            'image': '<img class="img-fluid" src="{{ base_path ~ directory }}/images/placeholders/1-2-3-List-Image-300x200.jpg"/>',
            'heading': 'Carlson Full time MBA',
            'markup': '<p>The Carlson School invites you to be and do something truly special. Belong to a unique community of inquisitive thinkers and engaged faculty who bring a wealth of experience to the program and bring out the best in one another. </p>',
            'link': '<a href="#" class="">Read More</a>',
        }
%}

{% if content_data is empty %}
    {% set content_data = content_sample %}
{% endif %}

<div class="col-md-4">
  <div class="column-container">
    {{ content_data['image'] }}
    <label>{{ content_data['heading'] }}</label>
    {{ content_data['markup']|raw }}
    {{ content_data['link'] }}
  </div>
</div>