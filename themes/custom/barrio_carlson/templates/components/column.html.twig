{% if content is empty %}
  {% set column_imgsrc = '<img src="http://placekitten.com/592/412" />' %}
  {% set column_heading = 'Carlson Full time MBA' %}
  {% set column_markup = '<p>The Carlson School invites you to be and do something truly special. Belong to a unique community of inquisitive thinkers and engaged faculty who bring a wealth of experience to the program and bring out the best in one another.</p>' %}
  {% set column_link = '<a href="#">Read More</a>' %}
{% endif %}

<div class="column">
  <div class="column__img">
    {% if column_imgsrc is defined %}
      {{ column_imgsrc|raw }}
    {% endif %}
  </div>
  <div class="column__heading">
    <h2>{{ column_heading }}</h2>
  </div>
  <div class="column__markup">
    {{ column_markup|raw }}
  </div>
  <div class="column__link">
    {{ column_link |raw }}
  </div>
</div>