{%
    set content_sample = {
            'image': '<img class="img-fluid" src="{{ base_path ~ directory }}/images/placeholders/program-hero-image-592x412.jpg"/>',
            'heading': 'Carlson Full time MBA',
            'markup': '<p>The Carlson School invites you to be and do something truly special. Belong to a unique community of inquisitive thinkers and engaged faculty who bring a wealth of experience to the program and bring out the best in one another. Become the leader you were meant to be through a wealth of opportunities beyond the classroom.</p>',
            'link': '<a href="#" class="">Apply Today</a>',
        }
%}

{% if hero_data is empty %}
    {% set hero_data = content_sample %}
{% endif %}

<div class="bs-component hero-program container-fluid">
  <div class="row">
    <div class="col-md-8 img-wrapper">
      {{ hero_data['image'] }}
    </div>
    <div class="col-md-4 col-sm-12 content-wrapper">
      <h1>{{ hero_data['heading'] }}</h1>
     
      {{ hero_data['markup'] }}
     
      <div class="cta-wrapper">
        <div class="cta-container">
          {{ hero_data['link'] }}
        </div>
      </div>
    </div>
  </div>
</div>
