{%
    set content_sample = {
          'contact_heading': 'Contact full-time MBA',
          'email':'<a href="#">ftmba@umn.edu</a>',
          'phone': '612-625-5555',
          'link': '<a class="contact-large-link" href="#">Request Information</a>',
          'social_heading': 'Find the MBA Program That’s Right for you.',
          'twitter': '<a href="#" class=""></a>',
          'facebook': '<a href="#" class=""></a>',
          'linkedin': '<a href="#" class=""></a>',
          'youtube': '<a href="#" class=""></a>',
        }
%}

{% if contact_data is empty %}
    {% set contact_data = content_sample %}
{% endif %}

<section>
  <div class="contact-cta container-fluid">
    <div class="cta-wrapper">
      <div class="row">
        <div class="col-sm-12 col-md-6 contact-col">
          <h5>{{ contact_data['contact_heading'] }}</h5>
          <ul class="list-inline">
            <li class="list-inline-item">Email: <a href="mailto:{{ content_data['email'] }}">{{ contact_data['email']|raw }}</a></li>
            <li class="list-inline-item">Phone: {{ contact_data['phone'] }}</li>
          </ul>
          {{ contact_data['link']|raw }}
        </div>
        <div class="col-sm-12 col-md-6 social-col">
          <div class="social-wrapper">
          <h5>{{ contact_data['social_heading'] }}</h5>
            <ul class="list-inline">
              <li class="list-inline-item">{{ contact_data['twitter']|raw }}</li>
              <li class="list-inline-item">{{ contact_data['facebook']|raw }}</li>
              <li class="list-inline-item">{{ contact_data['youtube']|raw }}</li>
              <li class="list-inline-item">{{ contact_data['linkedin']|raw }}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
