{%
    set content_sample = {
    			'heading': 'Some video Heading',
          'thumb': '<img class="img-fluid" src="/sites/default/themes/custom/barrio_carlson/images/placeholders/featured-video-placeholder-488x275.jpg"/>',
			    'caption': 'A caption about the video here',
			    'video': '66',
        }
%}

{% if content_data is empty %}
    {% set content_data = content_sample %}
{% endif %}

<section>
	<div class="row video-textbelow">
		<div class="col-6 video-textbelow__wrapper">
			<a class="use-ajax video-textbelow__link" data-dialog-type="modal" href="/media/{{ content_data['video'] }}" data-dialog-options="{&quot;width&quot;:800}">
      {{ content_data['thumb']|raw }}
      <div class="video-textbelow__details">
        <span class="play-btn">&gt;</span>
        <label class="video-textbelow__heading">{{ content_data['heading']|raw }}</label>
        <hr>
      </div>
      </a>

      <span class="caption"><caption class="video-textbelow__caption">{{ content_data['caption']|raw }}</caption></span>

		</div>
	</div>
</section>
