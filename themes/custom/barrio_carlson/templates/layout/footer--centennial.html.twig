{%
    set navs = [
        {
            icon: 'centennial-onehundredalt',
            class: 'home',
            path: '/centennial/home',
            long_title: '100 Years<br/>of Carlson',
            short_title: 'Home'
        },
        {
            icon: 'centennial-about',
            class: 'about',
            path: '/centennial/about',
            long_title: 'About the<br/>Celebration',
            short_title: 'About',
            content: 'As we mark our centennial, we\'re celebrating you.'
        },
        {
            icon: 'centennial-timeline',
            class: 'timeline',
            path: '/centennial/timeline',
            long_title: 'Learn Our<br/>History',
            short_title: 'History',
            content: 'Explore milestones and key figures from our first 100 years.'
        },
        {
            icon: 'centennial-events',
            class: 'events',
            path: '/centennial/events',
            long_title: 'Join us at<br/>an Event',
            short_title: 'Events',
            content: 'Gather with friends new and old from our global community.'
        },
        {
            icon: 'centennial-news',
            class: 'news',
            path: '/centennial/news',
            long_title: 'See the<br/>latest News',
            short_title: 'News',
            content: 'Find out how the Carlson School impacts the world.'
        },

    ]
%}

<div class="row centennial__floating-nav-wrapper" role="nav">
    <div class="col-12 offset-md-1 col-md-10">
        <div class="row centennial__floating-nav">
        {% for nav in navs %}
            <div class="col centennial__nav-item {{ path('<current>') == nav.path ? 'active-nav' : '' }}">
                <a href="{{nav.path}}">
                    <div class="centennial__nav-item-icon {{ nav.class }}">
                        <i class="icon icon-{{ nav.icon }}"></i>
                    </div>
                    <div class="centennial__nav-item-title">
                        {{ nav.short_title | raw }}
                    </div>
                </a>
            </div>
        {% endfor %}
        </div>
    </div>
</div>
<div class="row" role="nav">
    <div class="offset-1 col-10">
        <div class="row centennial__nav">
        {% for nav in navs %}
            <div class="col-sm-12 col-md centennial__nav-item {{ path('<current>') == nav.path ? 'active-nav' : '' }}">
                <a href="{{nav.path}}">
                    <div class="centennial__nav-item-icon {{ nav.class }}">
                        <i class="icon icon-{{ nav.icon }}"></i>
                    </div>
                    <div class="centennial__nav-item-title">
                        <div class="d-md-none d-lg-inline-block">{{ nav.long_title | raw }}</div>
                        <div class="d-none d-md-inline-block d-lg-none">{{ nav.short_title | raw }}</div>
                    </div>
                    <div class="centennial__nav-item-content">
                        {{ nav.content }}
                    </div>
                    {# <div class="centennial__nav-item-indicator d-none d-md-inline-block">
                        <i class="icon icon-centennial-onehundred"></i>
                    </div> #}
                </a>
            </div>
        {% endfor %}
        </div>
    </div>
</div>