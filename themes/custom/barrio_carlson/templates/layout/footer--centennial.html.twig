{%
    set navs = [
        {
            icon: 'centennial-onehundred',
            class: 'home',
            path: '/centennial/home',
            long_title: '100 Years<br/>of Carlson',
            short_title: 'Home',
            content: 'Nulla facilisi. In ullamcorper, neque eu laoreet dictum, metus metus accumsan lacus, non.'
        },
        {
            icon: 'centennial-about',
            class: 'about',
            path: '/centennial/about',
            long_title: 'About the<br/>Celebration',
            short_title: 'About',
            content: 'Nulla facilisi. In ullamcorper, neque eu laoreet dictum, metus metus accumsan lacus, non.'
        },
        {
            icon: 'centennial-timeline',
            class: 'timeline',
            path: '/centennial/timeline',
            long_title: 'Learn Our<br/>History',
            short_title: 'History',
            content: 'Nulla facilisi. In ullamcorper, neque eu laoreet dictum, metus metus accumsan lacus, non.'
        },
        {
            icon: 'centennial-events',
            class: 'events',
            path: '/centennial/events',
            long_title: 'Join us at<br/>an Event',
            short_title: 'Events',
            content: 'Nulla facilisi. In ullamcorper, neque eu laoreet dictum, metus metus accumsan lacus, non.'
        }
    ]
%}
{% set cols = 12 / (navs | length) %}
<div class="row" role="nav">
    <div class="offset-1 col-10">
        <div class="row centennial__nav">
        {% for nav in navs %}
            <div class="col-{{cols}} centennial__nav-item {{ path('<current>') == nav.path ? 'active-nav' : '' }}">
                <a href="{{nav.path}}">
                    <div class="centennial__nav-item-icon {{ nav.class }}">
                        <i class="icon icon-{{ nav.icon }}"></i>
                    </div>
                    <div class="centennial__nav-item-title">
                        {{ nav.long_title | raw }}
                    </div>
                    <div class="centennial__nav-item-content">
                        {{ nav.content }}
                    </div>
                    <div class="centennial__nav-item-indicator">
                        <i class="icon icon-centennial-onehundred"></i>
                    </div>
                </a>
            </div>
        {% endfor %}
        </div>
    </div>
</div>