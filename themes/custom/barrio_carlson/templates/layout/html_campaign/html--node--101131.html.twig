{%
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'page-node-type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
    theme.settings.navbar_position ? 'navbar-is-' ~ theme.settings.navbar_position,
    theme.has_glyphicons ? 'has-glyphicons',
  ]
%}
<!DOCTYPE html>
<html {{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>




    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">

      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jquery-jvectormap-2.0.3.css" type="text/css" media="screen"/>
      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jvectormap-custom.css" type="text/css" media="screen"/>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-2.0.3.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-asia-mill.js"></script>


  </head>
  <body{{ attributes.addClass(body_classes) }}>
    <div id="skip">
      <a href="#main-content" class="visually-hidden focusable skip-link">
        {{ 'Skip to main content'|t }}
      </a>
    </div>
    {% include directory ~ '/templates/layout/umn-header.html.twig' %}

    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    {% include directory ~ '/templates/layout/umn-footer.html.twig' %}


<!--start UNITED STATES -->
<script>

var  markers = [
  {latLng: [37.57, 126.98], name: 'Seoul', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [39.9, 116.41], name: 'Beijing', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [31.23, 121.47], name: 'Shanghai', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [12.97, 77.59], name: 'Bangalore', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [19.08, 72.88], name: 'Mumbai', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [17.39, 78.49], name: 'Hyderabad', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
];



  $(function(){
    $('#map').vectorMap({
      map: 'asia_mill',
      focusOn: {
        regions: [ 'CN','IN'],
      },
      normalizeFunction: 'polynomial',
      backgroundColor: 'transparent',
      series: {
        regions: [{
          values: {
            'BN': 'transparent',
            'BH': 'transparent',
            'MN': 'transparent',
            'JP': 'transparent',
            'JO': 'transparent',
            'PS': 'transparent',
            'LB': 'transparent',
            'TR': 'transparent',
            'TL': 'transparent',
            'TM': 'transparent',
            'TJ': 'transparent',
            'XC': 'transparent',
            'PH': 'transparent',
            '-99': 'transparent',
            'AE': 'transparent',
            'AF': 'transparent',
            'IQ': 'transparent',
            'IR': 'transparent',
            'AM': 'transparent',
            'SY': 'transparent',
            'GE': 'transparent',
            'IL': 'transparent',
            'AZ': 'transparent',
            'ID': 'transparent',
            'OM': 'transparent',
            'KG': 'transparent',
            'UZ': 'transparent',
            'CY': 'transparent',
            'QA': 'transparent',
            'KW': 'transparent',
            'KZ': 'transparent',
            'SA': 'transparent',
            'MY': 'transparent',
            'YE': 'transparent',
            'PK': 'transparent',
            'LK': 'transparent',
            'TH': 'transparent',
            'LA': 'transparent',
            'VN': 'transparent',
            'ID': 'transparent',
            'MM': 'transparent',
            'KH': 'transparent',
          },
          attribute: 'fill'
        }]
      },
      regionStyle: {
        initial: {
          fill: '#d5d6d2',
        },
      },
      markerStyle: {
          initial: {
              fill: '#B8002B',
              stroke: '#900021',
              "fill-opacity": 1,
              "stroke-width": 2,
              "stroke-opacity": 1,
              r: 6,
          },
          hover: {
            fill: '#FFB71E',
          }
      },
      onMarkerClick: function(event, index) {
          alert(markers[index].weburl);
      },
      markers: markers,
      onMarkerClick: function(events, index) {
        $(location).attr('href',markers[index].weburl);
      },
      onMarkerTipShow: function (e, el, code) {
        var markers = $('#map').vectorMap('get', 'mapObject').markers;
        if (typeof markers[code].config.dates !== 'undefined') {
          el.html(el.html() + '<br /><span class="mapdate">' + markers[code].config.dates + '</span>');
        } else {
          el.html(el.html());
        }
      },
      labels: {
        regions: false
      },
      onRegionOver: function (event, code, region) {
        if (activeNations.indexOf(code) === -1) {
          event.preventDefault();
        }
      },
      zoomButtons: false,
      zoomOnScroll: false,
      panOnDrag: false,
    });
  });
</script>

<!--end-->





<js-bottom-placeholder token="{{ placeholder_token|raw }}">

