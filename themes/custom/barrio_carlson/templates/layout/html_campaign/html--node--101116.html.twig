      $(function(){
        $('#usamap').vectorMap({
          map: 'us_lcc',
          normalizeFunction: 'polynomial',
          backgroundColor: 'transparent',
          series: {
            regions: [{
              values: {
                'US-HI': 'transparent',
                'US-AK': 'transparent',
                'US-CA': '#ffde7a',
                'US-WA': '#ffde7a',
                'US-UT': '#ffde7a',
                'US-CO': '#ffde7a',
                'US-TX': '#ffde7a',
                'US-ND': '#ffde7a',
                'US-MN': '#ffde7a',
                'US-WI': '#ffde7a',
                'US-IL': '#ffde7a',
                'US-NY': '#ffde7a',
                'US-MD': '#ffde7a',
                'US-DC': '#ffde7a',
                'US-NC': '#ffde7a',
                'US-GA': '#ffde7a',
                'US-FL': '#ffde7a',
              },
              attribute: 'fill'
            }]
          },
          regionStyle: {
            initial: {
              fill: '#ffde7a',
            },
          },
          markerStyle: {
              initial: {
                  fill: '#900021',
                  "fill-opacity": 1,
                  "stroke-width": 0,
                  "stroke-opacity": 1,
                  r: 8,
              },
              hover: {
                fill: '#7a0019',
              }
          },
          markers: markers,
          onMarkerClick: function(events, index) {
            $('#copy').html(markers[index].text);
          },
          onMarkerTipShow: function (e, el, code) {
            var markers = $('#usamap').vectorMap('get', 'mapObject').markers;
            el.html(el.html());
          },
          labels: {
            regions: false
          },
          onRegionOver: function (event, code, region) {
            if (activeNations.indexOf(code) === -1) {
              event.preventDefault();
            }
          },
          zoomButtons: false,
          zoomOnScroll: false,
          panOnDrag: false,
        });
