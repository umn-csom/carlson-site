{%
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'page-node-type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
    theme.settings.navbar_position ? 'navbar-is-' ~ theme.settings.navbar_position,
    theme.has_glyphicons ? 'has-glyphicons',
  ]
%}
<!DOCTYPE html>
<html {{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>




    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">

      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jquery-jvectormap-2.0.3.css" type="text/css" media="screen"/>
      <link rel="stylesheet" href="/{{ directory }}/css/html_campaign/jvectormap-custom.css" type="text/css" media="screen"/>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-2.0.3.min.js"></script>
      <script src="/{{ directory }}/js/html_campaign/jquery-jvectormap-us-lcc.js"></script>


  </head>
  <body{{ attributes.addClass(body_classes) }}>
    <div id="skip">
      <a href="#main-content" class="visually-hidden focusable skip-link">
        {{ 'Skip to main content'|t }}
      </a>
    </div>
    {% include directory ~ '/templates/layout/umn-header.html.twig' %}

    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    {% include directory ~ '/templates/layout/umn-footer.html.twig' %}


<!--start UNITED STATES -->
<script>

var  markers = [
  {latLng: [33.75, -84.4], name: 'Atlanta', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [30.27, -97.74], name: 'Austin', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [39.29, -76.61], name: 'Baltimore', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [41.88, -87.63], name: 'Chicago', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [32.78, -96.8], name: 'Dallas', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [39.74, -104.99], name: 'Denver', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [36, -78.9], name: 'Durham', weburl : "https://huffpost.com"},
  {latLng: [30.33, -81.66], name: 'Jacksonville', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [44.98, -93.27], name: 'Minneapolis', dates: 'August 3&ndash;13, 2019', weburl : "https://cnn.com"},
  {latLng: [40.71, -74], name: 'New York', weburl : "https://talkingpointsmemo.com"},
  {latLng: [29.42, -98.49], name: 'San Antonio', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [32.72, -117.16], name: 'San Diego', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [37.77, -122.42], name: 'San Francisco', dates: 'Dates, 2019', weburl : "https://huffpost.com"},
  {latLng: [38.91, -77.04], name: 'Washington, DC', weburl : "https://nytimes.com"},
];



  $(function(){
    $('#map').vectorMap({
      map: 'us_lcc',
      normalizeFunction: 'polynomial',
      backgroundColor: 'transparent',
      series: {
        regions: [{
          values: {
            'US-HI': 'transparent',
            'US-AK': 'transparent',
          },
          attribute: 'fill'
        }]
      },
      regionStyle: {
        initial: {
          fill: '#d5d6d2',
        },
      },
      markerStyle: {
          initial: {
              fill: '#B8002B',
              stroke: '#900021',
              "fill-opacity": 1,
              "stroke-width": 2,
              "stroke-opacity": 1,
              r: 6,
          },
          hover: {
            fill: '#FFB71E',
          }
      },
      onMarkerClick: function(event, index) {
          alert(markers[index].weburl);
      },
      markers: markers,
      onMarkerClick: function(events, index) {
        $(location).attr('href',markers[index].weburl);
      },
      onMarkerTipShow: function (e, el, code) {
        var markers = $('#map').vectorMap('get', 'mapObject').markers;
        if (typeof markers[code].config.dates !== 'undefined') {
          el.html(el.html() + '<br /><span class="mapdate">' + markers[code].config.dates + '</span>');
        } else {
          el.html(el.html());
        }
      },
      labels: {
        regions: false
      },
      onRegionOver: function (event, code, region) {
        if (activeNations.indexOf(code) === -1) {
          event.preventDefault();
        }
      },
      zoomButtons: false,
      zoomOnScroll: false,
      panOnDrag: false,
    });
  });
</script>

<!--end-->





