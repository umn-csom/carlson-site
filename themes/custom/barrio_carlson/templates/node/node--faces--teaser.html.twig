{{ attach_library('bootstrap_barrio/node') }}

<article class="card magazine--faces--card">
  <div class="card-body">
    <a data-toggle="modal" data-target="#m{% spaceless %}{{ node.id|render|striptags }}{% endspaceless %}">
      {% if content.field_magazine_cover_image | render | striptags is not empty %}
        <div class="text-center">
          <img src="{{ file_url(node.field_magazine_cover_image.entity.uri.value) }}" class="img-fluid mb-2" alt="Photo of {{ node.label|render|striptags }}">
        </div>
      {% endif %}
      <h2 class="magazine--faces--card--body-h2 m-0 text-center">{{ node.label }}</h2>
      {% if content.field_short_sub_heading is not empty %}
        <h3 class="m-0 mt-1 text-center">{{ content.field_short_sub_heading }}</h3>
      {% endif %}
    </a>
  </div>
</article>

<!-- Modal -->
<div class="modal fade modal-xl" id="m{% spaceless %}{{ node.id|render|striptags }}{% endspaceless %}" tabindex="-1" role="dialog" aria-labelledby="mlabel{% spaceless %}{{ node.id|render|striptags }}{% endspaceless %}" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content"> <!--
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div> -->
      <article class="modal-body magazine--faces--modal p-5">
        {% if content.field_magazine_cover_image | render | striptags is not empty %}
        <figure class="text-center">
          <img src="{{ file_url(node.field_magazine_cover_image.entity.uri.value) }}" class="img-fluid mb-3" alt="Photo of {{ node.label|render|striptags }}">
        </figure>
        {% endif %}
        <h1 id="mlabel{% spaceless %}{{ node.id|render|striptags }}{% endspaceless %}">{{ node.label }}</h1>
        <h2>{{ content.field_short_sub_heading }}</h2>
        {{ content.body }}
      </article>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm px-2 py-1" style="font-size : 60%;" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
