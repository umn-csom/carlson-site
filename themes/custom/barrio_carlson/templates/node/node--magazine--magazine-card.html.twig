{{ attach_library('bootstrap_barrio/node') }}

<section class="mt-4 mb-5 row justify-content-center">
  <div class="col-12 col-lg-8 p-4 magazine--promobar">
    <div class="row">
      <div class="col-12">
        <img
          src="{{ content.field_magazine_cover_image|render|striptags }}"
          class="img-fluid float-left magazine--cover-angle">
        <h2>This article appeared in the {{ label }} alumni magazine</h2>
        {{ content.field_teaser }}
        <p class="text-right mb-0 pb-0"><a href="{{ url }}" class="btn maroon-solid-button btn-sm py-2 px-3">{{ label }} table of contents <i class="fas fa-angle-right"></i></a></p>

      </div>
    </div>
  </div>
</section>
