{{ attach_library('bootstrap_barrio/node') }}

<section class="mt-5 mb-5 pb-5 row justify-content-center">
  <div class="mb-2 col-12 col-lg-10 p-4 magazine--promobar">
    <div class="row">
      <div class="col-1">
        <img
          src="{{ content.field_magazine_cover_image|render|striptags }}"
          class="img-fluid"
          style="-moz-transform: rotate(-3deg);
    -webkit-transform: rotate(-3deg);
    -o-transform: rotate(-3deg);
    -ms-transform: rotate(-3deg);
    transform: rotate(-3deg);position:absolute;height:150px;width:auto;top:-60px;-webkit-box-shadow: 0 0 15px 0 rgba(0,0,0,.2);
    box-shadow: 0 0 15px 0 rgba(0,0,0,.2);">
      </div>
      <div class="col-8 pl-5">
        <p class="m-0 p-0">This article appeared in the
          {{ label }}
          edition of <em>Carlson School</em> magazine</p>
              </div>
              <div class="col-3">
                <a href="{{ url }}" class="btn maroon-solid-button btn-block btn-sm py-2 px-3">More from {{ label }}</a>
              </div>
    </div>
  </div>
</section>
