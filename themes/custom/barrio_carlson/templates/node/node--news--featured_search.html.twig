<article class="row justify-content-center front--featured-news">
  <figure class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
    <a href="{{ url }}">{{ content.field_hero_media }}</a>
  </figure>
  <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
    <h4 class="featured-news-header">Featured News</h4>
    <hr class="featured-news-line">
    <a href="{{ url }}">
      <h3><em>{{ label }}</em></h3>
    </a>
    <section class="front--featured-news--copy">{{ content.body }}</section>
    <a href="{{ url }}"><p class="mt-4 mb-0"><span class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Read more</span></p></a>
  </div>
</article>
