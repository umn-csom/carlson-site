{{ attach_library('bootstrap_barrio/node') }}

{%
  set classes = [
    'node',
    'col-12 col-md-8 col-lg-9 pr-md-5',
    'magazine',
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

<div class="row no-gutters">
  <div {{ attributes.addClass(classes) }}>
    <header class="mb-5 pl-lg-4">
      <h1 class="mt-0 pt-0">The Carlson School Magazine
        <em style="color:#8a8a8a;">{{ label }}</em>
      </h1>
    </header>

    <section class="row mb-4 magazine--section-top pl-lg-4">
      {% if content.field_introduction_copy|render is not empty %}
      <article class="col-12 order-1 mb-4 col-lg-5 order-lg-2 mb-lg-0 px-lg-5 magazine--intro">
        <h2 class="magazine--section-heading">From the Dean</h2>
        <h3>{{ content.field_magazine_intro_head }}</h3>
        <div class="collapse" id="magazine--intro-collapse">
          <figure class="magazine--intro-profileimg">
            {{ content. field_profile_image }}
          </figure>
          {{ content.field_introduction_copy }}
        </div>
        <a class="magazine--intro-collapse-link collapsed" data-toggle="collapse" href="#magazine--intro-collapse" aria-expanded="false" aria-controls="magazine--intro-collapse"></a>
      </article>
      {% endif %}
      <div class="col-12 col-lg-7 order-2 order-lg-1">
        <h2 class="magazine--section-heading mb-3">Cover story</h2>
        {{ content.field_magazine_story_cover }}
      </div>
    </section>

    <section class="magazine--sections row justify-content-start">
      {{ content.field_magazine_section }}
    </section>
  </div>
  <div class="col-12 col-md-4 col-lg-3 magazine--sidebar">
    {% if content.field_magazine_pdf|render %}
    <section class="magazine--pdf pb-5 mb-4">
      {% if content.field_magazine_cover_image|render %}
        <div class="row">
          <figure class="col-5">
            {% if content.field_magazine_pdf | render %}
              <a href="{{ content.field_magazine_pdf|render|striptags }}" target="_blank">
            {% endif %}
              <img src="{% spaceless %}{{ content.field_magazine_cover_image|render|striptags }}{% endspaceless %}" class="img-fluid magazine--cover-angle">
              {% if content.field_magazine_pdf | render %}
              </a>
            {% endif %}
          </figure>
          <div class="col-7">
          {% endif %}
          {% if content.field_magazine_pdf | render %}
            <h2>Download&nbsp;the
              <span class="text-nowrap">{{ label|render|striptags }}
                issue</span></h2>
          {% endif %}
          {{ content.field_teaser }}
          {% if content.field_magazine_pdf|render %}
            <p class="mb-0 pb-0">
              <a href="{{ content.field_magazine_pdf|render|striptags }}" target="_blank" class="btn btn-primary--yellow btn-sm btn-block py-2 px-3">Download this issue
                <i class="fas fa-file-download"></i>
              </a>
            </p>
          {% endif %}
          {% if content.field_magazine_cover_image | render %}
          </div>
        </div>
      {% endif %}
    </section>
    {% endif %}

    <aside class="px-5 pb-5">
      {{ drupal_view('magazine_archives', 'block_3') }}
      {{ drupal_view('magazine_archives', 'block_1') }}
      <p class="mb-0 pb-0">
        <a href="/magazine/archives" class="btn btn-primary--maroon btn-sm btn-block py-2 px-3">Browse all issues, 2009–present
          <i class="fas fa-angle-right"></i>
        </a>
      </p>
    </aside>
  </div>
</div>
