{{ attach_library('bootstrap_barrio/node') }}

{%
  set classes = [
    'node',
    'col-12 col-md-8 col-lg-9 pr-md-5',
    'magazine',
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

<div class="row no-gutters">
  <div {{ attributes.addClass(classes) }}>
    <header class="mb-5 pl-lg-4">
        <h1 class="mt-0 pt-0">Carlson School Magazine <em style="color:#D8D8D8;">{{ label }}</em>
        </h1>
    </header>


        <section class="row mb-4 magazine--section-top pl-lg-4">
          <div class="col-12 col-lg-7">
            <h2 class="magazine--section-heading mb-3">Cover story</h2>
        {{ content.field_magazine_story_cover }}
      </div>
      <article class="col-12 col-lg-5 px-lg-5 magazine--intro">
        <h2 class="magazine--section-heading">From the Dean</h2>
          <h3>{{ content.field_magazine_intro_head }}</h3>
          <div class="collapse" id="magazine--intro-collapse">
            <figure class="magazine--intro-profileimg">
              {{ content. field_profile_image }}
            </figure>
            {{ content.field_introduction_copy }}
          </div>
          <a class="magazine--intro-collapse-link collapsed" data-toggle="collapse" href="#magazine--intro-collapse" aria-expanded="false" aria-controls="magazine--intro-collapse"></a>
        </article>
      </section>

      <section class="magazine--sections row justify-content-start">
        {{ content.field_magazine_section }}
      </section>
  </div>
  <div class="col-12 col-md-4 col-lg-3 magazine--sidebar">
    <section class="magazine--pdf pb-5 mb-4">
      <div class="row">
        <figure class="col-5">
      <img src="{{ content.field_magazine_cover_image|render|striptags }}" class="img-fluid" style="-moz-transform: rotate(-3deg);
-webkit-transform: rotate(-3deg);
-o-transform: rotate(-3deg);
-ms-transform: rotate(-3deg);
transform: rotate(-3deg);">
    </figure>
<div class="col-7">
  <h2>Download&nbsp;the <span class="text-nowrap">{{ label|render|striptags }} issue</span></h2>
    <p>Nam ac tempor risus. Donec porttitor mi magna, ac vulputate diam sagittis in. Suspendisse mi diam, pulvinar in volutpat in, pharetra eu sed.<!--140 characters--></p>
        <p class="mb-0 pb-0 text-right"><a href="{{ content.field_magazine_pdf|render|striptags }}" target="_blank" class="btn btn-primary--yellow btn-sm py-2 px-3" style="font-size:90%;">Download the pdf</a></p>
    </div>
  </div>
    </section>

    <aside class="px-5 pb-5">
      Sidebar content goes here
    </aside>
  </div>
</div>
