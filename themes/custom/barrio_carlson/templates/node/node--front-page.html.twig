{{ attach_library('bootstrap_barrio/node') }}




  {{ drupal_view('front_blocks', 'top_feature') }}

<section class="front--programs my-5">
  <div class="container my-0">
    <div class="row mt-0 mb-4">
      <div class="col-12 text-center">
        <h2 class="m-0 mb-3 front--programs-heading">Find the program that’s right for you</h2>
      </div>
    </div>
  <div class="row justify-content-center">
    {{ content.field_front_programs }}
  </div>
</div>
</section>

<section class="front--featureds py-5" style="background: rgb(240,239,238);background: linear-gradient(184deg, rgba(240,239,238,1) 0%, rgba(255,255,255,1) 100%);">
  <div class="container" style="max-width:1280px;">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-7 px-5 py-4 mb-5 mr-lg-5" style="background-color:#f0f0f0;-webkit-box-shadow: 0 0 15px 0 rgba(83,83,83,.4);box-shadow: 0 0 15px 0 rgba(83,83,83,.4);">
        <h2 class="m-0 p-0 text-center" style="font-size:24px;color:#900021;line-height:105%;">Featured News</h2>
        <span class="d-block mt-3 mb-4 mx-auto" style="height:1px;border-bottom:1px solid #900021;max-width:265px;"></span>
        {{ drupal_view('front_blocks', 'feature_news') }}
      </div>
      <div class="col-12 col-sm-6 col-lg-4 p-5 mr-sm-5 mr-lg-0 mb-5" style="background-color:#f0f0f0;-webkit-box-shadow: 0 0 15px 0 rgba(83,83,83,.4);box-shadow: 0 0 15px 0 rgba(83,83,83,.4);">
        <h2 class="m-0 p-0 text-center" style="font-size:24px;color:#900021;line-height:105%;">Upcoming Application Deadlines</h2>
        <span class="d-block mt-3 mb-4 mx-auto" style="height:1px;border-bottom:1px solid #900021;max-width:265px;"></span>
        {{ drupal_view('front_deadlines', 'block_1') }}
        <p class="text-center mt-4 mb-0"><a href="/" class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Explore all programs</a></p>
      </div>
      <div class="col-12 col-sm-5 col-lg-4 p-5 mb-5 mb-lg-0" style="background-color:#f0f0f0;-webkit-box-shadow: 0 0 15px 0 rgba(83,83,83,.4);box-shadow: 0 0 15px 0 rgba(83,83,83,.4);">
        <h2 class="m-0 p-0 text-center" style="font-size:24px;color:#900021;line-height:105%;">Featured Event</h2>
        <span class="d-block mt-3 mb-0 mx-auto" style="height:1px;border-bottom:1px solid #900021;max-width:265px;"></span>
        {{ drupal_view('front_blocks', 'feature_events') }}
      </div>
      <div class="col-12 col-lg-7 p-5 ml-lg-5" style="background-color:#f0f0f0;-webkit-box-shadow: 0 0 15px 0 rgba(83,83,83,.4);box-shadow: 0 0 15px 0 rgba(83,83,83,.4);">
        <h2 class="m-0 p-0 text-center" style="font-size:24px;color:#900021;line-height:105%;">Faculty and Research</h2>
        <span class="d-block mt-3 mb-4 mx-auto" style="height:1px;border-bottom:1px solid #900021;max-width:265px;"></span>
        {{ drupal_view('front_blocks', 'feature_discover') }}
      </div>
    </div>
  </div>
</section>

<section class="front--statistics py-5">





  <div class="container">
      {{ content.field_front_statistics }}
</div>
</section>












<section style="background-image: url('{% spaceless %}{{ content.field_front_advantage_bg }}{% endspaceless %}');" class="front--advantage pt-5 pb-5">
<div class="front--advantage--gradient"></div>


  <div class="container">
    <div class="row justify-content-center justify-content-lg-end">
      <div class="col-12 col-sm-9 d-block d-lg-none mb-4 mb-lg-0"><img src="{% spaceless %}{{ content.field_front_advantage_bg }}{% endspaceless %}" class="img-fluid"></div>
    <div class="col-12 col-lg-6 col-xl-6">
    <div class="row justify-content-center">
      <div class="col-10 col-md-9 col-lg-10 col-xl-8">
  <h2 class="text-center mt-0 pt-0 pb-4 front--advantage--heading">{{ content.field_field_front_advantage_head }}</h2>
</div>
</div>
  <div class="row justify-content-center">
    <div class="col-10 col-md-9 col-lg-10 col-xl-7 pt-4">
  <h3 class="front--advantage--subheading mt-0 mb-3"><em>{{ content.field_front_advantage_1head }}</em></h3>
  {{ content.field_front_advantage_1copy }}
  <p class="mb-0 mt-4 text-right"><a href="{{ content.field_front_advantage_1link.0['#url'] }}" class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">{{ content.field_front_advantage_1link.0['#title'] }}</a></p>

  <h3 class="front--advantage--subheading pt-3 mt-5 mb-3"><em>{{ content.field_field_front_advantage_2hea }}</em></h3>
  {{ content.field_front_advantage_2copy }}
  <p class="mb-0 mt-4 text-right"><a href="{{ content.field_front_advantage_2link.0['#url'] }}" class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">{{ content.field_front_advantage_2link.0['#title'] }}</a></p>
</div>
</div></div></div>
</div>
</section>


<section class="mt-5">
  <div class="container">
    <div class="row node__bottom justify-content-center">
      {% spaceless %}
      <div class="node__bottom__col col-12 col-md-5 col-lg-4">
        {{ node_bottom_left }}
      </div>
      <div class="node__bottom__col col-12 col-md-6">
        {{ node_bottom_right }}
      </div>
      {% endspaceless %}
    </div>
</div>
</section>
