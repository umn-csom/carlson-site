<article class="row justify-content-center front--featured-news">
  <figure class="col-9 col-sm-5 col-md-4 col-lg-5 col-xl-6">
    <a href="{{ url }}">{{ content.field_hero_media }}</a>
  </figure>
  <div class="col-12 col-sm-7 col-md-8 col-lg-7 col-xl-6">
    <a href="{{ url }}">
      <h3><em>{{ label }}</em></h3>
      <section class="front--featured-news--copy">{{ content.body }}</section>
      <p class="text-right mt-4 mb-0"><span class="btn btn-sm btn-primary--yellow btn-primary--yellow-solid">Read more</span></p>
    </a>
  </div>
</article>
