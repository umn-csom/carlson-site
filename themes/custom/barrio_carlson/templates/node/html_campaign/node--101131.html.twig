            {% if node_content %}
              {{ node_content }}
            {% endif %}


            {% if node_bottom %}
              {{ node_bottom }}
            {% endif %}

            {# Bottom node region for blocks #}
            <div class="row node__bottom">
              {% spaceless %}
              <div class="node__bottom__col">
                {{ node_bottom_left }}
