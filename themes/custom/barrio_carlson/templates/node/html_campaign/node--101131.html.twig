{{ attach_library('bootstrap_barrio/node') }}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix'
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <header>
    {{ title_prefix }}
    {% if not page %}
      <h2{{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}
  </header>

  <div{{ content_attributes.addClass('node__content', 'clearfix', 'basic-page') }}>
    {# Render hero with hero-basic component #}
    {% if content.field_hero_media|field_value is empty %}
      <section>
        <div class="row basic-hero travel-hero">
          <div class="col-11 col-lg-10 offset-lg-1 basic-hero__title">
            <h1>{{ label }}</h1>
          </div>
        </div>
      </section>
    {% else %}
      <section>
        <div class="row basic-hero travel-hero">
          <div class="col-lg-12 basic-hero__img">
            {{ content.field_hero_media }}
          </div>
          <div class="col-10 offset-1 basic-hero__title">
            <div class="basic-hero__title-inner">
              <h1>{{ label }}</h1>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <section class="row justify-content-center basic-page__content">
      <div class="col-lg-11 main-content basic-page__content--inner">

<!--start -->
<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-8 col-xl-9 map-container map-asia order-2 order-md-1">
    <!-- <ul class="list-inline list-unstyled text-center override--tinybuttons">
      <li class="list-inline-item"><a href="/em/ontheroad" class="btn btn-secondary">USA</a></li>
      <li class="list-inline-item"><a href="/em/ontheroad/africa" class="btn btn-secondary">Africa</a></li>
      <li class="list-inline-item"><a  href="/em/ontheroad/asia" class="btn btn-secondary disabled">Asia</a></li>
    </ul> -->
      <div class="jvmap-smart" id="asiamap"></div>
  </div>
  <div class="col-12 col-md-4 col-lg-4 col-xl-3 copy--tighter order-1 order-md-2">
    {{ content.body }}
    <h3>China</h3>
      <ul>
    <li>
      <a href="/events/ontheroad_beijing">Beijing: August 24</a>
    </li>
    <li>
      <a href="/events/ontheroad_shanghai">Shanghai: August 25</a>
    </li>
  </ul>
    <h3 class="mt-5">India</h3>
        <ul>
          <li>
            <a href="/events/ontheroad_bangalore">Bangalore: September 18</a>
          </li>
          <li>
            <a href="/events/ontheroad_hyderabad">Hyderabad: September 23</a>
          </li>
          <li>
            <a href="/events/ontheroad_mumbai">Mumbai: September 21</a>
          </li>
          <li>
            <a href="/events/ontheroad_delhi">Delhi: September 16</a>
          </li>
    </ul>
    <h3 class="mt-5">South Korea</h3>
    <ul>
          <li>
            <a href="/events/ontheroad_seoul">Seoul: August 22</a>
          </li>
        </ul>
        </div>
</div>

<!-- end-->


            {% if node_content %}
              {{ node_content }}
            {% endif %}


            {% if node_bottom %}
              {{ node_bottom }}
            {% endif %}

            {# Bottom node region for blocks #}
            <div class="row node__bottom">
              {% apply spaceless %}
              <div class="node__bottom__col">
                {{ node_bottom_left }}
              </div>
              <div class="node__bottom__col">
                {{ node_bottom_right }}
              </div>
              {% endapply %}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</article>
