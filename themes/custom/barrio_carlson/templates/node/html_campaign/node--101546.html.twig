{{ attach_library('bootstrap_barrio/node') }}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix'
  ]
%}

<article{{ attributes.addClass(classes) }}>

<!--- START-->
    <section class="row justify-content-center">
      <!-- <div class="col-12"><div id="quiz_progress_outer"><div id="quiz_progress_inner"></div></div></div>-->
<div id="quiz_container" class="col-12 col-xl-10"></div>
  </section>

<!--END-->


    <section class="row basic-page__content">
      <div class="col-lg-10 offset-lg-1 main-content basic-page__content--inner">
        {# inner_nav region #}
		    {% if inner_nav %}
		    <div class="row inner_nav">
		      <div class="col-12">
            <div class="row">
		          {{ inner_nav }}
            </div>
		      </div>
		    </div>
		  	{% endif %}

        {# Course brochure link #}
        {% if content.field_ee_catalog_link|field_value is not empty %}
        <div class="row basic-page__catalog">
          <div class="col-12 text-center">
            {{ content.field_ee_catalog_link }}
          </div>
        </div>
        {% endif %}

        <div class="row">

          {# Stick sidebar region #}
          {% if sticky_sidebar %}
          <div class="col-lg-3 sticky-sidebar">
            <div class="row">
              <div class="col-12">
                <div class="sticky-sidebar__inner">
                {{ sticky_sidebar }}
                </div>
              </div>
            </div>
          </div>
          {% endif %}

          <div class="{{ sticky_sidebar ? 'col-lg-9' : 'col-12' }} basic-page__content-components">

            {# Inner node region for blocks #}
            {% if node_top %}
              {{ node_top }}
            {% endif %}

            {# Home Flexible feature paragraphs #}
            <div class="row component-paragraph">
              <div class="col-12">
                {{ content.body }}
              </div>
            </div>

            {# Inner node region for blocks #}
            {% if node_content %}
              {{ node_content }}
            {% endif %}

            {{ content.field_flexible_features }}

            {{ content.field_contact_info }}

            {% if node_bottom %}
              {{ node_bottom }}
            {% endif %}

            {# Bottom node region for blocks #}
            <div class="row node__bottom">
              {% spaceless %}
              <div class="node__bottom__col">
                {{ node_bottom_left }}
              </div>
              <div class="node__bottom__col">
                {{ node_bottom_right }}
              </div>
              {% endspaceless %}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</article>
