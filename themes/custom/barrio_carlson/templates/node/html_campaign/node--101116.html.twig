{{ attach_library('bootstrap_barrio/node') }}

{%
set classes = [
'node',
'node--type-' ~ node.bundle|clean_class,
node.isPromoted() ? 'node--promoted',
node.isSticky() ? 'node--sticky',
not node.isPublished() ? 'node--unpublished',
view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
'clearfix'
]
%}

<article{{ attributes.addClass(classes) }}>
<header>
{{ title_prefix }}
{% if not page %}
<h2{{ title_attributes.addClass('node__title') }}>
<a href="{{ url }}" rel="bookmark">{{ label }}</a>
</h2>
{% endif %}
{{ title_suffix }}
</header>

<div{{ content_attributes.addClass('node__content', 'clearfix', 'basic-page') }}>
{# Render hero with hero-basic component #}
{% if content.field_hero_media|field_value is empty %}
<section>
<div class="row basic-hero travel-hero">
<div class="col-11 col-lg-10 offset-lg-1 basic-hero__title">
<h1>{{ label }}</h1>
</div>
</div>
</section>
{% else %}
<section>
<div class="row basic-hero">
<div class="col-lg-12 basic-hero__img">
{{ content.field_hero_media }}
</div>
<div class="col-12 basic-hero__title">
<div class="basic-hero__title-inner">
<h1>{{ label }}</h1>
</div>
</div>
</div>
</section>
{% endif %}

<section class="row justify-content-center basic-page__content">
<div class="col-11 main-content basic-page__content--inner">

<!--start -->
<div class="row">
<div class="col-12 col-md-7 col-lg-9 order-1 map-container map-usa">
<!--    <ul class="list-inline list-unstyled text-center override--tinybuttons">
      <li class="list-inline-item"><a href="/em/ontheroad" class="btn btn-secondary disabled">USA</a></li>
      <li class="list-inline-item"><a href="/em/ontheroad/africa" class="btn btn-secondary">Africa</a></li>
      <li class="list-inline-item"><a  href="/em/ontheroad/asia" class="btn btn-secondary">Asia</a></li>
    </ul> -->
<div class="jvmap-smart" id="usamap"></div>
</div>
<div class="col-12 col-md-5 col-lg-3 order-2 copy--tighter">
{# Home Flexible feature paragraphs #}
<div class="row component-paragraph">
<div class="col-12">
{{ content.body }}
</div>
</div>
<div id="copy"></div>
</div>
</div>

<div class="row justify-content-center mb-5 d-block d-lg-none">
  <div class="col-12 col-sm-6">
    <h3>State Name</h3>
    <p>Event</p>
  </div>
  <div class="col-12 col-sm-6">
    <h3>State Name</h3>
    <p>Event</p>
  </div>
</div>

<div class="row justify-content-center mb-5"><div class="col-12 col-md-10 col-xl-8">
  <ul class="nav nav-pills nav-justified travel--nav">
  	<li class="nav-item"><a class="nav-link disabled" href="/em/ontheroad">USA</a></li>
  	<li class="nav-item mx-4"><a class="nav-link" href="/em/ontheroad/africa">Africa</a></li>
  	<li class="nav-item"><a class="nav-link" href="/em/ontheroad/asia">Asia</a></li>
  </ul>
</div></div>
<!-- end-->






{% if node_content %}
{{ node_content }}
{% endif %}

<div class="row justify-content-center mb-5"><div class="col-12 col-md-10 col-xl-8">
  <div class="row no-gutters my-3 travel--ctabox">
  <div class="col-4">
    <img src="/{{ directory }}/images/html_campaign/ontheroad-people.jpg" class="img-fluid">
  </div>
  <div class="col-8 text-center pl-3">
    <p>Call to action text is here!</p>
  </div>
</div>
</div>
</div>



{{ content.field_contact_info }}

{% if node_bottom %}
{{ node_bottom }}
{% endif %}

{# Bottom node region for blocks #}
<div class="row node__bottom">
{% spaceless %}
<div class="node__bottom__col">
{{ node_bottom_left }}
</div>
<div class="node__bottom__col">
{{ node_bottom_right }}
</div>
{% endspaceless %}
</div>
</div>
</section>
</div>
</article>
