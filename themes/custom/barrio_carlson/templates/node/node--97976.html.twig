<article{{ attributes.addClass(classes) }}>

  <div{{ content_attributes.addClass('node__content', 'clearfix', 'basic-page') }}>
    <section>
      <div class="row basic-hero">
        <div class="col-12 basic-hero__title centennial__timeline--headline">
          <h1>{{ label }}</h1>
          <img src='/{{ directory }}/images/centennial/timeline/hero.png'/>
        </div>
      </div>
    </section>
    <section id="centennial__timeline">
      <div class="centennial__timeline--nav-wrapper">
        <div class="centennial__timeline--nav-logo">
          <img src='/{{ directory }}/images/centennial/timeline/logo.png'/>
        </div>
        <div class="centennial__timeline--nav-container">
          <ul roll="nav" class="centennial__timeline--nav">
            {% for event in events %}
            <li data-nav-ref="{{event.nav}}" class="centennial__timeline--nav-item">
              <a href="#{{event.nav}}" class="centennial__timeline--nav-item-anchor">
                {{ event.nav }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
    <section class="row basic-page__content">
      <div class="col-12">
        <div class="col-lg-10 offset-lg-1 main-content basic-page__content--inner">

          <div class="row">

            <div class="col-12 basic-page__content-components">
              {% set count = 0 %}
              {% for event in events %}
                <div id="{{ event.nav }}" class="centennial__timeline--story-group-wrapper">
                  <div class="row component-paragraph centennial__timeline--story-group">
                    {% if count % 2 == 0 %}
                    <div class="col-12 col-md-6 centennial__timeline--story-group--image centennial__timeline--story-group--image-left" style="background-image: url('/{{ directory }}/images/centennial/timeline/story-groups/{{ event.image }}')">
                    </div>
                    {% endif %}
                    <div class="col-12 col-md-6 centennial__timeline--story-group--content">
                      <h2>
                        {{ event.label | raw }}
                        {% if event.title is not empty %}
                        <br/>
                        <span class="subtitle">{{ event.title }}</span>
                        {% endif %}
                      </h3>
                      <p>{{ event.content }}</p>
                    </div>
                    {% if count % 2 != 0 %}
                    <div class="col-12 col-md-6 order-first order-md-last centennial__timeline--story-group--image centennial__timeline--story-group--image-right" style="background-image: url('/{{ directory }}/images/centennial/timeline/story-groups/{{ event.image }}')">
                    </div>
                    {% endif %}
                  </div>
                  <div class="row centennial__timeline--stories">
                    {% for section in event.sections %}
                    <div class="col-10 offset-1 centennial__timeline--story">
                      <div class="row">
                        <div class="col-6 col-md centennial__timeline--story-year">
                          {{ section.year }}
                        </div>
                        <div class="col-12 order-2 col-md order-md-1 centennial__timeline--story-content">
                          <h3>{{ section.title }}</h3>
                          {{ section.content }}
                        </div>
                        {% if section.image is not empty %}
                        <div class="col-6 order-1 col-md order-md-2 centennial__timeline--story-image">
                          <img src="/{{ directory }}/images/centennial/timeline/stories/{{ section.image }}">
                        </div>
                        {% endif %}
                      </div>
                    </div>
                    {% endfor %}
                  </div>
                </div>
                {% set count = count + 1 %}
              {% endfor %}

            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</article>
