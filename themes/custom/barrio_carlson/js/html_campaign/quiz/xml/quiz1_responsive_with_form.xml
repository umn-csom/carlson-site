<?xml version="1.0" encoding="utf-8" ?>
<data>

    <events>
    	<event id="screenloaded">
			<click>
				<function name="scoreSummary">quiz</function>
			</click>
		</event>

		<event id="loadAnotherPage">
			<click>
				<url address="http://www.essemble.co.uk" window="true">this</url>
			</click>
		</event>

		<event id="btnover">
			<rollover>
				<css name="btnOverCss">this</css>
			</rollover>
			
			<rollout>
				<css name="btnOutCss">this</css>
			</rollout>
		</event>

		<event id="optionover">
			<rollover>
				<css name="optionOverCss">this</css>
			</rollover>
			
			<rollout>
				<css name="optionOutCss">this</css>
			</rollout>
		</event>

		<event id="imgoption">
			<rollover>
				<css name="imgOverCss">this</css>
			</rollover>
			
			<rollout>
				<css name="imgOutCss">this</css>
			</rollout>

			<click>
				<css name="imgOverCss">this</css>
				<function name="select">this</function>
				<function name="submit">this</function>
			</click>
		</event>
		
		<event id="selectandsubmit">
			<click>
				<css name="optionOverCss">this</css>
				<function name="select">this</function>
				<function name="submit">this</function>
			</click>
		</event>

		<event id="select">
			<click>
				<css name="optionOverCss">this</css>
				<function name="select">this</function>
			</click>
		</event>

		<event id="submit">
			<click>
				<function name="submit">this</function>
			</click>
		</event>

		<event id="reset">
			<click>
				<function name="reset">this</function>
			</click>
		</event>
		
        <event id="begin">
            <click>
                <anim type="remove" animtime="0" oncomplete="0">openingText</anim>
                <function name="begin">this</function>
            </click>
        </event>

        <event id="loadNextQuestion">
            <click>
                <function name="loadNextQuestion">this</function>
            </click>
        </event>
		
		<event id="restart">
            <click>
                <function name="restart">this</function>
            </click>
        </event>

        <event id="showq1bg">
            <click>
                <anim type="show" animtime="2" oncomplete="0">q1bg</anim>
            </click>
        </event>

         <event id="hidepassbg">
            <click>
            	<anim type="hide" animtime="2" oncomplete="0">passbg</anim>
            </click>
        </event>

        <event id="showpassbg">
            <click>
                <anim type="show" animtime="5" oncomplete="0">passbg</anim>
            </click>
        </event>

        <event id="hidefailbg">
            <click>
            	<anim type="hide" animtime="2" oncomplete="0">failbg</anim>
            </click>
        </event>

        <event id="showfailbg">
            <click>
                <anim type="show" animtime="2" oncomplete="0">failbg</anim>
            </click>
        </event>
    </events>    

    <!--timer-->
    <box id="timerContainer" position="relative" anim="none" class="timerContainer" margin-top="10"/>

    <!--opening text-->
    <box id="openingText" position="relative" margin-top="30" anim="top" animtime="1" ease="Bounce.easeOut">

    	<image id="img" position="relative" margin="auto" margin-bottom="30" anim="none" class=""><![CDATA[http://www.placehold.it/300x200]]></image>

    	<text id="title" position="relative" anim="none"><![CDATA[<h1>Multiple Choice Quiz</h1><p>Welcome to this short quiz.</p><p>Start when you're ready and good luck!</p>]]></text>

    	<button id="goBtn" position="relative" margin-top="30" margin="auto" width="100" anim="none" event="btnover,begin"><![CDATA[Let's go!]]></button>
    </box>

    <!--quiz-->
    <custom type="quiz" id="quiz" position="relative">
		<settings timer="false" timerx="0" timery="0"/>
        
		<!-- question 1 -->
        <question id="q1" time="15" event="">

    		<image id="img" position="relative" margin-top="30" margin-bottom="40" anim="show" animtime="1" animdelay="0" margin="auto"><![CDATA[http://www.placehold.it/300x200]]></image>

    		<text id="question" position="relative" x="0" margin-bottom="30" anim="show" animtime="1" animdelay="0.1" clear="both"><![CDATA[<p class="p_24">Will I need to be a JavaScript programmer to build a quiz?</p>]]></text>

			<!--option 1 -->
			<option correct="false">
				<text id="option1" position="relative" margin-bottom="10" anim="show" animtime="1" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_16 white">Yes</p>]]></text>
			</option>
			
			<!--option 2 -->	
			<option correct="true">
				<text id="option2" position="relative" margin-bottom="10" anim="show" animtime="1" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_16 white">No</p>]]></text>
			</option>
			
			<!-- feedbacks -->
			<fb id="pass" event="">	

				<image id="passimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Correct!</p><p>All the questions, text, images, events and buttons are defined in XML so you can create your own quiz without changing any JavaScript.</p><p>You can also customise the timer by changing some simple settings and css. Or choose not to have a timer at all.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[Try the next one]]></button>
			</fb>
			
			<fb id="fail" event="">	

				<image id="failimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Nope!</p><p>All the questions, text, images, events and buttons are defined in XML so you can create your own quiz without changing any JavaScript.</p><p>You can also customise the timer by changing some simple settings and css. Or choose not to have a timer at all.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[Try the next one]]></button>
			</fb>
		</question>

		<!-- question 2 -->
        <question id="q2" time="15" event="">

    		<image id="img" position="relative" margin-top="30" margin-bottom="30" anim="show" animtime="1" animdelay="0"><![CDATA[http://www.placehold.it/300x200]]></image>

    		<text id="question" position="relative" x="0" margin-bottom="40" anim="show" animtime="1" animdelay="0.1" clear="both"><![CDATA[<p class="p_24">The number of questions I can add is:</p>]]></text>

			<!--option 1 -->
			<option correct="false">
				<text id="option1_1" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.2" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_16 white">Limited to 5</p>]]></text>
			</option>
			
			<!--option 2 -->	
			<option correct="false">
				<text id="option1_2" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.3" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_16 white">Limited to 10</p>]]></text>
			</option>

			<!--option 3 -->	
			<option correct="true">
				<text id="option1_3" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.4" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_16 white">Unlimited</p>]]></text>
			</option>
			<!--/options -->
			
			<!-- feedbacks -->
			<fb id="pass" event="">	

				<image id="passimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Correct!</p><p>You can add as many questions as you like.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[Try the next one]]></button>

			</fb>
			
			<fb id="fail" event="">	
				
				<image id="failimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">No!</p><p>You can add as many questions as you like.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[Try the next one]]></button>
			</fb>
		</question>

		<!-- question 3 -->
        <question id="q3" time="15" event="">

    		<image id="img" position="relative" margin-top="30" margin-bottom="30" anim="show" animtime="1" animdelay="0"><![CDATA[http://www.placehold.it/300x200]]></image>

    		<text id="question" position="relative" x="0" margin-bottom="30" anim="show" animtime="1" animdelay="0.1" clear="both"><![CDATA[<p class="p_24">If there is more than one correct option, can the engine handle it?</p>]]></text>


			<!--option 1 -->
			<option correct="true">
				<text id="option1_1" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.2" event="optionover,select" class="optionBox"><![CDATA[<p class="p_16 white">Yes. For example, this option is flagged as correct.</p>]]></text>
			</option>
			
			<!--option 2 -->	
			<option correct="true">
				<text id="option1_2" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.3" event="optionover,select" class="optionBox"><![CDATA[<p class="p_16 white">And this option is <i>also</i> flagged as correct.</p>]]></text>
			</option>

			<!--option 3 -->	
			<option correct="false">
				<text id="option1_3" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.4" event="optionover,select" class="optionBox"><![CDATA[<p class="p_16 white">But this option is flagged as incorrect.</p>]]></text>
			</option>
			<!--/options -->

			<button id="submitBtn" position="relative" margin-top="30" display="inline-block" width="100" anim="disabled" event="btnover,submit"><![CDATA[<p class="genericBtn">Confirm</p>]]></button>
			<button id="resetBtn" position="relative" margin-top="30" display="inline-block" margin-left="10" width="100" anim="disabled" event="btnover,reset"><![CDATA[<p class="genericBtn">Reset</p>]]></button>
			
			<!-- feedbacks -->
			<fb id="pass" event="">	

				<image id="passimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Well done!</p><p>You selected all the correct answers. If you had selected <i>some</i> of the correct options, you would have generated "partially correct" feedback.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[How did I do?]]></button>
			</fb>

			<fb id="partial" event="">	
				
				<image id="partialimage" position="relative" margin-top="50" margin-bottom="30" anim="none" clear="both"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt11" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Not quite.</p><p>You selected some but not <i>all</i> of the correct options.</p><p>This is the "partial" feedback.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" margin-bottom="30" width="150" anim="none" event="btnover,loadNextQuestion"><![CDATA[Try the next one]]></button>
			</fb>
			
			<fb id="fail" event="">	
				
				<image id="failimage" position="relative" margin-top="50" margin-bottom="30" anim="none"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="txt1" position="relative" anim="none" margin-bottom="30"><![CDATA[<p class="p_24">Bad luck!</p><p>You didn't select any of the correct options.</p>]]></text>
		
				<button id="nextQBtn" position="relative" margin="auto" width="150" margin-bottom="30" anim="none" event="btnover,loadNextQuestion"><![CDATA[How did I do?]]></button>
			</fb>
		</question>
		
		
		<!--generic timeout text-->
		<timeout>
			<image id="timeoutimg" position="relative" margin-top="30" margin-bottom="30" anim="top" animtime="1" animdelay="0.3" ease="Bounce.easeOut"><![CDATA[http://www.placehold.it/300x200]]></image>

			<text id="timeoutTxt" position="relative" margin-bottom="30" anim="top" animtime="1" animdelay="0.2" ease="Bounce.easeOut"><![CDATA[<p class="p_42 grey">Times up!</p>]]></text>
	
			<button id="startAgainBtn" position="relative" margin="auto" margin-bottom="30" width="100" anim="top" animtime="1" animdelay="0.1" ease="Bounce.easeOut" event="btnover,restart"><![CDATA[Start again]]></button>
        </timeout>


        <!--score screen-->
        <score masteryscore="80">
           <fb id="pass" event="">
           		<image id="passimg" position="relative" margin-top="30" margin-bottom="30" anim="top" animtime="1" animdelay="0.3" ease="Bounce.easeOut"><![CDATA[http://www.placehold.it/300x200]]></image>

				<text id="pass_txt" position="relative" margin-bottom="30" anim="top" animtime="1" animdelay="0.2" ease="Bounce.easeOut">
					<![CDATA[<p class="p_32">CONGRATULATIONS!</p><p class="p_24">You scored [score]%</p><br/><p class="p_16_black">Enter your e-mail address:</p><input type="hidden" id="userScore" name="userScore" value="[score]" /><input type="email" id="userEmail" name="userEmail" value="Enter your e-mail address" style="color:#666; width:200px; height:40px; padding:0px 0px 0px 5px; background:#fff;" onFocus="clearInitialText();" onkeyup="evalUserEmail()"/>&nbsp;&nbsp;<input style="width:100px; height:40px; cursor:default; background:#ccc;" id="submitBtn" type="submit" value="Submit" onClick="myFormFunction()" disabled>]]></text>
				
				<button id="goBtn" position="relative" margin="auto" margin-bottom="30" width="140" anim="top" animtime="1" animdelay="0.1" ease="Bounce.easeOut" event="btnover,restart"><![CDATA[Start again?]]></button>
            </fb>
            
            <fb id="fail" event="">
            	<image id="failimg" position="relative" margin-top="30" margin-bottom="30" anim="top" animtime="1" animdelay="0.3" ease="Bounce.easeOut"><![CDATA[http://www.placehold.it/300x200]]></image>

                <text id="fail_txt" position="relative" margin-bottom="30" anim="top" animtime="1" animdelay="0.2" ease="Bounce.easeOut"><![CDATA[<p class="p_32">Bad luck! You scored [score]%</p><p class="p_24">Why not have another go?</p><br/><p class="p_16_black">Enter your e-mail address:</p><input type="hidden" id="userScore" name="userScore" value="[score]" /><input type="email" id="userEmail" name="userEmail" value="Enter your e-mail address" style="color:#666; width:200px; height:40px; padding:0px 0px 0px 5px; background:#fff;" onFocus="clearInitialText();" onkeyup="evalUserEmail()"/>&nbsp;&nbsp;<input style="width:100px; height:40px; cursor:default; background:#ccc;" id="submitBtn" type="submit" value="Submit" onClick="myFormFunction()" disabled>]]></text>
                    
				<button id="goBtn" position="relative" margin="auto" margin-bottom="30" width="200" anim="top" animtime="1" animdelay="0.1" ease="Bounce.easeOut" event="btnover,restart"><![CDATA[I can do better, let's go again!]]></button>
            </fb>
        </score>

    </custom>

</data>

