    		<text id="question" position="relative" x="0" margin-bottom="30" anim="show" animtime="1" animdelay="0.1" clear="both"><![CDATA[<p class="q_question"><strong>Question 1 of 7.</strong><br>How many <em>Fortune</em> 500 companies are headquartered in Minnesota?</p>]]></text>

			<!--option 1 -->
