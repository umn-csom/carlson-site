			</option>

			<!--option 4 -->
			<option correct="true">
				<text id="option1_4" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.5" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_option">California, Florida, and Hawaii combined</p>]]></text>
			</option>
			<!--/options -->

			<!-- feedbacks -->
			<fb id="pass" event="">

