		<!-- question 2 -->
        <question id="q2" time="15" event="">

    		<text id="question" position="relative" x="0" margin-bottom="40" anim="show" animtime="1" animdelay="0.1" clear="both"><![CDATA[<p class="q_question"><strong>Question 2 of 7.</strong><br>Minnesota has more shoreline than which of the following states?</p>]]></text>

			<!--option 1 -->
			<option correct="false">
				<text id="option1_1" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.2" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_option">California</p>]]></text>
			</option>

			<!--option 2 -->
			<option correct="false">
				<text id="option1_2" position="relative" margin-bottom="10" anim="show" animtime="1" animdelay="0.3" event="optionover,selectandsubmit" class="optionBox"><![CDATA[<p class="p_option">Florida</p>]]></text>
			</option>

